---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import ContactPanel from "../../components/ContactPanel.astro";
import InquiryComposer from "../../components/InquiryComposer.astro";
import NaverListingCard from "../../components/NaverListingCard.astro";
import { publishedComplexes } from "../../lib/complexes";
import { naverListings, naverListingsUpdatedAt, naverPropertyTypes } from "../../lib/naver-listings";
import { office } from "../../lib/site";

const title = "대전 동구 매매·전세·월세 매물 | 행복한부동산";
const description = "대전 동구에서 직접 확인한 매매·전세·월세 매물을 가격과 면적 등 원하는 조건으로 비교합니다.";
const getComplexSlug = (listingTitle: string) => publishedComplexes.find((complex) => listingTitle.startsWith(complex.name))?.slug ?? "";
---

<BaseLayout {title} {description} breadcrumbItems={[{ name: "홈", path: "/" }, { name: "매물", path: "/properties/" }]}>
  <PageIntro eyebrow="PROPERTY" title="네이버 등록 매물" description="네이버페이 부동산에 공개된 개별 매물을 조건별로 좁히고 관심 매물과 비교 목록으로 정리할 수 있습니다." />
  <section class="section properties-section">
    <div class="shell">
      <aside class="external-listing-callout" aria-label="네이버 부동산 등록 매물 안내">
        <div>
          <p class="eyebrow">NAVER 부동산</p>
          <h2>네이버에 공개된 개별 매물 {naverListings.length}건</h2>
          <p class="listing-update"><span>매물 목록 업데이트</span><time datetime={naverListingsUpdatedAt}>{naverListingsUpdatedAt.replaceAll("-", ".")}</time></p>
          <p>카드의 제목이나 상세 링크를 누르면 해당 네이버 매물로 이동합니다.</p>
        </div>
        <a class="button button--light" href={office.naverListingsUrl} target="_blank" rel="noopener noreferrer">네이버 매물 보기</a>
      </aside>

      <div class="listing-explorer">
        <button class="filter-toggle" type="button" aria-expanded="false" aria-controls="listing-filter-fields" data-filter-toggle hidden>
          <span data-filter-toggle-label>조건 0개 · 매물 {naverListings.length}건</span><span aria-hidden="true">⌄</span>
        </button>
        <form class="filter-panel" data-listing-filter>
          <div class="filter-panel__fields" id="listing-filter-fields" data-filter-fields>
            <div>
              <label for="trade">거래유형</label>
              <select id="trade" name="trade">
                <option value="">전체</option><option value="sale">매매</option><option value="jeonse">전세</option><option value="monthly-rent">월세</option>
              </select>
            </div>
            <div>
              <label for="propertyType">매물유형</label>
              <select id="propertyType" name="propertyType">
                <option value="">전체</option>
                {naverPropertyTypes.map((propertyType) => <option value={propertyType}>{propertyType}</option>)}
              </select>
            </div>
            <div>
              <label for="complex">단지</label>
              <select id="complex" name="complex">
                <option value="">전체</option>
                {publishedComplexes.map((complex) => <option value={complex.slug}>{complex.name}</option>)}
              </select>
            </div>
            <div>
              <label for="sort">정렬기준</label>
              <select id="sort" name="sort">
                <option value="latest">최근 등록순</option>
                <option value="price">가격 낮은순</option>
                <option value="price-desc">가격 높은순</option>
                <option value="area">면적 작은순</option>
                <option value="area-desc">면적 큰순</option>
              </select>
            </div>
            <fieldset class="filter-range" data-standard-price-fields hidden>
              <legend>가격 범위 <small>(만원)</small></legend>
              <label><span>최소 가격</span><input type="number" name="minPrice" min="0" max="10000000" step="100" inputmode="numeric" placeholder="예: 30000" /></label>
              <label><span>최대 가격</span><input type="number" name="maxPrice" min="0" max="10000000" step="100" inputmode="numeric" placeholder="예: 60000" /></label>
            </fieldset>
            <fieldset class="filter-range filter-range--monthly" data-monthly-price-fields hidden>
              <legend>월세 조건 <small>(만원)</small></legend>
              <label><span>최소 보증금</span><input type="number" name="minDeposit" min="0" max="10000000" step="100" inputmode="numeric" /></label>
              <label><span>최대 보증금</span><input type="number" name="maxDeposit" min="0" max="10000000" step="100" inputmode="numeric" /></label>
              <label><span>최소 월세</span><input type="number" name="minRent" min="0" max="10000000" step="5" inputmode="numeric" /></label>
              <label><span>최대 월세</span><input type="number" name="maxRent" min="0" max="10000000" step="5" inputmode="numeric" /></label>
            </fieldset>
            <fieldset class="filter-range">
              <legend>면적 범위 <small>(㎡)</small></legend>
              <label><span>최소 면적</span><input type="number" name="minArea" min="0" max="10000" step="1" inputmode="decimal" placeholder="예: 59" /></label>
              <label><span>최대 면적</span><input type="number" name="maxArea" min="0" max="10000" step="1" inputmode="decimal" placeholder="예: 85" /></label>
            </fieldset>
            <div class="filter-panel__actions">
              <button class="button button--primary" type="submit">조건 적용</button>
              <button class="button button--secondary" type="reset">필터 초기화</button>
            </div>
          </div>
          <p class="filter-panel__hint" data-price-hint>가격 범위를 사용하려면 거래유형을 먼저 선택해 주세요.</p>
          <p class="filter-panel__error" role="status" aria-live="polite" data-filter-error></p>
        </form>

        <div class="quick-filter" aria-label="빠른 조건">
          <span>빠른 조건</span>
          <button type="button" data-quick-filter="sale">매매</button>
          <button type="button" data-quick-filter="jeonse">전세</button>
          <button type="button" data-quick-filter="monthly-rent">월세</button>
          <button type="button" data-quick-filter="area-59">59㎡ 이상</button>
          <button type="button" data-quick-filter="area-84">84㎡ 이상</button>
        </div>

        <div class="active-filter-summary" data-active-filter-summary hidden>
          <strong>선택 조건</strong><div data-active-filter-list></div>
        </div>

        <div class="listing-view-toolbar">
          <div class="listing-view-toggle" aria-label="매물 보기 범위">
            <button type="button" aria-pressed="true" data-favorite-view="all">전체</button>
            <button type="button" aria-pressed="false" data-favorite-view="favorites">관심 매물 <span data-favorite-count>0</span></button>
          </div>
          <button class="text-button" type="button" data-clear-favorites disabled>관심 매물 모두 삭제</button>
        </div>
        <p class="listing-preference-note">관심 매물은 이 브라우저에만 저장되며 사무소 서버로 전송되지 않습니다.</p>
        <p class="sr-only" role="status" aria-live="polite" data-preference-status></p>

        <p class="result-count" aria-live="polite" data-result-count>네이버 등록 매물 {naverListings.length}건</p>

        <aside class="compare-tray" data-compare-tray hidden aria-label="선택 매물 비교">
          <div><strong data-compare-count>비교 매물 0/3</strong><p data-compare-status>최대 3개까지 선택할 수 있습니다.</p></div>
          <div class="compare-tray__actions">
            <button type="button" data-clear-compare>전체 해제</button>
            <a class="button button--light" href="/properties/compare/" data-compare-link>선택 매물 비교</a>
            <a class="button button--secondary" href="#inquiry-composer">문의 조건 작성</a>
          </div>
        </aside>

        <div class="listing-grid" data-listing-grid>
          {naverListings.map((listing, index) => (
            <NaverListingCard {listing} rank={index} complexSlug={getComplexSlug(listing.title)} selectionControls />
          ))}
        </div>
        <div class="empty-state" data-empty-state hidden>
          <span class="empty-state__number" aria-hidden="true">0</span>
          <div><h3>조건에 맞는 공개 매물이 없습니다</h3><p>조건을 초기화하거나 찾는 지역·거래유형·예산을 문의 문장으로 정리해 주세요.</p></div>
          <div class="empty-state__actions"><button class="button button--secondary" type="button" data-empty-reset>조건 초기화</button><a class="button button--primary" href="#inquiry-composer">문의 조건 작성</a></div>
        </div>
      </div>

      <InquiryComposer />
    </div>
  </section>
  <ContactPanel title="원하는 조건을 먼저 알려주세요" description="공개 목록에 없는 매물도 현재 확인 가능한 범위에서 안내해 드립니다." />
</BaseLayout>

<script>
  import { compareNaverListingSortData } from "../../lib/naver-listing-sort.mjs";
  import {
    buildListingExplorerSearchParams,
    matchesListingExplorerState,
    normalizeListingExplorerQuery,
  } from "../../lib/naver-listing-filter.mjs";
  import {
    createListingPreferencesStore,
    LISTING_PREFERENCES_STORAGE_KEY,
    MAX_FAVORITE_LISTINGS,
  } from "../../lib/listing-preferences.mjs";
  import { buildCompareHref, toggleCompareId } from "../../lib/listing-compare.mjs";

  const form = document.querySelector<HTMLFormElement>("[data-listing-filter]");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-naver-listing-card]")];
  const count = document.querySelector<HTMLElement>("[data-result-count]");
  const empty = document.querySelector<HTMLElement>("[data-empty-state]");
  const grid = document.querySelector<HTMLElement>("[data-listing-grid]");

  if (form && count && empty && grid) {
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement;
    const trade = field("trade") as HTMLSelectElement;
    const propertyType = field("propertyType") as HTMLSelectElement;
    const complex = field("complex") as HTMLSelectElement;
    const sort = field("sort") as HTMLSelectElement;
    const allowedPropertyTypes = [...propertyType.options].map((option) => option.value).filter(Boolean);
    const allowedComplexes = [...complex.options].map((option) => option.value).filter(Boolean);
    const validIds = new Set(cards.map((card) => card.dataset.listingId ?? "").filter(Boolean));
    const standardPriceFields = form.querySelector<HTMLFieldSetElement>("[data-standard-price-fields]");
    const monthlyPriceFields = form.querySelector<HTMLFieldSetElement>("[data-monthly-price-fields]");
    const priceHint = form.querySelector<HTMLElement>("[data-price-hint]");
    const error = form.querySelector<HTMLElement>("[data-filter-error]");
    const filterToggle = document.querySelector<HTMLButtonElement>("[data-filter-toggle]");
    const filterToggleLabel = document.querySelector<HTMLElement>("[data-filter-toggle-label]");
    const filterFields = form.querySelector<HTMLElement>("[data-filter-fields]");
    const activeSummary = document.querySelector<HTMLElement>("[data-active-filter-summary]");
    const activeList = document.querySelector<HTMLElement>("[data-active-filter-list]");
    const favoriteCount = document.querySelector<HTMLElement>("[data-favorite-count]");
    const clearFavorites = document.querySelector<HTMLButtonElement>("[data-clear-favorites]");
    const preferenceStatus = document.querySelector<HTMLElement>("[data-preference-status]");
    const favoriteViewButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-favorite-view]")];
    const compareTray = document.querySelector<HTMLElement>("[data-compare-tray]");
    const compareCount = document.querySelector<HTMLElement>("[data-compare-count]");
    const compareStatus = document.querySelector<HTMLElement>("[data-compare-status]");
    const compareLink = document.querySelector<HTMLAnchorElement>("[data-compare-link]");
    const mobileFilter = window.matchMedia("(max-width: 767px)");
    let favoritesOnly = false;
    let compareIds: string[] = [];

    let browserStorage: Storage | null = null;
    try {
      browserStorage = window.localStorage;
    } catch {
      browserStorage = null;
    }
    const preferences = createListingPreferencesStore({ storage: browserStorage, validIds });

    const setInputValue = (name: string, value: string | number | null) => {
      field(name).value = value === null ? "" : String(value);
    };

    const syncPriceFieldVisibility = (clearHidden = false) => {
      const isMonthly = trade.value === "monthly-rent";
      const hasStandardPrice = trade.value === "sale" || trade.value === "jeonse";
      if (standardPriceFields) {
        standardPriceFields.hidden = !hasStandardPrice;
        standardPriceFields.disabled = !hasStandardPrice;
      }
      if (monthlyPriceFields) {
        monthlyPriceFields.hidden = !isMonthly;
        monthlyPriceFields.disabled = !isMonthly;
      }
      if (priceHint) priceHint.hidden = Boolean(trade.value);
      if (clearHidden) {
        if (!hasStandardPrice) ["minPrice", "maxPrice"].forEach((name) => setInputValue(name, null));
        if (!isMonthly) ["minDeposit", "maxDeposit", "minRent", "maxRent"].forEach((name) => setInputValue(name, null));
      }
    };

    const stateFromForm = () => {
      const params = new URLSearchParams();
      const values = {
        trade: trade.value,
        type: propertyType.value,
        complex: complex.value,
        sort: sort.value,
        minPrice: field("minPrice").value,
        maxPrice: field("maxPrice").value,
        minArea: field("minArea").value,
        maxArea: field("maxArea").value,
        minDeposit: field("minDeposit").value,
        maxDeposit: field("maxDeposit").value,
        minRent: field("minRent").value,
        maxRent: field("maxRent").value,
      };
      Object.entries(values).forEach(([key, value]) => { if (value) params.set(key, value); });
      return normalizeListingExplorerQuery(params, { propertyTypes: allowedPropertyTypes, complexes: allowedComplexes });
    };

    const writeStateToForm = (state: Record<string, string | number | null>) => {
      setInputValue("trade", state.trade);
      setInputValue("propertyType", state.propertyType);
      setInputValue("complex", state.complex);
      setInputValue("sort", state.sort);
      setInputValue("minPrice", state.minPrice);
      setInputValue("maxPrice", state.maxPrice);
      setInputValue("minArea", state.minArea);
      setInputValue("maxArea", state.maxArea);
      setInputValue("minDeposit", state.minDeposit);
      setInputValue("maxDeposit", state.maxDeposit);
      setInputValue("minRent", state.minMonthlyRent);
      setInputValue("maxRent", state.maxMonthlyRent);
      syncPriceFieldVisibility();
    };

    const renderActiveFilters = (state: Record<string, string | number | null>) => {
      if (!activeSummary || !activeList) return 0;
      const labels: string[] = [];
      if (state.trade) labels.push(trade.selectedOptions[0]?.textContent?.trim() ?? String(state.trade));
      if (state.propertyType) labels.push(String(state.propertyType));
      if (state.complex) labels.push(complex.selectedOptions[0]?.textContent?.trim() ?? String(state.complex));
      if (state.minPrice !== null || state.maxPrice !== null) labels.push(`가격 ${state.minPrice ?? 0}~${state.maxPrice ?? "제한 없음"}만원`);
      if (state.minDeposit !== null || state.maxDeposit !== null) labels.push(`보증금 ${state.minDeposit ?? 0}~${state.maxDeposit ?? "제한 없음"}만원`);
      if (state.minMonthlyRent !== null || state.maxMonthlyRent !== null) labels.push(`월세 ${state.minMonthlyRent ?? 0}~${state.maxMonthlyRent ?? "제한 없음"}만원`);
      if (state.minArea !== null || state.maxArea !== null) labels.push(`면적 ${state.minArea ?? 0}~${state.maxArea ?? "제한 없음"}㎡`);
      if (state.sort !== "latest") labels.push(sort.selectedOptions[0]?.textContent?.trim() ?? String(state.sort));
      activeList.replaceChildren(...labels.map((label) => {
        const chip = document.createElement("span");
        chip.textContent = label;
        return chip;
      }));
      activeSummary.hidden = labels.length === 0;
      return labels.length;
    };

    const updateFavoriteUi = () => {
      const state = preferences.getState();
      cards.forEach((card) => {
        const button = card.querySelector<HTMLButtonElement>("[data-favorite-button]");
        const selected = preferences.has(card.dataset.listingId ?? "");
        button?.setAttribute("aria-pressed", String(selected));
        if (button) button.textContent = selected ? "★ 관심 해제" : "☆ 관심";
      });
      if (favoriteCount) favoriteCount.textContent = String(state.favoriteIds.length);
      if (clearFavorites) clearFavorites.disabled = state.favoriteIds.length === 0;
      if (!state.persistent && preferenceStatus) preferenceStatus.textContent = "브라우저 저장이 차단되어 관심 매물은 현재 탭에서만 유지됩니다.";
    };

    const updateCompareUi = (message = "") => {
      cards.forEach((card) => {
        const selected = compareIds.includes(card.dataset.listingId ?? "");
        card.dataset.compareSelected = String(selected);
        const button = card.querySelector<HTMLButtonElement>("[data-compare-button]");
        button?.setAttribute("aria-pressed", String(selected));
        if (button) button.textContent = selected ? "비교 해제" : "비교";
      });
      if (compareTray) compareTray.hidden = compareIds.length === 0;
      if (compareCount) compareCount.textContent = `비교 매물 ${compareIds.length}/3`;
      if (compareStatus) compareStatus.textContent = message || "선택 순서대로 최대 3개까지 비교합니다.";
      if (compareLink) compareLink.href = buildCompareHref(compareIds, validIds);
      document.dispatchEvent(new CustomEvent("listing-selection-change"));
    };

    const apply = ({ updateUrl = true, announceError = true } = {}) => {
      const { state, invalidRanges } = stateFromForm();
      if (invalidRanges.length > 0) writeStateToForm(state);
      const sortedCards = [...cards].sort((first, second) => compareNaverListingSortData(first.dataset, second.dataset, String(state.sort)));
      grid.append(...sortedCards);
      let visible = 0;
      sortedCards.forEach((card) => {
        const matches = matchesListingExplorerState(card.dataset, state);
        const favoriteMatch = !favoritesOnly || preferences.has(card.dataset.listingId ?? "");
        card.hidden = !(matches && favoriteMatch);
        if (!card.hidden) visible += 1;
      });
      count.textContent = `${favoritesOnly ? "관심 매물" : "네이버 등록 매물"} ${visible}건`;
      empty.hidden = visible > 0;
      const activeCount = renderActiveFilters(state);
      if (filterToggleLabel) filterToggleLabel.textContent = `조건 ${activeCount}개 · 매물 ${visible}건`;
      if (error && announceError) {
        error.textContent = invalidRanges.length > 0 ? "최소값이 최대값보다 커서 해당 범위를 해제했습니다." : "";
      }
      if (updateUrl) {
        const next = buildListingExplorerSearchParams(state);
        history.replaceState(null, "", `${location.pathname}${next.size ? `?${next}` : ""}`);
      }
      return state;
    };

    const initial = normalizeListingExplorerQuery(window.location.search, { propertyTypes: allowedPropertyTypes, complexes: allowedComplexes });
    writeStateToForm(initial.state);
    if (error && initial.invalidRanges.length > 0) error.textContent = "주소의 잘못된 범위 조건을 해제했습니다.";

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      apply();
      if (mobileFilter.matches && filterToggle && filterFields) {
        filterFields.hidden = true;
        filterToggle.setAttribute("aria-expanded", "false");
        filterToggle.focus();
      }
    });
    form.addEventListener("change", (event) => {
      if (event.target === trade) syncPriceFieldVisibility(true);
      apply();
    });
    form.addEventListener("reset", () => window.setTimeout(() => {
      favoritesOnly = false;
      favoriteViewButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.favoriteView === "all")));
      syncPriceFieldVisibility(true);
      apply();
    }));

    document.querySelectorAll<HTMLButtonElement>("[data-quick-filter]").forEach((button) => {
      button.addEventListener("click", () => {
        const quick = button.dataset.quickFilter ?? "";
        if (["sale", "jeonse", "monthly-rent"].includes(quick)) trade.value = quick;
        if (quick === "area-59" || quick === "area-84") setInputValue("minArea", quick === "area-59" ? 59 : 84);
        syncPriceFieldVisibility(true);
        apply();
      });
    });

    favoriteViewButtons.forEach((button) => button.addEventListener("click", () => {
      favoritesOnly = button.dataset.favoriteView === "favorites";
      favoriteViewButtons.forEach((viewButton) => viewButton.setAttribute("aria-pressed", String(viewButton === button)));
      apply();
    }));
    clearFavorites?.addEventListener("click", () => {
      preferences.clear();
      favoritesOnly = false;
      favoriteViewButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.favoriteView === "all")));
      if (preferenceStatus) preferenceStatus.textContent = "관심 매물을 모두 삭제했습니다.";
      updateFavoriteUi();
      apply();
    });

    cards.forEach((card) => {
      const id = card.dataset.listingId ?? "";
      card.querySelector<HTMLButtonElement>("[data-favorite-button]")?.addEventListener("click", () => {
        const result = preferences.toggle(id);
        if (preferenceStatus) {
          preferenceStatus.textContent = result.reason === "limit"
            ? `관심 매물은 최대 ${MAX_FAVORITE_LISTINGS}개까지 저장할 수 있습니다.`
            : result.ok ? (preferences.has(id) ? "관심 매물에 저장했습니다." : "관심 매물에서 삭제했습니다.") : "이 매물은 저장할 수 없습니다.";
        }
        updateFavoriteUi();
        apply();
      });
      card.querySelector<HTMLButtonElement>("[data-compare-button]")?.addEventListener("click", () => {
        const result = toggleCompareId(compareIds, id, validIds);
        compareIds = result.ids;
        updateCompareUi(result.reason === "limit" ? "최대 3개까지 비교할 수 있습니다." : "");
      });
    });

    document.querySelector<HTMLButtonElement>("[data-clear-compare]")?.addEventListener("click", () => {
      compareIds = [];
      updateCompareUi("비교 선택을 모두 해제했습니다.");
    });
    document.querySelector<HTMLButtonElement>("[data-empty-reset]")?.addEventListener("click", () => {
      form.reset();
      window.setTimeout(() => field("trade").focus());
    });

    window.addEventListener("storage", (event) => {
      if (event.key !== LISTING_PREFERENCES_STORAGE_KEY) return;
      preferences.sync(event.newValue);
      updateFavoriteUi();
      apply();
    });

    const syncMobileFilter = () => {
      if (!filterToggle || !filterFields) return;
      filterToggle.hidden = !mobileFilter.matches;
      if (mobileFilter.matches) {
        filterFields.hidden = filterToggle.getAttribute("aria-expanded") !== "true";
      } else {
        filterFields.hidden = false;
        filterToggle.setAttribute("aria-expanded", "true");
      }
    };
    filterToggle?.addEventListener("click", () => {
      if (!filterFields) return;
      const expanded = filterToggle.getAttribute("aria-expanded") === "true";
      filterToggle.setAttribute("aria-expanded", String(!expanded));
      filterFields.hidden = expanded;
    });
    mobileFilter.addEventListener("change", syncMobileFilter);

    updateFavoriteUi();
    updateCompareUi();
    apply();
    syncMobileFilter();
  }
</script>

