---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import ContactPanel from "../../components/ContactPanel.astro";
import NaverListingCard from "../../components/NaverListingCard.astro";
import { publishedComplexes } from "../../lib/complexes";
import { naverListings, naverListingsUpdatedAt, naverPropertyTypes } from "../../lib/naver-listings";
import { office } from "../../lib/site";

const title = "대전 동구 매매·전세·월세 매물 | 행복한부동산";
const description = "대전 동구에서 직접 확인한 매매·전세·월세 매물을 지역과 조건별로 비교합니다.";
---

<BaseLayout {title} {description}>
  <PageIntro eyebrow="PROPERTY" title="네이버 등록 매물" description="네이버페이 부동산에 공개된 개별 매물을 우리 사이트에서도 한눈에 확인할 수 있습니다." />
  <section class="section properties-section">
    <div class="shell">
      <aside class="external-listing-callout" aria-label="네이버 부동산 등록 매물 안내">
        <div>
          <p class="eyebrow">NAVER 부동산</p>
          <h2>네이버에 공개된 개별 매물 {naverListings.length}건</h2>
          <p class="listing-update"><span>매물 목록 업데이트</span><time datetime={naverListingsUpdatedAt}>{naverListingsUpdatedAt.replaceAll("-", ".")}</time></p>
          <p>아래 카드를 누르면 해당 네이버 매물로 바로 이동합니다.</p>
        </div>
        <a class="button button--light" href={office.naverListingsUrl} target="_blank" rel="noopener noreferrer">네이버 매물 보기</a>
      </aside>
      <form class="filter-panel" data-listing-filter>
        <div>
          <label for="trade">거래유형</label>
          <select id="trade" name="trade">
            <option value="">전체</option><option value="sale">매매</option><option value="jeonse">전세</option><option value="monthly-rent">월세</option>
          </select>
        </div>
        <div>
          <label for="propertyType">매물유형</label>
          <select id="propertyType" name="propertyType">
            <option value="">전체</option>
            {naverPropertyTypes.map((propertyType) => <option value={propertyType}>{propertyType}</option>)}
          </select>
        </div>
        <div>
          <label for="complex">단지</label>
          <select id="complex" name="complex">
            <option value="">전체</option>
            {publishedComplexes.map((complex) => <option value={complex.slug} data-complex-name={complex.name}>{complex.name}</option>)}
          </select>
        </div>
        <div>
          <label for="sort">정렬기준</label>
          <select id="sort" name="sort">
            <option value="latest">최근 등록순</option>
            <option value="price">가격 낮은순</option>
            <option value="price-desc">가격 높은순</option>
            <option value="area">면적 작은순</option>
            <option value="area-desc">면적 큰순</option>
          </select>
        </div>
        <button class="button button--secondary" type="reset">필터 초기화</button>
      </form>
      <p class="result-count" aria-live="polite" data-result-count>네이버 등록 매물 {naverListings.length}건</p>
      <div class="listing-grid" data-listing-grid>
        {naverListings.map((listing, index) => <NaverListingCard {listing} rank={index} />)}
      </div>
      <div class="empty-state" data-empty-state hidden>
        <span class="empty-state__number" aria-hidden="true">0</span>
        <div><h2>조건에 맞는 매물이 없습니다</h2><p>필터를 초기화하거나 원하시는 조건을 전화·문자·카카오톡으로 문의해 주세요.</p></div>
      </div>
    </div>
  </section>
  <ContactPanel title="원하는 조건을 먼저 알려주세요" description="공개 목록에 없는 매물도 현재 확인 가능한 범위에서 안내해 드립니다." />
</BaseLayout>

<script>
  import { compareNaverListingSortData, isNaverListingSortKey } from "../../lib/naver-listing-sort.mjs";

  const form = document.querySelector<HTMLFormElement>("[data-listing-filter]");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-naver-listing-card]")];
  const count = document.querySelector<HTMLElement>("[data-result-count]");
  const empty = document.querySelector<HTMLElement>("[data-empty-state]");
  const grid = document.querySelector<HTMLElement>("[data-listing-grid]");

  if (form && count && empty && grid) {
    const trade = form.elements.namedItem("trade") as HTMLSelectElement;
    const propertyType = form.elements.namedItem("propertyType") as HTMLSelectElement;
    const complex = form.elements.namedItem("complex") as HTMLSelectElement;
    const sort = form.elements.namedItem("sort") as HTMLSelectElement;
    const params = new URLSearchParams(window.location.search);
    if (["sale", "jeonse", "monthly-rent"].includes(params.get("trade") ?? "")) trade.value = params.get("trade")!;
    const allowedPropertyTypes = [...propertyType.options].map((option) => option.value).filter(Boolean);
    if (allowedPropertyTypes.includes(params.get("type") ?? "")) propertyType.value = params.get("type")!;
    const allowedComplexes = [...complex.options].map((option) => option.value).filter(Boolean);
    if (allowedComplexes.includes(params.get("complex") ?? "")) complex.value = params.get("complex")!;
    if (isNaverListingSortKey(params.get("sort") ?? "")) sort.value = params.get("sort")!;

    const apply = () => {
      const sortedCards = [...cards].sort((a, b) => compareNaverListingSortData(a.dataset, b.dataset, sort.value));
      grid.append(...sortedCards);
      let visible = 0;
      const complexName = complex.selectedOptions[0]?.dataset.complexName;
      sortedCards.forEach((card) => {
        const show = (!trade.value || card.dataset.trade === trade.value)
          && (!propertyType.value || card.dataset.propertyType === propertyType.value)
          && (!complex.value || Boolean(complexName && card.dataset.listingTitle?.startsWith(complexName)));
        card.hidden = !show;
        if (show) visible += 1;
      });
      count.textContent = `네이버 등록 매물 ${visible}건`;
      empty.hidden = visible > 0;
      const next = new URLSearchParams();
      if (trade.value) next.set("trade", trade.value);
      if (propertyType.value) next.set("type", propertyType.value);
      if (complex.value) next.set("complex", complex.value);
      if (sort.value !== "latest") next.set("sort", sort.value);
      history.replaceState(null, "", `${location.pathname}${next.size ? `?${next}` : ""}`);
    };

    form.addEventListener("change", apply);
    form.addEventListener("reset", () => window.setTimeout(apply));
    apply();
  }
</script>

<style>
  .listing-update {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0.7rem 0 0.45rem;
    color: var(--white);
  }

  .listing-update span {
    border-radius: 999px;
    background: var(--rose-soft);
    color: var(--rose-dark);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    padding: 0.3rem 0.65rem;
  }

  .listing-update time {
    font-weight: 800;
  }
</style>
