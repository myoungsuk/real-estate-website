---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import ContactPanel from "../../components/ContactPanel.astro";
import { complexNames, formatListingPrice, publishedListings, squareMetersToPyeong, tradeNames } from "../../lib/listings";

const title = "리더스시티 매매·전세·월세 매물 | 행복한부동산";
const description = "천동 리더스시티 4블록과 5블록의 직접 확인한 매매·전세·월세 매물을 비교합니다.";
---

<BaseLayout {title} {description}>
  <PageIntro eyebrow="PROPERTY" title="확인 매물" description="가격과 면적, 최근 확인일이 있는 공개 승인 매물만 보여드립니다." />
  <section class="section properties-section">
    <div class="shell">
      <form class="filter-panel" data-listing-filter>
        <div>
          <label for="trade">거래유형</label>
          <select id="trade" name="trade">
            <option value="">전체</option><option value="sale">매매</option><option value="jeonse">전세</option><option value="monthly-rent">월세</option>
          </select>
        </div>
        <div>
          <label for="complex">블록</label>
          <select id="complex" name="complex">
            <option value="">전체</option><option value="leaders-city-4">4블록</option><option value="leaders-city-5">5블록</option>
          </select>
        </div>
        <button class="button button--secondary" type="reset">필터 초기화</button>
      </form>
      <p class="result-count" aria-live="polite" data-result-count>공개 매물 {publishedListings.length}건</p>
      <div class="listing-grid" data-listing-grid>
        {publishedListings.map((listing) => (
          <article class="listing-card" data-listing-card data-trade={listing.tradeType} data-complex={listing.complex}>
            <div class="listing-card__visual"><span>{listing.complex === "leaders-city-4" ? "4" : "5"}</span></div>
            <div class="listing-card__body">
              <p><span>{tradeNames[listing.tradeType]}</span>{complexNames[listing.complex]}</p>
              <h2>{formatListingPrice(listing)}</h2>
              <dl><div><dt>전용면적</dt><dd>{listing.exclusiveAreaM2}㎡ · {squareMetersToPyeong(listing.exclusiveAreaM2)}평</dd></div><div><dt>확인일</dt><dd>{listing.confirmedAt}</dd></div></dl>
              <a class="button button--secondary" href={`/properties/${listing.slug}/`}>상세 보기</a>
            </div>
          </article>
        ))}
      </div>
      <div class="empty-state" data-empty-state hidden={publishedListings.length > 0}>
        <span class="empty-state__number" aria-hidden="true">0</span>
        <div><h2>현재 공개 준비 중입니다</h2><p>실제 확인과 공개 승인을 마친 매물만 올립니다. 원하시는 조건은 전화나 문자로 문의해 주세요.</p></div>
      </div>
    </div>
  </section>
  <ContactPanel title="원하는 조건을 먼저 알려주세요" description="공개 목록에 없는 매물도 현재 확인 가능한 범위에서 안내해 드립니다." />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-listing-filter]");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-listing-card]")];
  const count = document.querySelector<HTMLElement>("[data-result-count]");
  const empty = document.querySelector<HTMLElement>("[data-empty-state]");

  if (form && count && empty) {
    const trade = form.elements.namedItem("trade") as HTMLSelectElement;
    const complex = form.elements.namedItem("complex") as HTMLSelectElement;
    const params = new URLSearchParams(window.location.search);
    if (["sale", "jeonse", "monthly-rent"].includes(params.get("trade") ?? "")) trade.value = params.get("trade")!;
    if (["leaders-city-4", "leaders-city-5"].includes(params.get("complex") ?? "")) complex.value = params.get("complex")!;

    const apply = () => {
      let visible = 0;
      cards.forEach((card) => {
        const show = (!trade.value || card.dataset.trade === trade.value) && (!complex.value || card.dataset.complex === complex.value);
        card.hidden = !show;
        if (show) visible += 1;
      });
      count.textContent = `공개 매물 ${visible}건`;
      empty.hidden = visible > 0;
      const next = new URLSearchParams();
      if (trade.value) next.set("trade", trade.value);
      if (complex.value) next.set("complex", complex.value);
      history.replaceState(null, "", `${location.pathname}${next.size ? `?${next}` : ""}`);
    };

    form.addEventListener("change", apply);
    form.addEventListener("reset", () => window.setTimeout(apply));
    apply();
  }
</script>
