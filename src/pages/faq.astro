---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import faq from "../data/faq.json";
import { kakaoHref, office, phoneHref, smsHref } from "../lib/site";

type FaqItem = {
  category: string;
  question: string;
  answer: string;
};

const faqCategories = [
  { code: "A", id: "listing-consultation", title: "매물 확인과 상담", shortTitle: "매물·상담" },
  { code: "B", id: "leaders-city", title: "리더스시티 4블록·5블록", shortTitle: "리더스시티" },
  { code: "C", id: "price-market", title: "가격과 시세", shortTitle: "가격·시세" },
  { code: "D", id: "sale-contract", title: "매매계약과 권리관계", shortTitle: "매매계약" },
  { code: "E", id: "rent-deposit", title: "전세·월세와 보증금 보호", shortTitle: "전세·월세" },
  { code: "F", id: "cost-finance", title: "중개보수·대출·세금과 관리비", shortTitle: "비용·금융" },
  { code: "G", id: "defect-move-in", title: "하자·잔금과 입주", shortTitle: "하자·입주" },
  { code: "H", id: "information-scope", title: "정보의 범위와 책임", shortTitle: "안내 범위" },
];
const indexedFaq = (faq as FaqItem[]).map((item, index) => ({ ...item, number: index + 1 }));
const categorizedFaq = faqCategories.map((category) => ({
  ...category,
  items: indexedFaq.filter((item) => item.category === category.title),
}));

const title = "FAQ 및 상담 | 리더스시티행복한공인중개사사무소";
const description = "매매·전세·월세의 자주 묻는 질문을 확인하고 문자로 비공개 상담을 요청할 수 있습니다.";
const structuredData = faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
} : undefined;
---

<BaseLayout {title} {description} {structuredData} breadcrumbItems={[{ name: "홈", path: "/" }, { name: "FAQ 및 상담", path: "/faq/" }]}>
  <PageIntro eyebrow="FAQ & CONSULTATION" title="FAQ 및 상담" description="자주 묻는 질문을 먼저 확인하고, 더 궁금한 내용은 사이트에 남기지 않고 문자로 바로 상담해 주세요." />
  <section class="section" aria-labelledby="faq-heading">
    <div class="shell narrow-shell">
      <div class="section-heading faq-heading">
        <div><p class="eyebrow">자주 묻는 질문</p><h2 id="faq-heading">상담 전 확인해 보세요</h2></div>
        {faq.length > 0 && <p><strong>{faq.length}개</strong>의 자주 묻는 질문을 먼저 정리했습니다.</p>}
      </div>
      {faq.length > 0 ? (
        <>
          <aside class="faq-guide" aria-label="FAQ 이용 안내">
            <span class="faq-guide__mark" aria-hidden="true">i</span>
            <div>
              <strong>일반적인 기준을 안내드립니다</strong>
              <p>매물 조건과 권리관계는 세대와 확인 시점마다 다릅니다. 법률·세무·대출·보증의 최종 판단은 실제 계약일의 공식 자료와 해당 기관을 통해 다시 확인해 주세요.</p>
            </div>
          </aside>
          <nav class="faq-category-nav" id="faq-categories" aria-labelledby="faq-category-heading">
            <div class="faq-category-nav__heading">
              <p class="eyebrow">카테고리</p>
              <h3 id="faq-category-heading">궁금한 분야를 골라보세요</h3>
            </div>
            <ul class="faq-category-grid">
              {categorizedFaq.map((category) => (
                <li>
                  <a href={`#faq-${category.id}`}>
                    <span class="faq-category-link__code" aria-hidden="true">{category.code}</span>
                    <span>
                      <strong>{category.shortTitle}</strong>
                      <small>{category.items.length}개 질문</small>
                    </span>
                    <span class="faq-category-link__arrow" aria-hidden="true">↓</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="faq-category-groups">
            {categorizedFaq.map((category) => (
              <section class="faq-category-section" id={`faq-${category.id}`} aria-labelledby={`faq-${category.id}-heading`}>
                <header class="faq-category-section__heading">
                  <div>
                    <p class="eyebrow">{category.code}</p>
                    <h3 id={`faq-${category.id}-heading`}>{category.title}</h3>
                  </div>
                  <div class="faq-category-section__meta">
                    <span>{category.items.length}개 질문</span>
                    <a href="#faq-categories">카테고리 보기 ↑</a>
                  </div>
                </header>
                <div class="faq-list">
                  {category.items.map((item) => (
                    <details>
                      <summary>
                        <span class="faq-item__number" aria-hidden="true">{String(item.number).padStart(2, "0")}</span>
                        <span class="faq-item__question">{item.question}</span>
                        <span class="faq-item__icon" aria-hidden="true">+</span>
                      </summary>
                      <div class="faq-item__answer"><p>{item.answer}</p></div>
                    </details>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </>
      ) : (
        <div class="empty-state"><span class="empty-state__number" aria-hidden="true">?</span><div><h2>질문과 답변을 준비하고 있습니다</h2><p>확인되지 않은 일반 답변을 채우지 않고, 실제 상담 내용을 바탕으로 승인된 질문부터 공개합니다.</p></div></div>
      )}
    </div>
  </section>
  <section class="section section--soft" aria-labelledby="consultation-heading">
    <div class="shell consultation-board">
      <div class="consultation-board__intro">
        <p class="eyebrow">비공개 상담</p>
        <h2 id="consultation-heading">편하게 남겨주세요,<br />대표가 직접 확인합니다</h2>
        <p>입력한 내용은 홈페이지나 공개 게시판에 저장되지 않습니다. 작성 후 문자 앱으로 이동하며, 전송 버튼을 눌러야 상담 내용이 전달됩니다.</p>
        <div class="consultation-board__actions">
          <a class="button button--secondary" href={phoneHref}>전화 상담 {office.mobile}</a>
          <a class="text-link" href={kakaoHref} target="_blank" rel="noopener noreferrer">카카오톡으로 상담하기 ↗</a>
        </div>
      </div>
      <form class="consultation-form" action={smsHref} data-consultation-form>
        <div class="consultation-form__grid">
          <div><label for="consultation-name">이름 <small>(닉네임 가능)</small></label><input id="consultation-name" name="name" autocomplete="name" maxlength="30" required /></div>
          <div><label for="consultation-contact">회신 연락처 <small>(선택)</small></label><input id="consultation-contact" name="contact" type="tel" autocomplete="tel" maxlength="30" /></div>
          <div class="consultation-form__wide"><label for="consultation-subject">문의 제목</label><input id="consultation-subject" name="subject" maxlength="80" placeholder="예: 리더스시티 84㎡ 매매 문의" required /></div>
          <div class="consultation-form__wide"><label for="consultation-message">문의 내용</label><textarea id="consultation-message" name="message" rows="6" maxlength="1000" placeholder="원하는 단지, 거래유형, 예산, 면적 등을 적어주세요." required></textarea></div>
        </div>
        <p class="consultation-form__notice">사이트에 저장하지 않는 문자 상담입니다. 계약서·신분증·계좌번호 같은 민감정보는 적지 마세요.</p>
        <button class="button button--primary" type="submit">문자로 상담 보내기</button>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-consultation-form]");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const lines = [
      "[홈페이지 상담]",
      `이름: ${String(data.get("name") ?? "")}`,
      `회신 연락처: ${String(data.get("contact") ?? "미입력") || "미입력"}`,
      `제목: ${String(data.get("subject") ?? "")}`,
      "",
      String(data.get("message") ?? ""),
    ];
    window.location.href = `${form.action}?body=${encodeURIComponent(lines.join("\n"))}`;
  });
</script>
