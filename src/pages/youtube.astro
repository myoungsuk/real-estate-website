---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import ContactPanel from "../components/ContactPanel.astro";
import ExternalContentList from "../components/ExternalContentList.astro";
import { publishedYoutubeContents } from "../lib/content";
import { office } from "../lib/site";

const title = "대전 동구 유튜브 | 리더스시티행복한공인중개사사무소";
const description = "유튜브에 공개한 대전 동구와 리더스시티 현장 영상을 모아 안내합니다.";
---

<BaseLayout {title} {description}>
  <PageIntro eyebrow="대전동구유튜브---천동리더스시티행복한부동산tv" title="대전 동구 유튜브" description="대전 동구와 리더스시티의 현장 모습을 영상으로 편하게 확인해 보세요." />
  <section class="section" aria-labelledby="youtube-content-heading">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">YOUTUBE</p><h2 id="youtube-content-heading">유튜브 콘텐츠 {publishedYoutubeContents.length}건</h2></div><a class="text-link" href={office.youtubeUrl} target="_blank" rel="noopener noreferrer">유튜브 채널 바로가기 ↗</a></div>
      <ExternalContentList items={publishedYoutubeContents} emptyLabel="공개할 유튜브 콘텐츠를 준비하고 있습니다." pageSize={6} categoryLabel="유튜브 콘텐츠" youtubeFilters hoverPreview />
    </div>
  </section>
  <ContactPanel />
</BaseLayout>
