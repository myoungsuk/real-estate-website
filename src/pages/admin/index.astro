---
import AdminApiStatus from "../../components/admin/AdminApiStatus.astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { naverListings, naverListingsCheckedAt } from "../../lib/naver-listings";

const counts = {
  total: naverListings.length,
  sale: naverListings.filter((listing) => listing.tradeType === "sale").length,
  lease: naverListings.filter((listing) => ["jeonse", "monthly-rent"].includes(listing.tradeType)).length,
};
---

<AdminLayout
  title="관리자 대시보드 | 행복한부동산"
  description="행복한부동산 콘텐츠와 배포 상태를 확인하는 관리자 대시보드입니다."
>
  <div class="admin-page-header">
    <div>
      <p class="admin-eyebrow">ADMIN CONSOLE</p>
      <h1>운영 현황을 한눈에 확인하세요.</h1>
      <p>네이버 공개 매물과 첫 화면 문구, 블로그·유튜브, 지역·단지 설명을 한곳에서 확인합니다.</p>
    </div>
    <span class="admin-stage-badge">2단계 · 콘텐츠 관리</span>
  </div>

  <section class="admin-stat-grid" aria-label="매물 현황">
    <article class="admin-stat-card">
      <span>전체 매물</span>
      <strong>{counts.total.toLocaleString("ko-KR")}</strong>
      <small>네이버 공개 데이터 기준</small>
    </article>
    <article class="admin-stat-card admin-stat-card--published">
      <span>매매</span>
      <strong>{counts.sale.toLocaleString("ko-KR")}</strong>
      <small>네이버 거래유형 기준</small>
    </article>
    <article class="admin-stat-card">
      <span>전세·월세</span>
      <strong>{counts.lease.toLocaleString("ko-KR")}</strong>
      <small>네이버 거래유형 기준</small>
    </article>
    <article class="admin-stat-card">
      <span>최근 동기화 기준</span>
      <strong>{naverListingsCheckedAt}</strong>
      <small>사이트 데이터 확인일</small>
    </article>
  </section>

  <div class="admin-dashboard-grid">
    <section class="admin-panel admin-next-action" aria-labelledby="admin-next-action-title">
      <div class="admin-panel__heading">
        <div>
          <p class="admin-eyebrow">바로가기</p>
          <h2 id="admin-next-action-title">콘텐츠 관리 시작</h2>
        </div>
        <span class="admin-panel__number" aria-hidden="true">01</span>
      </div>
      <p>네이버에 공개한 매물을 확인하고 네이버 매물 관리 화면으로 바로 이동할 수 있습니다.</p>
      <a class="admin-action-link" href="/admin/listings/">
        네이버 매물 관리로 이동
        <span aria-hidden="true">→</span>
      </a>
    </section>

    <AdminApiStatus />
  </div>

  <section class="admin-panel admin-roadmap" aria-labelledby="admin-roadmap-title">
    <div class="admin-panel__heading">
      <div>
        <p class="admin-eyebrow">개발 순서</p>
        <h2 id="admin-roadmap-title">관리자 페이지 진행 단계</h2>
      </div>
    </div>
    <ol>
      <li>
        <span>1</span>
        <div><strong>보호된 관리자</strong><small>대시보드·Access 연결</small></div>
      </li>
      <li class="is-current">
        <span>2</span>
        <div><strong>네이버 매물 연결</strong><small>공개 매물 확인·네이버 관리 이동</small></div>
      </li>
      <li>
        <span>3</span>
        <div><strong>자체 콘텐츠 편집</strong><small>문구·링크·지역 설명</small></div>
      </li>
      <li>
        <span>4</span>
        <div><strong>배포·복구</strong><small>미리보기·상태 확인·롤백</small></div>
      </li>
    </ol>
  </section>
</AdminLayout>
