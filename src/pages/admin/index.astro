---
import AdminApiStatus from "../../components/admin/AdminApiStatus.astro";
import AdminIcon from "../../components/admin/AdminIcon.astro";
import AdminPageHelp from "../../components/admin/AdminPageHelp.astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { naverListings } from "../../lib/naver-listings";
import { buildListingReviewQueue } from "../../lib/listing-review.mjs";
import { bankLastSeenOn, shortDate, WOORI_SYNC_LATE_HELP_TEXT, WOORI_SYNC_NO_LISTINGS_TEXT, wooriLastSeenOn } from "../../lib/work/dashboard-view.mjs";
import reviewPolicy from "../../../.github/listing-review-policy.json";
import reviewState from "../../../.github/listing-review-state.json";

// 관리자 대시보드(사용자 선택 2026-11-23 A안 "숫자 띠 + 칸 넷", 휴대폰은 숫자 띠 빼기, 글자는 규칙 그대로).
// 할 일·계약 일정·이번 달 돈·실거래는 화면이 보인 뒤 업무 API GET /work/dashboard 하나로 부른다(칸마다 켜기 값을 서버가 따로 봄).
// 네이버 공개 매물 수와 재확인 대기는 지금처럼 빌드 때 값이다(서버를 부르지 않음).
const counts = {
  total: naverListings.length,
  sale: naverListings.filter((listing) => listing.tradeType === "sale").length,
  lease: naverListings.filter((listing) => ["jeonse", "monthly-rent"].includes(listing.tradeType)).length,
};
const todayParts = Object.fromEntries(new Intl.DateTimeFormat("en-US", {
  timeZone: "Asia/Seoul",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).formatToParts(new Date()).map(({ type, value }) => [type, value]));
const reviewQueue = buildListingReviewQueue(
  naverListings,
  reviewState,
  reviewPolicy,
  `${todayParts.year}-${todayParts.month}-${todayParts.day}`,
);
const reviewText = reviewQueue.enabled ? `재확인 필요 ${reviewQueue.needsReview}건` : "재확인 경고 기준 미설정";
// 부동산뱅크 자동 받기가 멈췄는지는 화면을 연 때 아래 스크립트가 잰다(빌드 때는 받은 날만 실음).
const bankSeenOn = bankLastSeenOn(reviewState);
// 우리집부동산 자동 받기(사무소 PC, 09:20)는 '오늘 받았나'를 화면을 연 때 잰다. 우리집부동산 매물이 0건이면 받은 날을 알 수 없다는 글만 둔다.
const wooriSeenOn = wooriLastSeenOn(reviewState);
---

<AdminLayout
  title="관리자 대시보드 | 행복한부동산"
  description="오늘 할 일, 다가오는 계약 일정, 이번 달 돈, 실거래·매물을 한눈에 보는 관리자 대시보드입니다."
>
  <div class="dsh" data-dsh>
    <header class="dsh-head">
      <span class="work-round-icon work-round-icon--title" data-tone="navy">
        <AdminIcon name="dashboard" size={22} />
      </span>
      <div class="dsh-head__title">
        <h1>대시보드</h1>
        <p class="dsh-date" data-dsh-date></p>
      </div>
      <AdminApiStatus />
    </header>
    <AdminPageHelp page="/admin/" />

    <p class="dsh-boot" role="status" data-dsh-boot>오늘 숫자를 불러오고 있습니다…</p>

    <!-- 숫자 4칸(980px 이상만 보임). 칸을 누르면 그 화면으로 간다. -->
    <nav class="dsh-strip" aria-label="오늘 숫자" data-dsh-strip hidden></nav>

    <div class="dsh-grid">
      <section class="dsh-panel" aria-labelledby="dsh-tasks-title" data-dsh-section="tasks">
        <header class="dsh-panel__head">
          <h2 id="dsh-tasks-title">할 일</h2>
          <span class="dsh-count" data-dsh-count></span>
          <a class="dsh-more" href="/admin/work/tasks/">할 일 화면</a>
        </header>
        <div class="dsh-body" data-dsh-body></div>
      </section>

      <section class="dsh-panel" aria-labelledby="dsh-events-title" data-dsh-section="events">
        <header class="dsh-panel__head">
          <h2 id="dsh-events-title">다가오는 계약 일정</h2>
          <span class="dsh-count" data-dsh-count></span>
          <a class="dsh-more" href="/admin/work/customers/">손님</a>
        </header>
        <div class="dsh-body" data-dsh-body></div>
      </section>

      <section class="dsh-panel" aria-labelledby="dsh-money-title" data-dsh-section="money">
        <header class="dsh-panel__head">
          <h2 id="dsh-money-title">이번 달 돈</h2>
          <span class="dsh-count" data-dsh-count></span>
          <a class="dsh-more" href="/admin/work/ledger/">매출장부</a>
        </header>
        <div class="dsh-body" data-dsh-body></div>
      </section>

      <section class="dsh-panel" aria-labelledby="dsh-realprice-title" data-dsh-section="realprice">
        <header class="dsh-panel__head">
          <h2 id="dsh-realprice-title">실거래·매물</h2>
          <span class="dsh-count" data-dsh-count></span>
          <a class="dsh-more" href="/admin/work/realprice/">실거래가</a>
        </header>
        <div class="dsh-body" data-dsh-body></div>
        <a class="dsh-listing" href="/admin/listings/">
          <span>네이버 공개 매물 <b>{counts.total.toLocaleString("ko-KR")}건</b> · 매매 {counts.sale.toLocaleString("ko-KR")} · 전세·월세 {counts.lease.toLocaleString("ko-KR")}</span>
          <span class="dsh-meta">{reviewText}</span>
          {bankSeenOn && <span class="dsh-meta dsh-sync" data-dsh-bank-sync={bankSeenOn}>부동산뱅크 자동 받기 {shortDate(bankSeenOn)}</span>}
          {wooriSeenOn
            ? <span class="dsh-meta dsh-sync" data-dsh-woori-sync={wooriSeenOn}>우리집부동산 자동 받기 {shortDate(wooriSeenOn)}</span>
            : <span class="dsh-meta dsh-sync">{WOORI_SYNC_NO_LISTINGS_TEXT}</span>}
        </a>
        <!-- '오늘 못 받음'일 때만 보인다. 매물 링크 안에 고리를 겹칠 수 없어 바로 아래에 따로 둔다. -->
        {wooriSeenOn && <a class="dsh-sync-help" href="/admin/listings/editor/#woori-import-heading" data-dsh-woori-help hidden>{WOORI_SYNC_LATE_HELP_TEXT}</a>}
      </section>
    </div>
  </div>

  <script>
    import { getDashboard, WorkApiError, type Dashboard, type DashboardEvents, type DashboardMoney, type DashboardRealprice, type DashboardTasks } from "../../lib/work-dashboard-client";
    import { todayInKorea } from "../../lib/work/legal-dates.mjs";
    import {
      bankSyncState,
      DASHBOARD_LINKS,
      dateTitle,
      emptyText,
      eventHref,
      eventKindText,
      eventPartyText,
      eventWhen,
      highListTitle,
      kpiItems,
      loadFailedState,
      moneyFigures,
      moneyItemMeta,
      moneyKindText,
      sectionCount,
      sectionState,
      taskWhen,
      tradeAreaText,
      tradePriceText,
      undatedText,
      wooriSyncState,
    } from "../../lib/work/dashboard-view.mjs";

    // 손님 이름·할 일 제목·거래 제목은 textContent로만 그린다(주소에는 손님 UUID만, 브라우저 저장소에는 아무것도 넣지 않음).
    type Key = "tasks" | "events" | "money" | "realprice";
    const KEYS: Key[] = ["tasks", "events", "money", "realprice"];
    const root = document.querySelector<HTMLElement>("[data-dsh]");
    const boot = root?.querySelector<HTMLElement>("[data-dsh-boot]");
    const strip = root?.querySelector<HTMLElement>("[data-dsh-strip]");
    const dateLine = root?.querySelector<HTMLElement>("[data-dsh-date]");

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className = "", text = "") => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text) node.textContent = text;
      return node;
    };
    const rowLink = (href: string, parts: (HTMLElement | string)[], className = "dsh-row") => {
      const item = el("li");
      const anchor = el("a", className);
      anchor.href = href;
      anchor.append(...parts);
      item.append(anchor);
      return item;
    };
    const list = (items: HTMLElement[]) => {
      const node = el("ul", "dsh-rows");
      node.append(...items);
      return node;
    };
    const monthDay = (dateText: string) => {
      const [, month, day] = dateText.split("-").map(Number);
      return `${month}.${day}`;
    };

    function renderStrip(data: Dashboard) {
      strip!.replaceChildren(...kpiItems(data).map((item) => {
        const cell = el("a", "dsh-kpi");
        cell.href = item.href;
        const value = el("strong", item.value === "—" ? "dsh-kpi__value is-off" : "dsh-kpi__value", item.value);
        if (item.unit) value.append(el("small", "", item.unit));
        cell.append(el("span", "dsh-kpi__label", item.label), value, el("span", item.warn ? "dsh-kpi__sub is-warn" : "dsh-kpi__sub", item.sub));
        return cell;
      }));
      strip!.hidden = false;
    }

    function renderTasks(section: DashboardTasks, today: string) {
      if (section.items.length === 0) return [el("p", "dsh-empty", emptyText("tasks", section))];
      return [list(section.items.map((task) => {
        const when = taskWhen(task.dueOn, today);
        const repeatText = task.repeat === "weekly" ? "매주 반복" : task.repeat === "monthly" ? "매월 반복" : "";
        return rowLink(DASHBOARD_LINKS.tasks, [
          el("span", when.late ? "dsh-when is-late" : "dsh-when", when.text),
          el("span", "dsh-what", task.title),
          el("span", "dsh-meta", task.deal?.title ?? repeatText),
        ]);
      }))];
    }

    function renderEvents(section: DashboardEvents, today: string) {
      if (section.items.length === 0) return [el("p", "dsh-empty", emptyText("events", section))];
      return [list(section.items.map((item) => {
        const when = eventWhen(item.dueOn, today);
        const whenNode = el("span", when.late ? "dsh-when is-late" : "dsh-when");
        whenNode.append(el("b", "", when.lead), ` ${when.date}`);
        const what = el("span", "dsh-what");
        what.append(el("span", "dsh-chip", eventKindText(item)), ` ${item.deal.title}`);
        return rowLink(eventHref(item), [whenNode, what, el("span", "dsh-meta", eventPartyText(item))], "dsh-row dsh-row--stack");
      }))];
    }

    function renderMoney(section: DashboardMoney) {
      const figures = el("dl", "dsh-money");
      figures.append(...moneyFigures(section).map((figure) => {
        const box = el("div", figure.due ? "is-due" : "");
        box.append(el("dt", "", figure.label), el("dd", "", figure.value));
        return box;
      }));
      const nodes: HTMLElement[] = [figures];
      if (section.items.length > 0) {
        nodes.push(el("h3", "dsh-sub", "미입금 장부 줄"));
        nodes.push(list(section.items.map((item) => {
          const what = el("span", "dsh-what");
          what.append(el("span", "dsh-chip", moneyKindText(item.kind)), ` ${item.label}`);
          return rowLink(DASHBOARD_LINKS.ledger, [el("span", "dsh-when", monthDay(item.basisOn)), what, el("span", "dsh-meta", moneyItemMeta(item))]);
        })));
      } else if (section.receivableWon === 0) {
        nodes.push(el("p", "dsh-empty", emptyText("money", section)));
      }
      const undated = undatedText(section);
      if (undated) nodes.push(el("p", "dsh-note", undated));
      return nodes;
    }

    function renderRealprice(section: DashboardRealprice) {
      const nodes: HTMLElement[] = [el("h3", "dsh-sub", highListTitle(section))];
      if (section.partial) nodes.push(el("p", "dsh-note", "거래가 많아 일부 기간만 판정했습니다. 실거래가 화면에서 전부 볼 수 있습니다."));
      if (section.items.length === 0) {
        nodes.push(el("p", "dsh-empty", emptyText("realprice", section)));
        return nodes;
      }
      nodes.push(list(section.items.map((item) => {
        const what = el("span", "dsh-what", `${item.aptName} ${tradeAreaText(item.areaM2)} 매매 `);
        what.append(el("span", "dsh-chip dsh-chip--high", "신고가"));
        return rowLink(DASHBOARD_LINKS.realprice, [el("span", "dsh-when", monthDay(item.dealDate)), what, el("span", "dsh-meta dsh-price", tradePriceText(item.priceWon))]);
      })));
      return nodes;
    }

    function renderFailed(state: { text: string; canRetry: boolean; off: boolean }) {
      const box = el("div", state.off ? "dsh-state is-off" : "dsh-state is-fail");
      box.append(el("p", "", state.off ? `꺼짐 · ${state.text}` : `! ${state.text}`));
      if (state.canRetry) {
        const again = el("button", "work-secondary-button", "다시 불러오기");
        again.type = "button";
        again.addEventListener("click", () => void load());
        box.append(again);
      }
      return [box];
    }

    function renderSection(key: Key, data: Dashboard | null, code: string | null) {
      const panel = root!.querySelector<HTMLElement>(`[data-dsh-section="${key}"]`);
      const body = panel?.querySelector<HTMLElement>("[data-dsh-body]");
      const count = panel?.querySelector<HTMLElement>("[data-dsh-count]");
      if (!panel || !body || !count) return;
      const section = data ? data[key] : null;
      count.textContent = section ? sectionCount(key, section) : "";
      if (!data || !section || !section.ok) {
        body.replaceChildren(...renderFailed(section && !section.ok ? sectionState(section.code) : loadFailedState(code)));
        return;
      }
      if (key === "tasks") body.replaceChildren(...renderTasks(data.tasks as DashboardTasks, data.today));
      else if (key === "events") body.replaceChildren(...renderEvents(data.events as DashboardEvents, data.today));
      else if (key === "money") body.replaceChildren(...renderMoney(data.money as DashboardMoney));
      else body.replaceChildren(...renderRealprice(data.realprice as DashboardRealprice));
    }

    let token = 0;
    async function load() {
      const mine = ++token;
      boot!.hidden = false;
      boot!.textContent = "오늘 숫자를 불러오고 있습니다…";
      try {
        const data = await getDashboard();
        if (mine !== token) return;
        dateLine!.textContent = dateTitle(data.today);
        boot!.hidden = true;
        renderStrip(data);
        KEYS.forEach((key) => renderSection(key, data, null));
      } catch (error) {
        if (mine !== token) return;
        // 응답 자체를 받지 못함(로그인 만료·연결 끊김 등): 네 칸 모두 같은 까닭으로 알리고 숫자 띠는 숨긴다.
        const code = error instanceof WorkApiError ? error.code : null;
        boot!.hidden = true;
        strip!.hidden = true;
        KEYS.forEach((key) => renderSection(key, null, code));
      }
    }

    // 부동산뱅크·우리집부동산 자동 받기 줄: 서버를 부르지 않고 빌드 때 실은 받은 날과 지금 시각만 본다.
    // 미리 그린 뒤·뒤로 가기 캐시·오래 켜 둔 탭에서도 낡지 않게 화면이 보일 때마다 다시 잰다.
    const bankSync = root?.querySelector<HTMLElement>("[data-dsh-bank-sync]");
    const wooriSync = root?.querySelector<HTMLElement>("[data-dsh-woori-sync]");
    const wooriHelp = root?.querySelector<HTMLElement>("[data-dsh-woori-help]");
    const renderSyncLine = (line: HTMLElement, sync: { stale: boolean; text: string }) => {
      line.textContent = sync.text;
      line.classList.toggle("is-late", sync.stale);
    };
    const renderSyncLines = () => {
      if (bankSync?.dataset.dshBankSync) renderSyncLine(bankSync, bankSyncState(bankSync.dataset.dshBankSync, todayInKorea(), Date.now()));
      if (wooriSync?.dataset.dshWooriSync) {
        const sync = wooriSyncState(wooriSync.dataset.dshWooriSync, todayInKorea(), Date.now());
        renderSyncLine(wooriSync, sync);
        if (wooriHelp) wooriHelp.hidden = !sync.stale;
      }
    };
    renderSyncLines();
    document.addEventListener("prerenderingchange", renderSyncLines);
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") renderSyncLines();
    });
    window.addEventListener("pageshow", renderSyncLines);

    if (root && boot && strip && dateLine) {
      dateLine.textContent = dateTitle(todayInKorea());
      // 화면이 실제로 보인 뒤에만 부른다(탭 미리 그리기 중에는 부르지 않음).
      const doc = document as Document & { prerendering?: boolean };
      if (doc.prerendering) document.addEventListener("prerenderingchange", () => void load(), { once: true });
      else void load();
      // 뒤로 가기 캐시에서 돌아오면 다시 부른다(그사이 끝낸 할 일·들어온 돈이 옛 숫자로 남지 않게).
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) void load();
      });
    }
  </script>
</AdminLayout>
