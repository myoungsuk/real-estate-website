---
import AdminPageHelp from "../../../components/admin/AdminPageHelp.astro";
import AdminWriteGate from "../../../components/admin/AdminWriteGate.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { homeContent } from "../../../lib/content";
// 칸별 최대 글자 수는 서버 검사(콘텐츠 검증)와 같은 값을 쓴다. 입력 칸 제한은 편의이고 실제 막기는 서버가 한다.
import { HOME_CONTENT_MAX_LENGTHS as MAX } from "../../../../scripts/content-validation.mjs";
---

<AdminLayout
  title="첫 화면·사무소 관리 | 행복한부동산 관리자"
  description="대표 소개, 사무소 소개와 리더스시티 안내 문구를 관리합니다."
>
  <div class="admin-page-header admin-page-header--compact">
    <div>
      <nav class="admin-breadcrumbs" aria-label="현재 위치"><a href="/admin/">대시보드</a><span>/</span><span aria-current="page">첫 화면·사무소</span></nav>
      <h1>첫 화면·사무소 관리</h1>
      <p>대표 소개, 단지 현장 사진 영역, 리더스시티 설명 문구를 수정합니다.</p>
    </div>
    <a class="admin-text-link" href="/#about">공개 첫 화면 보기 <span aria-hidden="true">↗</span></a>
  </div>

  <AdminPageHelp page="/admin/content/" />

  <AdminWriteGate />

  <form class="admin-editor" data-home-content-form>
    <section class="admin-panel admin-editor__section" aria-labelledby="broker-editor-heading">
      <div class="admin-panel__heading"><div><p class="admin-eyebrow">대표 소개</p><h2 id="broker-editor-heading">맨 위 대표 영역</h2></div><span class="admin-panel__number">01</span></div>
      <div class="admin-form-grid">
        <div class="admin-field"><label for="broker-eyebrow">작은 제목</label><input id="broker-eyebrow" name="brokerEyebrow" value={homeContent.broker.eyebrow} maxlength={MAX["broker.eyebrow"]} required data-write-control disabled /></div>
        <div class="admin-field admin-field--wide"><label for="broker-headline">대표 문장</label><textarea id="broker-headline" name="brokerHeadline" rows="3" maxlength={MAX["broker.headline"]} required data-write-control disabled>{homeContent.broker.headline}</textarea></div>
        {homeContent.broker.points.map((point, index) => (
          <fieldset class="admin-subform admin-field--wide">
            <legend>소개 항목 {index + 1}</legend>
            <div class="admin-field"><label for={`broker-point-icon-${index}`}>그림 문자</label><input id={`broker-point-icon-${index}`} name={`brokerPointIcon${index}`} value={point.icon} maxlength={MAX.pointIcon} data-write-control disabled /><small>이모지 한 개(비워도 됨)</small></div>
            <div class="admin-field"><label for={`broker-point-title-${index}`}>제목</label><input id={`broker-point-title-${index}`} name={`brokerPointTitle${index}`} value={point.title} maxlength={MAX.pointTitle} required data-write-control disabled /></div>
            <div class="admin-field admin-field--wide"><label for={`broker-point-description-${index}`}>설명</label><textarea id={`broker-point-description-${index}`} name={`brokerPointDescription${index}`} rows="3" maxlength={MAX.pointDescription} required data-write-control disabled>{point.description}</textarea></div>
          </fieldset>
        ))}
        <div class="admin-field"><label for="broker-alt">대표 사진 설명</label><input id="broker-alt" name="brokerAlt" value={homeContent.broker.portrait.alt} maxlength={MAX.imageAlt} required data-write-control disabled /></div>
        <div class="admin-field"><label for="broker-image">대표 사진 교체</label><input id="broker-image" name="brokerImage" type="file" accept="image/jpeg,image/png,image/webp" data-write-control disabled /><small>자동으로 WebP·최대 1600px로 최적화합니다.</small></div>
      </div>
    </section>

    <section class="admin-panel admin-editor__section" aria-labelledby="office-editor-heading">
      <div class="admin-panel__heading"><div><p class="admin-eyebrow">현장 사진</p><h2 id="office-editor-heading">단지 사진과 지역 설명</h2></div><span class="admin-panel__number">02</span></div>
      <div class="admin-form-grid">
        <div class="admin-field"><label for="office-eyebrow">작은 제목</label><input id="office-eyebrow" name="officeEyebrow" value={homeContent.office.eyebrow} maxlength={MAX["office.eyebrow"]} required data-write-control disabled /></div>
        <div class="admin-field"><label for="office-title">큰 제목</label><input id="office-title" name="officeTitle" value={homeContent.office.title} maxlength={MAX["office.title"]} required data-write-control disabled /></div>
        <div class="admin-field admin-field--wide"><label for="office-description">지역 설명</label><textarea id="office-description" name="officeDescription" rows="4" maxlength={MAX["office.description"]} required data-write-control disabled>{homeContent.office.description}</textarea></div>
        <div class="admin-field admin-field--wide"><label for="office-badges">특징 표시</label><textarea id="office-badges" name="officeBadges" rows="4" data-write-control disabled>{homeContent.office.badges.join("\n")}</textarea><small>한 줄에 한 개씩 입력합니다(한 줄 최대 {MAX.badge}자).</small></div>
        <div class="admin-field"><label for="office-alt">단지 사진 설명</label><input id="office-alt" name="officeAlt" value={homeContent.office.image.alt} maxlength={MAX.imageAlt} required data-write-control disabled /></div>
        <div class="admin-field"><label for="office-image">단지 사진 교체</label><input id="office-image" name="officeImage" type="file" accept="image/jpeg,image/png,image/webp" data-write-control disabled /></div>
      </div>
    </section>

    <section class="admin-panel admin-editor__section" aria-labelledby="area-editor-heading">
      <div class="admin-panel__heading"><div><p class="admin-eyebrow">지역 설명</p><h2 id="area-editor-heading">리더스시티 알아보기</h2></div><span class="admin-panel__number">03</span></div>
      <div class="admin-form-grid">
        <div class="admin-field"><label for="area-eyebrow">작은 제목</label><input id="area-eyebrow" name="areaEyebrow" value={homeContent.areaGuide.eyebrow} maxlength={MAX["areaGuide.eyebrow"]} required data-write-control disabled /></div>
        <div class="admin-field"><label for="area-title">큰 제목</label><input id="area-title" name="areaTitle" value={homeContent.areaGuide.title} maxlength={MAX["areaGuide.title"]} required data-write-control disabled /></div>
        <div class="admin-field admin-field--wide"><label for="area-description">도입 설명</label><textarea id="area-description" name="areaDescription" rows="4" maxlength={MAX["areaGuide.description"]} required data-write-control disabled>{homeContent.areaGuide.description}</textarea></div>
        {homeContent.areaGuide.cards.map((card, index) => (
          <fieldset class="admin-subform admin-field--wide">
            <legend>설명 카드 {index + 1}</legend>
            <div class="admin-field"><label for={`area-card-title-${index}`}>제목</label><input id={`area-card-title-${index}`} name={`areaCardTitle${index}`} value={card.title} maxlength={MAX.cardTitle} required data-write-control disabled /></div>
            <div class="admin-field"><label for={`area-card-description-${index}`}>설명</label><textarea id={`area-card-description-${index}`} name={`areaCardDescription${index}`} rows="3" maxlength={MAX.cardDescription} required data-write-control disabled>{card.description}</textarea></div>
          </fieldset>
        ))}
      </div>
    </section>

    <div class="admin-editor__actions">
      <p class="admin-form-status" data-home-content-status aria-live="polite">변경 전 내용을 확인해 주세요.</p>
      <button class="admin-primary-button" type="submit" data-write-control disabled>변경 내용 저장</button>
    </div>
  </form>

  <script>
    import {
      convertImageFileToWebp,
      getAdminSession,
      readAdminContent,
      setAdminFormStatus,
      uploadAdminImage,
      writeAdminContent,
      type AdminResource,
    } from "../../../lib/admin-content-client";
    import { guardAdminFormChanges, reviewAdminContentChange } from "../../../lib/admin-content-review";
    import type { HomeContent } from "../../../lib/content";

    const form = document.querySelector<HTMLFormElement>("[data-home-content-form]");
    const status = document.querySelector<HTMLElement>("[data-home-content-status]");
    let resource: AdminResource<HomeContent> | null = null;
    const dirtyGuard = guardAdminFormChanges(form);

    const field = (name: string) => form?.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
    const setValues = (data: HomeContent) => {
      const values: Record<string, string> = {
        brokerEyebrow: data.broker.eyebrow,
        brokerHeadline: data.broker.headline,
        brokerAlt: data.broker.portrait.alt,
        officeEyebrow: data.office.eyebrow,
        officeTitle: data.office.title,
        officeDescription: data.office.description,
        officeBadges: data.office.badges.join("\n"),
        officeAlt: data.office.image.alt,
        areaEyebrow: data.areaGuide.eyebrow,
        areaTitle: data.areaGuide.title,
        areaDescription: data.areaGuide.description,
      };
      data.broker.points.forEach((point, index) => {
        values[`brokerPointIcon${index}`] = point.icon;
        values[`brokerPointTitle${index}`] = point.title;
        values[`brokerPointDescription${index}`] = point.description;
      });
      data.areaGuide.cards.forEach((card, index) => {
        values[`areaCardTitle${index}`] = card.title;
        values[`areaCardDescription${index}`] = card.description;
      });
      Object.entries(values).forEach(([name, value]) => { const input = field(name); if (input) input.value = value; });
    };
    const createCandidate = (portraitSrc: string, officeImageSrc: string) => {
      if (!resource) return null;
      const value = (name: string) => field(name)?.value.trim() ?? "";
      return {
        broker: { eyebrow: value("brokerEyebrow"), headline: value("brokerHeadline"), points: resource.data.broker.points.map((_, index) => ({ icon: value(`brokerPointIcon${index}`), title: value(`brokerPointTitle${index}`), description: value(`brokerPointDescription${index}`) })), portrait: { src: portraitSrc, alt: value("brokerAlt") } },
        office: { eyebrow: value("officeEyebrow"), title: value("officeTitle"), description: value("officeDescription"), image: { src: officeImageSrc, alt: value("officeAlt") }, badges: value("officeBadges").split("\n").map((item) => item.trim()).filter(Boolean) },
        areaGuide: { eyebrow: value("areaEyebrow"), title: value("areaTitle"), description: value("areaDescription"), cards: resource.data.areaGuide.cards.map((_, index) => ({ title: value(`areaCardTitle${index}`), description: value(`areaCardDescription${index}`) })) },
      } satisfies HomeContent;
    };

    // 세션 결과는 getAdminSession()의 공유 Promise로 직접 기다린다. 'admin-write-ready' 신호만 들으면 세션 응답이 이 스크립트보다 먼저 올 때
    // 신호를 놓쳐 최신 내용을 불러오지 않는다. 실패 안내는 AdminWriteGate가 보여 주므로 여기서는 조용히 넘긴다.
    void getAdminSession().then((session) => {
      if (!session.writeEnabled) return;
      void readAdminContent<HomeContent>("home-content").then((current) => {
        resource = current;
        setValues(current.data);
        dirtyGuard.markSaved();
        setAdminFormStatus(status, "GitHub의 최신 내용을 불러왔습니다.");
      }).catch((error) => setAdminFormStatus(status, error instanceof Error ? error.message : "최신 내용을 불러오지 못했습니다.", "error"));
    }).catch(() => undefined);

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!resource) return setAdminFormStatus(status, "최신 내용을 먼저 불러와 주세요.", "error");
      const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
      if (submit) submit.disabled = true;
      setAdminFormStatus(status, "변경 내용을 만들고 서버 검증을 준비하고 있습니다.", "saving");
      try {
        const portraitFile = (field("brokerImage") as HTMLInputElement)?.files?.[0];
        const officeFile = (field("officeImage") as HTMLInputElement)?.files?.[0];
        const reviewCandidate = createCandidate(
          portraitFile ? "/images/content/office/pending-admin-review.webp" : resource.data.broker.portrait.src,
          officeFile ? "/images/content/office/pending-admin-review.webp" : resource.data.office.image.src,
        );
        if (!reviewCandidate) throw new Error("최신 내용을 먼저 불러와 주세요.");
        const confirmed = await reviewAdminContentChange({
          changes: [{ resource: "home-content", sha: resource.sha, data: reviewCandidate }],
          beforeByResource: { "home-content": resource.data },
          impactPages: ["홈 첫 화면", "대표 소개", "리더스시티 안내"],
        });
        if (!confirmed) {
          setAdminFormStatus(status, "저장을 취소했습니다. 입력한 내용은 그대로 유지됩니다.");
          return;
        }
        setAdminFormStatus(status, "검증된 사진과 문구를 GitHub에 저장하고 있습니다.", "saving");
        let portraitSrc = resource.data.broker.portrait.src;
        let officeImageSrc = resource.data.office.image.src;
        if (portraitFile) portraitSrc = (await uploadAdminImage("office", await convertImageFileToWebp(portraitFile))).src;
        if (officeFile) officeImageSrc = (await uploadAdminImage("office", await convertImageFileToWebp(officeFile))).src;
        const next = createCandidate(portraitSrc, officeImageSrc);
        if (!next) throw new Error("최신 내용을 먼저 불러와 주세요.");
        const result = await writeAdminContent("home-content", resource.sha, next);
        resource = { resource: "home-content", sha: result.contentSha ?? resource.sha, data: next };
        form.reset();
        setValues(next);
        dirtyGuard.markSaved();
        setAdminFormStatus(status, "GitHub 저장이 완료됐습니다. 배포 상태 메뉴에서 공개 반영 완료를 별도로 확인해 주세요.", "success");
      } catch (error) {
        setAdminFormStatus(status, error instanceof Error ? error.message : "저장하지 못했습니다.", "error");
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  </script>
</AdminLayout>
