---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { naverListings, naverPropertyTypes, naverTradeNames } from "../../../lib/naver-listings";

const sortedListings = [...naverListings].sort((a, b) => b.confirmedAt.localeCompare(a.confirmedAt));
const formatDate = (value: string) => new Intl.DateTimeFormat("ko-KR", { year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date(`${value}T00:00:00+09:00`));
---

<AdminLayout title="네이버 매물 관리 | 리더스시티행복한공인중개사사무소 관리자" description="부동산뱅크 엑셀과 수동 등록으로 관리하는 네이버 공개 매물을 확인합니다.">
  <div class="admin-page-header admin-page-header--compact">
    <div>
      <nav class="admin-breadcrumbs" aria-label="현재 위치"><a href="/admin/">대시보드</a><span aria-hidden="true">/</span><span aria-current="page">네이버 매물</span></nav>
      <p class="admin-eyebrow">NAVER LISTINGS</p><h1>네이버 매물 관리</h1>
      <p>현재 사이트에 반영된 네이버 매물을 확인하고, 부동산뱅크 엑셀 가져오기 또는 직접 등록 화면으로 이동합니다.</p>
    </div>
    <a class="admin-primary-button" href="/admin/listings/editor/">매물 등록·동기화</a>
  </div>

  <p class="admin-inline-notice admin-inline-notice--ready"><span aria-hidden="true">i</span><span>부동산뱅크 매물은 엑셀로 가져오고, 그 밖의 네이버 매물은 직접 등록합니다. 홈페이지에는 공개 정보와 네이버 개별 매물 링크만 표시합니다.</span></p>

  <section class="admin-panel" aria-labelledby="listing-table-title">
    <div class="admin-panel__heading admin-panel__heading--list"><div><p class="admin-eyebrow">네이버 공개 기준</p><h2 id="listing-table-title">전체 매물 <span>{naverListings.length.toLocaleString("ko-KR")}건</span></h2></div><a class="admin-text-link" href="/properties/">공개 매물 화면 보기 <span aria-hidden="true">↗</span></a></div>

    <form class="admin-listing-filters" role="search" data-admin-listing-filters>
      <div class="admin-field admin-field--search"><label for="admin-listing-query">매물 검색</label><input id="admin-listing-query" type="search" name="q" placeholder="매물명, 유형, ID 검색" autocomplete="off" data-admin-listing-query /></div>
      <div class="admin-field"><label for="admin-listing-type">매물유형</label><select id="admin-listing-type" name="type" data-admin-listing-type><option value="all">전체 유형</option>{naverPropertyTypes.map((type) => <option value={type}>{type}</option>)}</select></div>
      <button class="admin-filter-reset" type="button" data-admin-listing-reset>필터 초기화</button>
    </form>

    <p class="admin-listing-count" aria-live="polite" data-admin-listing-count>전체 {naverListings.length.toLocaleString("ko-KR")}건</p>
    <div class="admin-table-wrap" data-admin-listing-results>
      <table class="admin-table">
        <caption class="sr-only">사이트에 반영된 네이버 공개 매물 목록</caption>
        <thead><tr><th scope="col">매물명</th><th scope="col">유형</th><th scope="col">거래</th><th scope="col">가격</th><th scope="col">최근 확인일</th><th scope="col">관리</th></tr></thead>
        <tbody>{sortedListings.map((listing) => (
          <tr data-admin-listing-row data-admin-listing-type={listing.propertyType} data-admin-listing-search={[listing.title, listing.id, listing.propertyType, naverTradeNames[listing.tradeType], listing.areaLabel, listing.floorLabel, listing.direction].filter(Boolean).join(" ")}>
            <td data-label="매물명"><a class="admin-table__title" href={listing.url} target="_blank" rel="noopener noreferrer">{listing.title} ↗</a><small>네이버 매물번호 {listing.id}</small></td>
            <td data-label="유형">{listing.propertyType}</td><td data-label="거래">{naverTradeNames[listing.tradeType]}</td><td data-label="가격">{listing.priceLabel}</td><td data-label="최근 확인일">{formatDate(listing.confirmedAt)}</td><td data-label="관리"><a class="admin-row-action" href={`/admin/listings/editor/?id=${listing.id}`}>수정·종료</a></td>
          </tr>
        ))}</tbody>
      </table>
    </div>

    <div class="admin-empty-state admin-empty-state--filtered" data-admin-listing-filter-empty hidden><span aria-hidden="true">0</span><div><h3>조건에 맞는 매물이 없습니다.</h3><p>검색어나 매물유형을 바꾸거나 필터를 초기화해 주세요.</p><button class="admin-text-button" type="button" data-admin-listing-empty-reset>필터 초기화</button></div></div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>("[data-admin-listing-filters]");
    const queryInput = form?.querySelector<HTMLInputElement>("[data-admin-listing-query]");
    const typeSelect = form?.querySelector<HTMLSelectElement>("[data-admin-listing-type]");
    const resetButton = form?.querySelector<HTMLButtonElement>("[data-admin-listing-reset]");
    const emptyResetButton = document.querySelector<HTMLButtonElement>("[data-admin-listing-empty-reset]");
    const count = document.querySelector<HTMLElement>("[data-admin-listing-count]");
    const results = document.querySelector<HTMLElement>("[data-admin-listing-results]");
    const filterEmpty = document.querySelector<HTMLElement>("[data-admin-listing-filter-empty]");
    const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-admin-listing-row]"));

    if (form && queryInput && typeSelect && resetButton && count && results && filterEmpty) {
      const normalize = (value: string) => value.normalize("NFKC").trim().replace(/\s+/g, " ").toLocaleLowerCase("ko-KR");
      const params = new URLSearchParams(window.location.search);
      queryInput.value = params.get("q") ?? "";
      if ([...typeSelect.options].some((option) => option.value === params.get("type"))) typeSelect.value = params.get("type")!;

      const applyFilters = () => {
        const query = normalize(queryInput.value);
        const selectedType = typeSelect.value;
        let visible = 0;
        rows.forEach((row) => {
          const matchesQuery = !query || normalize(row.dataset.adminListingSearch ?? "").includes(query);
          const matchesType = selectedType === "all" || row.dataset.adminListingType === selectedType;
          row.hidden = !(matchesQuery && matchesType);
          if (!row.hidden) visible += 1;
        });
        const isFiltered = Boolean(query) || selectedType !== "all";
        count.textContent = isFiltered ? `검색 결과 ${visible.toLocaleString("ko-KR")}건 / 전체 ${rows.length.toLocaleString("ko-KR")}건` : `전체 ${rows.length.toLocaleString("ko-KR")}건`;
        const isEmpty = visible === 0;
        results.hidden = isEmpty;
        filterEmpty.hidden = !isEmpty;
        resetButton.disabled = !isFiltered;
        const next = new URLSearchParams();
        if (query) next.set("q", queryInput.value.trim());
        if (selectedType !== "all") next.set("type", selectedType);
        history.replaceState(null, "", `${location.pathname}${next.size ? `?${next}` : ""}`);
      };

      const resetFilters = () => { queryInput.value = ""; typeSelect.value = "all"; applyFilters(); queryInput.focus(); };
      form.addEventListener("submit", (event) => { event.preventDefault(); applyFilters(); });
      queryInput.addEventListener("input", applyFilters);
      typeSelect.addEventListener("change", applyFilters);
      resetButton.addEventListener("click", resetFilters);
      emptyResetButton?.addEventListener("click", resetFilters);
      applyFilters();
    }
  </script>
</AdminLayout>
