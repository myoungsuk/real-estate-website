---
import AdminIcon from "../../../../components/admin/AdminIcon.astro";
import AdminPageHelp from "../../../../components/admin/AdminPageHelp.astro";
import WorkCustomerFields from "../../../../components/admin/WorkCustomerFields.astro";
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { NOTE_BODY_MAX } from "../../../../lib/work/customers-view.mjs";
import { PHOTO_CAPTION_MAX, PHOTO_GO_LABEL, PHOTO_KIND_LABELS, PHOTO_PAGE_SIZE, PHOTO_PICK_MAX } from "../../../../lib/work/photo-view.mjs";
import { TRASH_MOVE_NOTICE } from "../../../../lib/work/trash-view.mjs";

// 손님 카드(단계 2, 사용자 선택 2026-11-21 02:26:01 "A 차례대로", "손님 상세에 일정 함께 담기").
// - 차례: 기본 정보 → 거래·일정 → 메모 → 사진(설계서 7.1, 바로 찍기 시안 2026-11-22 15:39:08 — 휴대폰 하단 막대에 '사진 찍기'). PC(980px 이상)는 왼쪽에 기본 정보를 붙이고 오른쪽에 나머지를 둔다.
// - 주소의 ?id=는 무작위 UUID만 받는다. 이름·전화는 주소·제목(title)·브라우저 저장소에 넣지 않는다.
// - 서버를 부르므로 탭 미리 그리기 prerender 목록에 넣지 않는다. 업무 세션이 꺼져 있으면 손님 자료를 부르지 않는다.
// - 지운 손님은 휴지통으로 간다(7일 보관, 시안 2026-11-22 14:42:41). 이름 넣기 확인은 그대로다.
---

<AdminLayout
  title="손님 카드 | 행복한부동산 관리자"
  description="손님 한 명의 기본 정보·거래 일정·메모를 보고 고치는 관리자 업무 도구입니다."
>
  <div class="work-ui work-doc cu-doc cu-doc--wide cu-detail" data-cu-detail-page>
    <p class="cu-back"><a class="admin-text-link" href="/admin/work/customers/"><span aria-hidden="true">←</span> 손님 목록</a></p>
    <header class="work-doc__header cu-detail__header">
      <span class="work-round-icon work-round-icon--title" data-tone="navy">
        <AdminIcon name="person" size={22} />
      </span>
      <h1 data-cu-name>손님 카드</h1>
      <span data-cu-head-status></span>
    </header>
    <AdminPageHelp page="/admin/work/customers/detail/" />

    <p class="rt-boot cu-boot" role="status" data-cu-boot>손님 카드를 불러오고 있습니다…</p>
    <section class="admin-panel rt-state cu-state" aria-labelledby="cu-state-title" data-cu-state hidden>
      <div class="admin-empty-state">
        <span aria-hidden="true" data-cu-state-symbol>!</span>
        <div>
          <h2 id="cu-state-title" data-cu-state-title></h2>
          <p data-cu-state-body></p>
          <button class="work-secondary-button cu-state__go" type="button" data-cu-state-retry hidden>다시 불러오기</button>
          <a class="work-secondary-button cu-state__go" href="/admin/work/customers/" data-cu-state-list hidden>손님 목록으로</a>
          <a class="admin-text-link" href="/admin/work/" data-cu-state-home hidden>업무 도구 처음으로</a>
        </div>
      </div>
    </section>

    <div class="cu-two" data-cu-main hidden>
      <div class="cu-two__side">
        <section class="cu-block cu-basic" aria-labelledby="cu-basic-title">
          <h2 id="cu-basic-title" class="cu-block__title">기본 정보</h2>
          <div class="cu-actions" data-cu-contact>
            <a class="work-secondary-button cu-act" href="#" data-cu-call><AdminIcon name="phone" size={20} /><span>전화</span></a>
            <a class="work-secondary-button cu-act" href="#" data-cu-sms><AdminIcon name="message" size={20} /><span>문자</span></a>
          </div>
          <dl class="cu-facts">
            <div><dt>전화번호</dt><dd class="cu-num" data-cu-phone></dd></div>
            <div><dt>찾는 조건</dt><dd class="cu-pre" data-cu-needs></dd></div>
            <div><dt>마지막 연락</dt><dd><span data-cu-contact-on></span> <small>(이 손님 메모를 새로 쓰면 오늘로 바뀜)</small></dd></div>
            <div><dt>정리 안내</dt><dd><span data-cu-retention></span> <small>(지워지지 않음. 그날이 지나면 정리할지 묻기만 함)</small></dd></div>
          </dl>
          <div class="cu-actions cu-actions--quiet">
            <button class="admin-text-link cu-linkbtn" type="button" aria-expanded="false" aria-controls="cu-edit-panel" data-cu-edit-open>고치기</button>
            <button class="admin-text-link cu-linkbtn cu-danger" type="button" aria-expanded="false" aria-controls="cu-delete-panel" data-cu-delete-open>손님 지우기</button>
          </div>
          <p class="admin-form-status" role="status" aria-live="polite" data-cu-basic-status></p>

          <section class="cu-form cu-panel" id="cu-edit-panel" aria-labelledby="cu-edit-title" data-cu-edit-panel hidden>
            <h3 id="cu-edit-title" class="cu-panel__title">기본 정보 고치기</h3>
            <WorkCustomerFields idPrefix="cu-edit" />
            <div class="cu-actions">
              <button class="work-primary-button cu-save" type="button" data-cu-edit-save>고친 내용 저장</button>
              <button class="work-secondary-button" type="button" data-cu-edit-cancel>그만두기</button>
            </div>
            <p class="admin-form-status" role="status" aria-live="polite" data-cu-edit-status></p>
            <button class="work-secondary-button" type="button" data-cu-edit-reload hidden>다시 불러오기</button>
          </section>

          <section class="cu-form cu-panel cu-panel--danger" id="cu-delete-panel" aria-labelledby="cu-delete-title" data-cu-delete-panel hidden>
            <h3 id="cu-delete-title" class="cu-panel__title">손님 지우기</h3>
            <p><strong>{TRASH_MOVE_NOTICE}</strong> 이 손님의 메모·사진과, 이 손님만 참여한 거래·일정·할 일이 함께 옮겨집니다. 다른 손님과 함께인 거래는 남깁니다.</p>
            <p>지운 거래에 이은 장부 줄은 매출장부에 남습니다(거래 연결만 끊김, 되살리면 그 줄을 고치지 않았을 때 다시 이음). 거래 제목이 그 줄의 물건 표시로 남아 있을 수 있으니 손님 이름이 들어 있으면 매출장부에서 고쳐 주세요.</p>
            <div class="work-row">
              <label class="work-row__label" for="cu-delete-confirm">확인하려면 손님 이름 <strong data-cu-delete-name></strong>을(를) 그대로 넣으세요</label>
              <div class="work-row__control">
                <input id="cu-delete-confirm" type="text" maxlength="60" autocomplete="off" data-cu-delete-confirm />
              </div>
            </div>
            <div class="cu-actions">
              <button class="work-primary-button cu-save cu-delete-go" type="button" disabled data-cu-delete-go>지우기</button>
              <button class="work-secondary-button" type="button" data-cu-delete-cancel>그만두기</button>
            </div>
            <p class="admin-form-status" role="status" aria-live="polite" data-cu-delete-status></p>
          </section>
        </section>
      </div>

      <div class="cu-two__main">
        <section class="cu-block" aria-labelledby="cu-deals-title">
          <h2 id="cu-deals-title" class="cu-block__title">거래·일정 <span class="cu-block__n" data-cu-deals-count></span></h2>
          <div class="cu-deals" data-cu-deals></div>
          <p class="cu-soft" data-cu-deals-empty hidden>아직 이 손님과 이은 거래가 없습니다.</p>
        </section>

        <section class="cu-block" id="cu-notes" aria-labelledby="cu-notes-title">
          <h2 id="cu-notes-title" class="cu-block__title">메모 <span class="cu-block__n" data-cu-notes-count></span></h2>
          <div class="cu-composer">
            <label class="sr-only" for="cu-memo">이 손님 메모</label>
            <textarea id="cu-memo" rows="3" maxlength={NOTE_BODY_MAX} placeholder="통화·방문 내용을 적습니다" autocomplete="off" data-cu-memo></textarea>
            <div class="cu-composer__foot">
              <small>주민등록번호처럼 보이는 숫자는 저장할 때 가려집니다.</small>
              <button class="work-primary-button cu-save" type="button" data-cu-memo-save>메모 저장</button>
            </div>
            <p class="admin-form-status" role="status" aria-live="polite" data-cu-memo-status></p>
            <button class="work-secondary-button" type="button" data-cu-memo-reload hidden>다시 불러오기</button>
          </div>
          <ol class="cu-notes" data-cu-notes></ol>
          <p class="cu-soft" data-cu-notes-empty hidden>아직 메모가 없습니다.</p>
          <p class="cu-soft" data-cu-notes-limit hidden>최근 50개까지 보입니다.</p>
        </section>

        <section class="cu-block ph-block" id="cu-photos" aria-labelledby="cu-files-title" data-ph-root>
          <h2 id="cu-files-title" class="cu-block__title">사진 <span class="cu-block__n" data-ph-count></span></h2>
          <p class="cu-soft" data-ph-off hidden></p>
          <div class="cu-actions ph-take" data-ph-take hidden>
            <button class="work-primary-button ph-take__btn" type="button" data-ph-camera><AdminIcon name="camera" size={20} /><span>바로 찍기</span></button>
            <button class="work-secondary-button ph-take__btn" type="button" data-ph-album><AdminIcon name="image" size={20} /><span>사진첩에서 고르기</span></button>
          </div>
          <input type="file" accept="image/*" capture="environment" autocomplete="off" tabindex="-1" hidden data-ph-camera-input />
          <input type="file" accept="image/*" multiple autocomplete="off" tabindex="-1" hidden data-ph-album-input />
          <p class="admin-form-status ph-status" role="status" aria-live="polite" data-ph-status hidden></p>

          <section class="cu-form cu-panel ph-panel" aria-labelledby="ph-check-title" data-ph-check hidden>
            <h3 id="ph-check-title" class="cu-panel__title" tabindex="-1"><span data-ph-check-title></span> <span class="cu-block__n" data-ph-check-count></span></h3>
            <figure class="ph-preview" data-ph-preview hidden>
              <div class="ph-preview__box" data-ph-preview-canvas></div>
              <figcaption data-ph-preview-size></figcaption>
            </figure>
            <ol class="ph-picks" data-ph-picks hidden></ol>
            <p class="ph-warn" data-ph-warn><strong>신분증·주민등록증·주민번호가 보이는 서류는 올리지 마세요.</strong> 사진 속 글자는 가려지지 않습니다.</p>
            <div class="ph-kind" data-ph-kind hidden>
              <p class="ph-desc__label" id="ph-kind-label">종류</p>
              <div class="work-segment" role="radiogroup" aria-labelledby="ph-kind-label">
                <label class="work-choice"><input type="radio" name="ph-kind" value="property_photo" autocomplete="off" checked data-ph-kind-input /><span>{PHOTO_KIND_LABELS.property_photo}</span></label>
                <label class="work-choice"><input type="radio" name="ph-kind" value="other" autocomplete="off" data-ph-kind-input /><span>{PHOTO_KIND_LABELS.other}</span></label>
              </div>
            </div>
            <div class="ph-desc" data-ph-desc-row>
              <label class="ph-desc__label" for="ph-desc">설명 <small data-ph-desc-hint>(안 써도 됨)</small></label>
              <textarea id="ph-desc" rows="2" maxlength={PHOTO_CAPTION_MAX} placeholder="예: 거실 창 쪽 누수 자국" autocomplete="off" data-ph-desc></textarea>
              <small class="ph-desc__n" aria-hidden="true" data-ph-desc-n></small>
            </div>
            <p class="ph-note" data-ph-what>위치(GPS)·찍은 기기 정보는 빼고, 긴 변 4096px 안쪽으로 줄여 올립니다.</p>
            <p class="ph-note" data-ph-max hidden>한 번에 {PHOTO_PICK_MAX}장까지 고를 수 있습니다.</p>
            <p data-ph-fail-text hidden></p>
            <div class="cu-actions ph-go-line">
              <button class="work-primary-button cu-save ph-go" type="button" data-ph-go>{PHOTO_GO_LABEL}</button>
              <button class="work-secondary-button" type="button" data-ph-cancel>그만두기</button>
            </div>
            <section class="cu-form cu-panel cu-panel--danger ph-del" aria-labelledby="ph-drop-title" data-ph-drop hidden>
              <h4 id="ph-drop-title" class="cu-panel__title">못 올린 사진을 버릴까요?</h4>
              <p>버리면 그 사진은 없어집니다(휴대폰 사진첩에 없을 수 있음).</p>
              <div class="cu-actions">
                <button class="work-primary-button cu-save cu-delete-go" type="button" data-ph-drop-go>버리기</button>
                <button class="work-secondary-button" type="button" data-ph-drop-cancel>그만두기</button>
              </div>
            </section>
            <p class="admin-form-status" role="status" aria-live="polite" data-ph-check-status></p>
          </section>

          <section class="cu-panel ph-view" aria-labelledby="ph-view-title" data-ph-view hidden>
            <div class="ph-view__head">
              <h3 id="ph-view-title" class="cu-panel__title" tabindex="-1">사진 크게 보기</h3>
              <button class="work-secondary-button ph-close" type="button" data-ph-view-close>닫기</button>
            </div>
            <div class="ph-big">
              <p class="cu-soft ph-big__wait" role="status" data-ph-view-wait></p>
              <img alt="" data-ph-view-img hidden />
            </div>
            <p class="ph-meta" data-ph-view-meta></p>
            <div class="ph-desc">
              <label class="ph-desc__label" for="ph-view-desc">설명</label>
              <textarea id="ph-view-desc" rows="2" maxlength={PHOTO_CAPTION_MAX} autocomplete="off" data-ph-view-desc></textarea>
              <small class="ph-desc__n" aria-hidden="true" data-ph-view-desc-n></small>
            </div>
            <div class="cu-actions"><button class="work-secondary-button ph-save" type="button" data-ph-view-save>설명 저장</button></div>
            <!-- 얼굴 가려서 내보내기(단계 3 M-b, 사용자 결정 2026-11-23 08:55:04 "나안: 화면 전체 (Recommended)"). 원본 내려받기 단추는 두지 않는다(DEC-WT-42). -->
            <div class="ph-mask-entry">
              <button class="work-secondary-button" type="button" aria-haspopup="dialog" disabled data-ph-mask-open>얼굴 가려서 내보내기</button>
              <p class="cu-soft">블로그·문자로 보낼 사진의 얼굴을 가린 사본을 이 기기에만 저장합니다. 앱에 보관한 사진은 바뀌지 않습니다.</p>
            </div>
            <p class="admin-form-status" role="status" aria-live="polite" data-ph-view-status></p>
            <div class="cu-actions cu-actions--quiet">
              <button class="admin-text-link cu-linkbtn cu-danger" type="button" aria-expanded="false" aria-controls="ph-del-panel" data-ph-view-delete>사진 지우기</button>
            </div>
            <section class="cu-form cu-panel cu-panel--danger ph-del" id="ph-del-panel" aria-labelledby="ph-del-title" data-ph-del hidden>
              <h4 id="ph-del-title" class="cu-panel__title">이 사진을 지울까요?</h4>
              <p><strong>{TRASH_MOVE_NOTICE}</strong></p>
              <div class="cu-actions">
                <button class="work-primary-button cu-save cu-delete-go" type="button" data-ph-del-go>지우기</button>
                <button class="work-secondary-button" type="button" data-ph-del-cancel>그만두기</button>
              </div>
              <p class="admin-form-status" role="status" aria-live="polite" data-ph-del-status></p>
            </section>
          </section>

          <!-- 화면 전체 편집 창. 가린 사본은 화면 메모리에서만 만들어 내려받기·공유로만 내보내고 서버로 올리지 않는다(T3-20). -->
          <dialog class="ph-mask" aria-labelledby="ph-mask-title" data-ph-mask>
            <div class="ph-mask__head">
              <h3 id="ph-mask-title">얼굴 가려서 내보내기</h3>
              <button class="work-secondary-button ph-mask__close" type="button" data-ph-mask-close>그만두기</button>
            </div>
            <p class="ph-mask__guide">가릴 얼굴을 마우스나 손가락으로 끌어 네모를 그리세요. 여러 곳을 그릴 수 있습니다. 키보드로는 그릴 수 없습니다.</p>
            <div class="ph-mask__stage">
              <p class="ph-mask__wait" role="status" data-ph-mask-wait>사진을 준비하고 있습니다…</p>
              <canvas aria-label="가릴 곳을 그리는 사진" data-ph-mask-canvas hidden></canvas>
            </div>
            <div class="ph-mask__tools">
              <p class="ph-mask__count" role="status" aria-live="polite" data-ph-mask-count></p>
              <div class="ph-mask__row">
                <button class="work-secondary-button" type="button" disabled data-ph-mask-undo>되돌리기</button>
                <button class="work-secondary-button" type="button" disabled data-ph-mask-redo>다시 하기</button>
                <button class="work-secondary-button" type="button" disabled data-ph-mask-clear>다 지우기</button>
              </div>
              <div class="ph-mask__row">
                <button class="work-primary-button" type="button" disabled data-ph-mask-download>가려서 내려받기</button>
                <button class="work-secondary-button" type="button" disabled hidden data-ph-mask-share>가려서 공유</button>
              </div>
              <p class="admin-form-status" role="status" aria-live="polite" data-ph-mask-status></p>
            </div>
          </dialog>

          <div data-ph-list></div>
          <p class="cu-soft" data-ph-empty hidden>아직 올린 사진이 없습니다.</p>
          <div class="cu-more-line" data-ph-more-line hidden>
            <button class="work-secondary-button cu-more" type="button" data-ph-more>{PHOTO_PAGE_SIZE}장 더 보기</button>
            <p class="admin-form-status" data-ph-shown></p>
          </div>
        </section>
      </div>
    </div>

    <section class="admin-panel rt-state cu-state" aria-labelledby="cu-gone-title" data-cu-gone hidden>
      <div class="admin-empty-state">
        <span aria-hidden="true">✓</span>
        <div>
          <h2 id="cu-gone-title">손님을 휴지통으로 옮겼습니다</h2>
          <p data-cu-gone-text></p>
          <p class="tr-actions-line"><a class="work-secondary-button cu-state__go" href="/admin/work/trash/">휴지통 보기</a><a class="admin-text-link" href="/admin/work/customers/">손님 목록으로</a></p>
        </div>
      </div>
    </section>

    <div class="cu-bar" data-cu-bar hidden>
      <button class="work-primary-button" type="button" data-cu-bar-memo><AdminIcon name="note" size={20} /><span>메모 추가</span></button>
      <button class="work-secondary-button cu-bar__camera" type="button" data-cu-bar-camera hidden><AdminIcon name="camera" size={20} /><span>사진 찍기</span></button>
    </div>
  </div>

  <script>
    import {
      WorkApiError,
      createNote,
      deleteCustomer,
      getCustomerSession,
      readCustomer,
      updateCustomer,
      type CustomerDetail,
    } from "../../../../lib/work-customers-client";
    import { element, fillFields, noteItem, readFields, setStatus, showFieldErrors, statusBadge } from "../../../../lib/work-customers-dom";
    import { createLedgerEntry, listLedger, readDeal, type DealSummary, type LedgerEntry } from "../../../../lib/work-ledger-client";
    import { mountPhotoSection } from "../../../../lib/work-photo-section";
    import { dealLedgerItem } from "../../../../lib/work-ledger-dom";
    import legalRules from "../../../../data/work/legal-rules.json";
    import { todayInKorea } from "../../../../lib/work/legal-dates.mjs";
    import { LEDGER_LABEL_MAX, LEDGER_PAGE_SIZE, checkLedgerInput, dealFeeCap, ledgerErrorText, ledgerListQuery, numberText, payerSides, wonText } from "../../../../lib/work/ledger-view.mjs";
    import {
      DEAL_STATUS_LABELS,
      DEAL_TYPE_LABELS,
      PARTY_ROLE_LABELS,
      agoText,
      checkCustomerInput,
      checkNoteBody,
      customerChanges,
      customerErrorText,
      customerSaveErrorText,
      customerIdFromSearch,
      dateText,
      deleteResultText,
      dueText,
      isCleanupDue,
      isRetryable,
      phoneText,
    } from "../../../../lib/work/customers-view.mjs";

    const root = document.querySelector<HTMLElement>("[data-cu-detail-page]");
    if (root) {
      const pick = <T extends HTMLElement>(selector: string) => {
        const found = root.querySelector<T>(selector);
        if (!found) throw new Error(`손님 카드 화면 칸이 없습니다: ${selector}`);
        return found;
      };
      const labelOf = (table: Record<string, string>, key: string) => table[key] ?? key;
      const boot = pick("[data-cu-boot]");
      const statePanel = pick("[data-cu-state]");
      const main = pick("[data-cu-main]");
      const gone = pick("[data-cu-gone]");
      const bar = pick("[data-cu-bar]");
      const nameHeading = pick("[data-cu-name]");
      const headStatus = pick("[data-cu-head-status]");
      const call = pick<HTMLAnchorElement>("[data-cu-call]");
      const sms = pick<HTMLAnchorElement>("[data-cu-sms]");
      const basicStatus = pick("[data-cu-basic-status]");
      const editOpen = pick<HTMLButtonElement>("[data-cu-edit-open]");
      const editPanel = pick("[data-cu-edit-panel]");
      const editSave = pick<HTMLButtonElement>("[data-cu-edit-save]");
      const editStatus = pick("[data-cu-edit-status]");
      const editReload = pick<HTMLButtonElement>("[data-cu-edit-reload]");
      const deleteOpen = pick<HTMLButtonElement>("[data-cu-delete-open]");
      const deletePanel = pick("[data-cu-delete-panel]");
      const deleteConfirm = pick<HTMLInputElement>("[data-cu-delete-confirm]");
      const deleteGo = pick<HTMLButtonElement>("[data-cu-delete-go]");
      const deleteStatus = pick("[data-cu-delete-status]");
      const memo = pick<HTMLTextAreaElement>("[data-cu-memo]");
      const memoSave = pick<HTMLButtonElement>("[data-cu-memo-save]");
      const memoStatus = pick("[data-cu-memo-status]");
      const memoReload = pick<HTMLButtonElement>("[data-cu-memo-reload]");

      let id: string | null = null;
      let detail: CustomerDetail | null = null;
      let busy = false;
      let today = todayInKorea();
      const errorCode = (error: unknown) => (error instanceof WorkApiError ? error.code : null);

      function showState(title: string, body: string, { symbol = "!", retry = false, list = false, home = false } = {}) {
        boot.hidden = true;
        main.hidden = true;
        bar.hidden = true;
        pick("[data-cu-state-symbol]").textContent = symbol;
        pick("[data-cu-state-title]").textContent = title;
        pick("[data-cu-state-body]").textContent = body;
        pick("[data-cu-state-retry]").hidden = !retry;
        pick("[data-cu-state-list]").hidden = !list;
        pick("[data-cu-state-home]").hidden = !home;
        statePanel.hidden = false;
      }
      const showDisabled = () => showState(
        "손님 자료 저장이 아직 켜지지 않았습니다",
        "손님 이름·전화·메모를 서버에 저장하는 기능은 운영자가 켜야 쓸 수 있습니다. 켜기 전에는 아무것도 저장하지 않습니다.",
        { symbol: "–", home: true },
      );
      const showMissing = () => showState("이 손님을 찾지 못했습니다", "다른 화면에서 지웠거나 주소가 잘못되었을 수 있습니다.", { symbol: "?", list: true });
      function showLoadError(error: unknown) {
        const code = errorCode(error);
        if (code === "WORK_DISABLED") showDisabled();
        else if (code === "NOT_FOUND") showMissing();
        else showState("손님 카드를 불러오지 못했습니다", customerErrorText(code), { retry: isRetryable(code) });
      }

      function renderBasic() {
        if (!detail) return;
        const { customer } = detail;
        nameHeading.textContent = customer.displayName;
        headStatus.replaceChildren(statusBadge(customer.status));
        const hasPhone = Boolean(customer.phoneDigits);
        pick("[data-cu-contact]").hidden = !hasPhone;
        if (hasPhone) {
          call.href = `tel:${customer.phoneDigits}`;
          sms.href = `sms:${customer.phoneDigits}`;
        }
        pick("[data-cu-phone]").textContent = hasPhone ? phoneText(customer.phoneDigits) : "없음";
        pick("[data-cu-needs]").textContent = customer.needs || "아직 적지 않았습니다.";
        pick("[data-cu-contact-on]").textContent = customer.lastContactOn ? `${dateText(customer.lastContactOn, today)} · ${agoText(customer.lastContactOn, today)}` : "기록 없음";
        const retention = pick("[data-cu-retention]");
        retention.replaceChildren(document.createTextNode(customer.retentionUntil ? `${dateText(customer.retentionUntil, today)}부터` : "없음"));
        if (isCleanupDue(customer, today)) retention.append(" ", element("span", "admin-badge admin-badge--warning cu-cleanup", "정리할 때 지남"));
        pick("[data-cu-delete-name]").textContent = `'${customer.displayName}'`;
      }

      function renderDeals() {
        if (!detail) return;
        const box = pick("[data-cu-deals]");
        // 같은 거래에 역할이 둘이면 서버가 역할마다 한 줄씩 준다. 화면에는 거래 하나로 모으고 역할을 이어 쓴다.
        const deals = new Map<string, { deal: CustomerDetail["deals"][number]; roles: string[] }>();
        for (const deal of detail.deals) {
          const entry = deals.get(deal.id);
          if (entry) entry.roles.push(labelOf(PARTY_ROLE_LABELS, deal.role));
          else deals.set(deal.id, { deal, roles: [labelOf(PARTY_ROLE_LABELS, deal.role)] });
        }
        box.replaceChildren(...[...deals.values()].map(({ deal, roles }) => {
          const article = element("article", "cu-deal");
          article.append(element("h3", "cu-deal__title", deal.title));
          const meta = element("p", "cu-deal__meta", `${labelOf(DEAL_TYPE_LABELS, deal.dealType)} · ${roles.join("·")} · `);
          meta.append(element("span", "cu-deal__status", labelOf(DEAL_STATUS_LABELS, deal.status)));
          article.append(meta);
          if (deal.events.length === 0) {
            article.append(element("p", "cu-soft", "아직 일정이 없습니다."));
          } else {
            const list = element("ul", "cu-events");
            for (const event of deal.events) {
              const row = element("li", `cu-event${event.doneAt ? " is-done" : ""}`);
              row.append(
                element("span", "cu-event__date", dateText(event.dueOn, today)),
                element("span", "cu-event__title", event.title),
                element("span", "cu-event__left", event.doneAt ? "✓ 끝남" : dueText(event.dueOn, today)),
              );
              list.append(row);
            }
            article.append(list);
          }
          article.append(ledgerBlock(deal.id, deal.title));
          return article;
        }));
        pick("[data-cu-deals-count]").textContent = `${deals.size}건`;
        pick("[data-cu-deals-empty]").hidden = deals.size > 0;
      }

      // ── 거래의 장부 칸(매출장부, 설계서 6.12절) ──
      // 거래 금액·종류·계약일과 참여 손님은 손님 카드 응답에 없으므로, '장부 보기'를 눌렀을 때만 거래 하나(GET /work/deals/:id)와
      // 그 거래의 장부 줄(GET /work/ledger?dealId=)을 읽는다. 손님 카드를 다시 그려도 열어 둔 장부 칸은 다시 연다.
      const openLedgers = new Set<string>();
      function ledgerBlock(dealId: string, dealTitle: string) {
        const box = element("div", "lg-deal-ledger");
        const panelId = `cu-ledger-${dealId}`;
        const toggle = element("button", "work-secondary-button", "장부 보기");
        toggle.type = "button";
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-controls", panelId);
        toggle.dataset.cuLedgerToggle = dealId;
        const panel = element("div");
        panel.id = panelId;
        panel.hidden = true;
        panel.dataset.cuLedger = dealId;
        box.append(toggle, panel);
        let loaded = false;

        async function load(savedText = "") {
          const status = element("p", "admin-form-status", "장부를 불러오고 있습니다…");
          status.setAttribute("role", "status");
          panel.replaceChildren(status);
          try {
            const [dealDetail, page] = await Promise.all([
              readDeal(dealId),
              listLedger(ledgerListQuery({ dealId, all: true, limit: LEDGER_PAGE_SIZE })),
            ]);
            loaded = true;
            render(dealDetail.deal, dealDetail.parties.map((party) => party.role), page.items, Boolean(page.nextCursor), savedText);
          } catch (error) {
            const code = errorCode(error);
            setStatus(status, `장부를 불러오지 못했습니다. ${ledgerErrorText(code, customerErrorText(code))}`, "error");
            if (isRetryable(code)) {
              const retry = element("button", "work-secondary-button", "다시 불러오기");
              retry.type = "button";
              retry.addEventListener("click", () => void load(savedText));
              panel.append(retry);
            }
          }
        }

        function render(deal: DealSummary, roles: string[], entries: LedgerEntry[], more: boolean, savedText: string) {
          const year = today.slice(0, 4);
          const unpaid = entries.reduce((sum, entry) => sum + (entry.kind === "expense" ? 0 : Number(entry.unpaidWon ?? 0)), 0);
          const head = element("h4", "", "장부 ");
          head.append(element("span", "cu-block__n", entries.length === 0 ? "아직 없음" : `${entries.length}줄${more ? " 이상" : ""} · 미입금 ${wonText(unpaid)}`));
          const parts: HTMLElement[] = [head];
          if (entries.length > 0) {
            const list = element("ul");
            list.append(...entries.map((entry) => dealLedgerItem(entry, year)));
            parts.push(list);
          } else {
            parts.push(element("p", "cu-soft", "이 거래에 이은 장부 줄이 없습니다."));
          }
          const actions = element("div", "cu-actions");
          const make = element("button", "work-secondary-button", "보수 줄 만들기");
          make.type = "button";
          make.setAttribute("aria-expanded", "false");
          const go = element("a", "admin-text-link", "매출장부에서 보기");
          go.href = "/admin/work/ledger/";
          actions.append(make, go);
          const saved = element("p", "admin-form-status");
          saved.setAttribute("role", "status");
          saved.setAttribute("aria-live", "polite");
          setStatus(saved, savedText, savedText.startsWith("✓") ? "success" : savedText ? "error" : "idle");
          const form = feeForm(deal, roles, (text) => {
            loaded = false;
            void load(text).then(() => toggle.focus());
          }, () => {
            form.hidden = true;
            make.setAttribute("aria-expanded", "false");
            make.focus();
          });
          form.hidden = true;
          make.addEventListener("click", () => {
            const next = Boolean(form.hidden);
            form.hidden = !next;
            make.setAttribute("aria-expanded", String(next));
            if (next) form.querySelector<HTMLInputElement>("input")?.focus();
          });
          parts.push(actions, saved, form);
          panel.replaceChildren(...parts);
        }

        // 보수 줄 만들기: 거래의 두 쪽 중 손님으로 붙은 쪽을 미리 고르고(둘 다면 쌍방), 고른 쪽마다 장부 줄 하나를 만든다.
        // 법정 상한은 주택 거래만 채운다(dealFeeCap). 물건 표시는 거래 제목으로 넣는다.
        function feeForm(deal: DealSummary, roles: string[], done: (text: string) => void, cancel: () => void) {
          const form = element("section", "lg-pair");
          form.setAttribute("aria-label", "보수 줄 만들기");
          const capInfo = dealFeeCap(deal, legalRules);
          const capNote = element("p", "lg-cap", capInfo.ok ? `${capInfo.text} (${capInfo.detail}). 고른 쪽마다 이 값으로 채웠습니다. 실제 받은 금액으로 고친 뒤 저장해 주세요.` : capInfo.reason);
          capNote.setAttribute("role", "note");
          const pickRow = element("div", "work-segment");
          pickRow.setAttribute("role", "group");
          pickRow.setAttribute("aria-label", "낸 쪽");
          const fields = [
            ["amount", "공급가액(원)", "text", capInfo.ok ? numberText(capInfo.maxFeeWon) : ""],
            ["vat", "부가세(원)", "text", capInfo.ok ? numberText(capInfo.vatWon) : ""],
            ["received", "입금액(원)", "text", "0"],
            ["receivedOn", "입금일", "date", ""],
          ] as const;
          const boxes = payerSides(deal.dealType, roles).map((side) => {
            const base = `cu-lg-${dealId}-${side.role}`;
            const choice = element("label", "work-choice");
            const check = element("input");
            check.type = "checkbox";
            check.autocomplete = "off";
            check.checked = side.checked;
            check.value = side.role;
            choice.append(check, element("span", "", side.label));
            pickRow.append(choice);
            const one = element("div", "lg-pair__one");
            one.hidden = !side.checked;
            one.append(element("h5", "", side.label));
            const money = element("div", "lg-money");
            const inputs: Record<string, HTMLInputElement> = {};
            const errors: Record<string, HTMLElement> = {};
            for (const [name, label, type, value] of fields) {
              const row = element("div", "work-row");
              const labelNode = element("label", "work-row__label", label);
              labelNode.htmlFor = `${base}-${name}`;
              const control = element("div", "work-row__control");
              const input = element("input");
              input.id = `${base}-${name}`;
              input.type = type;
              input.autocomplete = "off";
              if (type === "text") input.inputMode = "numeric";
              input.value = value;
              const error = element("small", "cu-error");
              error.id = `${base}-${name}-error`;
              input.setAttribute("aria-describedby", error.id);
              control.append(input, error);
              row.append(labelNode, control);
              money.append(row);
              inputs[name] = input;
              errors[name] = error;
            }
            one.append(money);
            return { role: side.role, check, one, inputs, errors };
          });
          const status = element("p", "admin-form-status");
          status.setAttribute("role", "status");
          status.setAttribute("aria-live", "polite");
          const actions = element("div", "cu-actions");
          const save = element("button", "work-primary-button cu-save");
          save.type = "button";
          const stop = element("button", "work-secondary-button", "그만두기");
          stop.type = "button";
          stop.addEventListener("click", cancel);
          actions.append(save, stop);
          const chosen = () => boxes.filter((box) => box.check.checked);
          const syncSave = () => {
            save.textContent = `보수 줄 ${chosen().length}개 저장`;
            save.disabled = chosen().length === 0;
          };
          for (const box of boxes) box.check.addEventListener("change", () => {
            box.one.hidden = !box.check.checked;
            syncSave();
          });
          syncSave();
          save.addEventListener("click", async () => {
            if (busy) return;
            const bodies: Record<string, unknown>[] = [];
            let firstBad: HTMLInputElement | null = null;
            for (const box of chosen()) {
              const checked = checkLedgerInput({
                amount: box.inputs.amount.value,
                vat: box.inputs.vat.value,
                received: box.inputs.received.value,
                receivedOn: box.inputs.receivedOn.value,
              }, { kind: "fee", hasDeal: true });
              for (const [name, error] of Object.entries(box.errors)) {
                const text = checked.ok ? "" : checked.errors[name] ?? "";
                error.textContent = text;
                if (text) box.inputs[name].setAttribute("aria-invalid", "true");
                else box.inputs[name].removeAttribute("aria-invalid");
                if (text && !firstBad) firstBad = box.inputs[name];
              }
              if (checked.ok) bodies.push({ ...checked.value, kind: "fee", dealId, payerRole: box.role, label: dealTitle.slice(0, LEDGER_LABEL_MAX) });
            }
            if (firstBad) {
              setStatus(status, "빨간 글자가 있는 칸을 고쳐 주세요.", "error");
              (firstBad as HTMLInputElement).focus();
              return;
            }
            busy = true;
            save.disabled = true;
            setStatus(status, "저장하고 있습니다…", "saving");
            let made = 0;
            let warned = false;
            try {
              for (const body of bodies) {
                const result = await createLedgerEntry(body);
                made += 1;
                if (result.warnings.length > 0) warned = true;
              }
              done(`✓ 보수 줄 ${made}개를 저장했습니다.${warned ? " 굵은 경고를 확인하세요(저장은 그대로 됩니다)." : ""}`);
            } catch (error) {
              const code = errorCode(error);
              const reason = ledgerErrorText(code, customerSaveErrorText(code, error));
              // 한 줄이라도 저장됐으면 목록을 다시 읽어 실제 저장된 줄을 보인다(같은 줄을 두 번 만들지 않게).
              if (made > 0) done(`보수 줄 ${made}개만 저장했습니다. 나머지는 저장하지 못했습니다. ${reason}`);
              else setStatus(status, `저장하지 못했습니다. ${reason}`, "error");
            } finally {
              busy = false;
              syncSave();
            }
          });
          form.append(capNote, pickRow, ...boxes.map((box) => box.one), status, actions);
          return form;
        }

        const open = (next: boolean) => {
          panel.hidden = !next;
          toggle.setAttribute("aria-expanded", String(next));
          toggle.textContent = next ? "장부 접기" : "장부 보기";
          if (next) openLedgers.add(dealId);
          else openLedgers.delete(dealId);
          if (next && !loaded) void load();
        };
        toggle.addEventListener("click", () => open(Boolean(panel.hidden)));
        if (openLedgers.has(dealId)) open(true);
        return box;
      }

      function renderNotes() {
        if (!detail) return;
        pick("[data-cu-notes]").replaceChildren(...detail.notes.map((note) => noteItem(note, today)));
        pick("[data-cu-notes-count]").textContent = `${detail.notes.length}개`;
        pick("[data-cu-notes-empty]").hidden = detail.notes.length > 0;
        pick("[data-cu-notes-limit]").hidden = detail.notes.length < 50;
      }

      // 사진 칸(바로 찍기). 손님 카드를 다시 읽으면 목록만 다시 그리고, 올리는 중·확인 중인 사진은 그대로 둔다.
      const photos = mountPhotoSection(pick("[data-ph-root]"), { customerId: () => id, reload: () => load() });
      const barCamera = pick<HTMLButtonElement>("[data-cu-bar-camera]");
      function renderFiles(filesEnabled: boolean) {
        if (!detail) return;
        photos.render(detail.files, filesEnabled);
        barCamera.hidden = !filesEnabled;
      }

      let filesEnabled = false;
      async function load() {
        if (!id) return;
        detail = await readCustomer(id);
        renderBasic();
        renderDeals();
        renderNotes();
        renderFiles(filesEnabled);
      }

      // ── 고치기 ──
      function openEdit(open: boolean) {
        editPanel.hidden = !open;
        editOpen.setAttribute("aria-expanded", String(open));
        editReload.hidden = true;
        if (open) {
          openDelete(false);
          fillFields(editPanel, detail?.customer ?? null);
          setStatus(editStatus, "", "idle");
          editPanel.querySelector<HTMLInputElement>('[data-cu-field="displayName"]')?.focus();
        }
      }
      editOpen.addEventListener("click", () => openEdit(Boolean(editPanel.hidden)));
      pick("[data-cu-edit-cancel]").addEventListener("click", () => {
        openEdit(false);
        editOpen.focus();
      });
      editSave.addEventListener("click", async () => {
        if (busy || !detail || !id) return;
        const checked = checkCustomerInput(readFields(editPanel));
        if (!checked.ok) {
          showFieldErrors(editPanel, checked.errors);
          setStatus(editStatus, "빨간 글자가 있는 칸을 고쳐 주세요.", "error");
          return;
        }
        showFieldErrors(editPanel, {});
        const changes = customerChanges(detail.customer, checked.value);
        if (!changes) {
          setStatus(editStatus, "바뀐 것이 없습니다.", "idle");
          return;
        }
        busy = true;
        editSave.disabled = true;
        setStatus(editStatus, "저장하고 있습니다…", "saving");
        try {
          const { customer } = await updateCustomer(id, { version: detail.customer.version, ...changes });
          detail = { ...detail, customer };
          renderBasic();
          openEdit(false);
          setStatus(basicStatus, "✓ 고친 내용을 저장했습니다.", "success");
          editOpen.focus();
        } catch (error) {
          const code = errorCode(error);
          setStatus(editStatus, `저장하지 못했습니다. ${customerSaveErrorText(code, error)}`, "error");
          editReload.hidden = code !== "VERSION_CONFLICT";
        } finally {
          busy = false;
          editSave.disabled = false;
        }
      });
      // 다른 화면이 먼저 고쳤을 때: 넣던 값은 버리고 새 내용으로 다시 채운다.
      editReload.addEventListener("click", async () => {
        if (busy) return;
        busy = true;
        try {
          await load();
          openEdit(true);
          setStatus(editStatus, "새 내용을 불러왔습니다. 다시 고친 뒤 저장해 주세요.", "idle");
        } catch (error) {
          showLoadError(error);
        } finally {
          busy = false;
        }
      });

      // ── 지우기(이름 다시 입력) ──
      function openDelete(open: boolean) {
        deletePanel.hidden = !open;
        deleteOpen.setAttribute("aria-expanded", String(open));
        deleteConfirm.value = "";
        deleteGo.disabled = true;
        setStatus(deleteStatus, "", "idle");
        if (open) {
          openEdit(false);
          deleteConfirm.focus();
        }
      }
      deleteOpen.addEventListener("click", () => openDelete(Boolean(deletePanel.hidden)));
      pick("[data-cu-delete-cancel]").addEventListener("click", () => {
        openDelete(false);
        deleteOpen.focus();
      });
      deleteConfirm.addEventListener("input", () => {
        deleteGo.disabled = !detail || deleteConfirm.value.trim() !== detail.customer.displayName;
      });
      deleteGo.addEventListener("click", async () => {
        if (busy || !detail || !id) return;
        busy = true;
        deleteGo.disabled = true;
        setStatus(deleteStatus, "지우고 있습니다…", "saving");
        try {
          const result = await deleteCustomer(id, deleteConfirm.value.trim());
          detail = null;
          main.hidden = true;
          bar.hidden = true;
          nameHeading.textContent = "손님 카드";
          headStatus.replaceChildren();
          pick("[data-cu-gone-text]").textContent = deleteResultText(result);
          gone.hidden = false;
          gone.querySelector<HTMLAnchorElement>("a")?.focus();
        } catch (error) {
          setStatus(deleteStatus, `지우지 못했습니다. ${customerSaveErrorText(errorCode(error), error)}`, "error");
          deleteGo.disabled = false;
        } finally {
          busy = false;
        }
      });

      // ── 메모 ──
      memoSave.addEventListener("click", async () => {
        if (busy || !id) return;
        const checked = checkNoteBody(memo.value);
        if (!checked.ok) {
          setStatus(memoStatus, checked.error, "error");
          memo.focus();
          return;
        }
        busy = true;
        memoSave.disabled = true;
        memoReload.hidden = true;
        setStatus(memoStatus, "저장하고 있습니다…", "saving");
        try {
          await createNote({ body: checked.value, customerId: id });
        } catch (error) {
          setStatus(memoStatus, `저장하지 못했습니다. ${customerSaveErrorText(errorCode(error), error)}`, "error");
          busy = false;
          memoSave.disabled = false;
          return;
        }
        // 여기부터는 저장이 끝난 뒤다. 다시 읽기가 실패해도 '저장하지 못했습니다'로 알리지 않는다(다시 누르면 메모가 두 번 들어감).
        memo.value = "";
        try {
          // 메모를 쓰면 서버가 마지막 연락일을 오늘로 바꾸므로 카드를 다시 읽는다.
          await load();
          setStatus(memoStatus, "✓ 메모를 저장했습니다.", "success");
        } catch {
          setStatus(memoStatus, "✓ 메모는 저장했습니다. 다만 손님 카드를 새로 읽지 못해 아래 메모 목록에는 아직 없습니다. '다시 불러오기'를 눌러 주세요.", "error");
          memoReload.hidden = false;
        } finally {
          busy = false;
          memoSave.disabled = false;
        }
      });
      // 메모 저장 뒤 다시 읽기만 실패했을 때: 손님 카드만 다시 읽는다(메모는 다시 보내지 않음).
      memoReload.addEventListener("click", async () => {
        if (busy) return;
        busy = true;
        try {
          await load();
          memoReload.hidden = true;
          setStatus(memoStatus, "✓ 손님 카드를 새로 읽었습니다.", "success");
        } catch (error) {
          showLoadError(error);
        } finally {
          busy = false;
        }
      });
      pick("[data-cu-bar-memo]").addEventListener("click", () => {
        memo.scrollIntoView({ block: "center" });
        memo.focus({ preventScroll: true });
      });
      // 하단 막대 '사진 찍기': 누른 그 자리에서 카메라를 연다(찍은 뒤 사진 칸의 확인 칸으로 감).
      barCamera.addEventListener("click", () => photos.openCamera());

      // 저장하지 않은 메모·고치기 칸, 아직 올리지 못한 사진이 있으면 떠나기 전에 묻는다.
      window.addEventListener("beforeunload", (event) => {
        const editing = !editPanel.hidden;
        if (!memo.value.trim() && !editing && !photos.hasPending()) return;
        event.preventDefault();
      });

      // ── 처음 불러오기: 주소 ID → 업무 세션(켜짐) → 손님 카드 ──
      async function start() {
        statePanel.hidden = true;
        main.hidden = true;
        gone.hidden = true;
        bar.hidden = true;
        boot.hidden = false;
        today = todayInKorea();
        id = customerIdFromSearch(location.search);
        if (!id) {
          showMissing();
          return;
        }
        try {
          const session = await getCustomerSession({ refresh: true });
          if (!session.enabled) {
            showDisabled();
            return;
          }
          filesEnabled = session.filesEnabled;
          await load();
        } catch (error) {
          showLoadError(error);
          return;
        }
        boot.hidden = true;
        main.hidden = false;
        bar.hidden = false;
      }
      pick("[data-cu-state-retry]").addEventListener("click", () => void start());

      // 열 때마다(뒤로 가기 캐시 복원 포함) 넣던 메모·고치기·지우기 칸을 비우고 다시 불러온다.
      const reset = () => {
        detail = null;
        memo.value = "";
        setStatus(memoStatus, "", "idle");
        memoReload.hidden = true;
        setStatus(basicStatus, "", "idle");
        openEdit(false);
        openDelete(false);
        photos.reset();
        barCamera.hidden = true;
        nameHeading.textContent = "손님 카드";
        headStatus.replaceChildren();
        void start();
      };
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) reset();
      });
      reset();
    }
  </script>
</AdminLayout>
