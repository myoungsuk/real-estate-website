---
import AdminIcon from "../../../../components/admin/AdminIcon.astro";
import AdminPageHelp from "../../../../components/admin/AdminPageHelp.astro";
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { PROMO_IDS_MAX, PROMO_PLACES } from "../../../../lib/work/realprice-promo.mjs";

// 단계 P 실거래가 홍보물(P1-e, 운영자 시안 승인 2026-11-20 10:43:09: 카드 A안, 4 ~ 6건은 3건씩 최대 2장, 해시태그·카카오톡은 권하는 대로).
// P1-f D안(운영자 결정 2026-11-20 13:36:35 "이번에 같이"): 담은 거래 요약 → "어디에 올릴까요?" → ① 그림 저장 ② 글 복사 ③ 그 앱에서 붙여 넣기.
// 글 미리 보기·카드 그림 크게 보기는 접어 두고, 맨 아래에 A4 인쇄. 글·그림은 브라우저에서만 만들고 서버에 저장하지 않는다.
const listHref = "/admin/work/realprice/";
---

<AdminLayout
  title="홍보물 만들기 | 행복한부동산 관리자"
  description="담은 실거래로 인스타그램·스레드·블로그·카카오톡에 올릴 카드 그림과 글, A4 인쇄 한 장을 만드는 관리자 업무 도구입니다."
>
  <div class="work-ui work-doc rt-doc rt-promo" data-promo-page>
    <header class="work-doc__header">
      <span class="work-round-icon work-round-icon--title" data-tone="navy">
        <AdminIcon name="chart" size={22} />
      </span>
      <h1>홍보물 만들기</h1>
      <span class="admin-stage-badge">국토교통부 공개 자료</span>
    </header>

    <p class="work-doc__lead rt-promo__lead">담은 실거래(최대 {PROMO_IDS_MAX}건)로 올릴 그림과 글을 만듭니다. 숫자는 받은 자료 그대로이고 출처·받은 시각·사무소 명시사항이 자동으로 붙습니다.</p>

    <AdminPageHelp page="/admin/work/realprice/promo/" />

    <p class="rt-boot" role="status" data-promo-boot>담은 거래를 불러오고 있습니다…</p>

    <section class="admin-panel rt-state" aria-labelledby="promo-state-title" data-promo-state hidden>
      <div class="admin-empty-state">
        <span aria-hidden="true" data-promo-state-symbol>!</span>
        <div>
          <h2 id="promo-state-title" data-promo-state-title></h2>
          <p data-promo-state-body></p>
          <p class="rt-state__links">
            <button class="admin-secondary-button rt-state__action" type="button" data-promo-retry hidden>다시 불러오기</button>
            <a class="admin-text-link" href={listHref}>실거래가 목록으로 <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </div>
    </section>

    <p class="admin-inline-notice rt-notice rt-promo__notice" role="status" data-promo-notice hidden><span aria-hidden="true">i</span><span data-promo-notice-text></span></p>

    <div class="rt-promo__main" data-promo-main hidden>
      <section class="rt-picked" aria-labelledby="promo-picked-title">
        <h2 id="promo-picked-title">담은 거래 <span data-promo-picked-count></span></h2>
        <ul class="rt-picked__list" data-promo-picked></ul>
        <a class="rt-picked__back" href={listHref}><span aria-hidden="true">←</span> 거래 다시 고르기</a>
      </section>

      <section class="admin-panel rt-where" aria-labelledby="promo-where-title">
        <h2 id="promo-where-title">어디에 올릴까요?</h2>
        <div class="rt-where__grid" role="radiogroup" aria-labelledby="promo-where-title">
          {PROMO_PLACES.map(([value, label], index) => (
            <label class="rt-where__choice">
              <input type="radio" name="promo-kind" value={value} checked={index === 0} autocomplete="off" />
              <span>{label}</span>
            </label>
          ))}
        </div>

        <ol class="rt-steps">
          <li class="rt-step">
            <span class="rt-step__no" aria-hidden="true">1</span>
            <div class="rt-step__body">
              <p data-promo-step-image>카드 그림을 휴대폰에 저장합니다.</p>
              <p class="rt-loading" role="status" data-promo-card-loading>카드 그림을 그리고 있습니다…</p>
              <div class="rt-step__downloads" data-promo-downloads></div>
              <p class="rt-promo__warn" data-promo-card-warn hidden>글이 길어 그림 아래 칸과 겹칠 수 있습니다. '카드 그림 크게 보기'에서 확인해 주세요.</p>
            </div>
          </li>
          <li class="rt-step">
            <span class="rt-step__no" aria-hidden="true">2</span>
            <div class="rt-step__body">
              <p data-promo-step-text>글을 복사합니다.</p>
              <button class="work-primary-button rt-step__button" type="button" data-promo-copy>글 복사</button>
              <p class="admin-form-status" role="status" aria-live="polite" data-promo-status></p>
            </div>
          </li>
          <li class="rt-step">
            <span class="rt-step__no" aria-hidden="true">3</span>
            <div class="rt-step__body">
              <p data-promo-step-post></p>
            </div>
          </li>
        </ol>

        <details class="rt-promo__fold" data-promo-text-fold>
          <summary>글 미리 보기</summary>
          <label class="work-output__label" for="promo-preview" data-promo-preview-label>인스타그램 글</label>
          <textarea id="promo-preview" class="work-preview rt-promo__preview" rows="14" readonly data-promo-preview></textarea>
          <small class="work-output__count" aria-live="polite" data-promo-count></small>
        </details>
        <details class="rt-promo__fold">
          <summary>카드 그림 크게 보기 <span data-promo-card-count></span></summary>
          <p class="work-help">1080×1350 PNG(인스타그램 세로 피드 크기)입니다. 4건 이상은 3건씩 두 장으로 나눕니다.</p>
          <div class="rt-promo__card-list" data-promo-card-list></div>
        </details>

        <div class="rt-promo__print">
          <button class="admin-secondary-button" type="button" data-promo-print disabled>종이로 뽑기(A4)</button>
          <p class="work-help">카드 그림만 A4 한 장에 나옵니다. PDF가 필요하면 인쇄 창에서 'PDF로 저장'을 고르세요.</p>
        </div>
      </section>
    </div>

    <div class="rt-print-sheet" data-promo-sheet></div>
  </div>

  <script>
    import office from "../../../../data/office.json";
    import { getWorkSession, readWork, WorkApiError } from "../../../../lib/work-realprice-client";
    import { renderPromoCard, type PromoCard } from "../../../../lib/work-realprice-card";
    import { todayInKorea } from "../../../../lib/work/legal-dates.mjs";
    import {
      PROMO_PLACES,
      parsePromoIds,
      priceText,
      promoBlockReason,
      promoCards,
      promoFileName,
      promoSelection,
      promoSteps,
      promoTexts,
      textCount,
    } from "../../../../lib/work/realprice-promo.mjs";
    import { apiErrorText, kindLabel } from "../../../../lib/work/realprice-view.mjs";

    type Kind = "threads" | "instagram" | "blog" | "kakao";
    interface PromoItem {
      tradeKey: string;
      kind: "sale" | "rent" | "presale";
      aptName: string | null;
      cancelled: boolean;
      recordHigh: boolean | null;
      priceWon: number | null;
      depositWon: number | null;
      monthlyRentWon: number | null;
    }
    interface IdsResponse {
      items: PromoItem[];
      missing: string[];
      receivedAt: string | null;
      recordHighReady: boolean;
      warnings: { code: string; level?: string }[];
    }

    const root = document.querySelector<HTMLElement>("[data-promo-page]");
    if (root) {
      const pick = <T extends Element = HTMLElement>(selector: string) => root.querySelector<T>(selector) as T;
      const boot = pick("[data-promo-boot]");
      const statePanel = pick("[data-promo-state]");
      const retry = pick<HTMLButtonElement>("[data-promo-retry]");
      const notice = pick("[data-promo-notice]");
      const main = pick("[data-promo-main]");
      const pickedList = pick("[data-promo-picked]");
      const pickedCount = pick("[data-promo-picked-count]");
      const cardList = pick("[data-promo-card-list]");
      const cardLoading = pick("[data-promo-card-loading]");
      const cardCount = pick("[data-promo-card-count]");
      const cardWarn = pick("[data-promo-card-warn]");
      const downloads = pick("[data-promo-downloads]");
      const stepImage = pick("[data-promo-step-image]");
      const stepText = pick("[data-promo-step-text]");
      const stepPost = pick("[data-promo-step-post]");
      const textFold = pick<HTMLDetailsElement>("[data-promo-text-fold]");
      const previewLabel = pick("[data-promo-preview-label]");
      const preview = pick<HTMLTextAreaElement>("[data-promo-preview]");
      const count = pick("[data-promo-count]");
      const copyButton = pick<HTMLButtonElement>("[data-promo-copy]");
      const status = pick("[data-promo-status]");
      const printButton = pick<HTMLButtonElement>("[data-promo-print]");
      const sheet = pick("[data-promo-sheet]");
      const kindNames = Object.fromEntries(PROMO_PLACES) as Record<Kind, string>;
      let texts: Record<Kind, string> | null = null;
      let cardTotal = 1;

      function showState(title: string, body: string, { symbol = "!", canRetry = false } = {}) {
        boot.hidden = true;
        main.hidden = true;
        pick("[data-promo-state-symbol]").textContent = symbol;
        pick("[data-promo-state-title]").textContent = title;
        pick("[data-promo-state-body]").textContent = body;
        retry.hidden = !canRetry;
        statePanel.hidden = false;
      }

      const selectedKind = () => (root.querySelector<HTMLInputElement>('input[name="promo-kind"]:checked')?.value ?? "instagram") as Kind;
      // 올릴 곳을 바꾸면 순서 글·미리 보기·복사 단추를 그 곳에 맞추고, 복사함 표시는 지운다(그림 저장함 표시는 남김).
      function showText() {
        if (!texts) return;
        const kind = selectedKind();
        const counted = textCount(kind, texts[kind]);
        const steps = promoSteps(kind, { cardCount: cardTotal, counted });
        stepImage.textContent = steps.image;
        stepText.textContent = steps.text;
        stepPost.textContent = steps.post;
        previewLabel.textContent = `${kindNames[kind]} 글`;
        preview.value = texts[kind];
        count.textContent = kind === "instagram" ? `${counted.label} · 해시태그 ${counted.tags}개` : counted.label;
        count.dataset.state = counted.over ? "over" : "";
        copyButton.textContent = `${kindNames[kind]} 글 복사`;
        copyButton.classList.remove("is-done");
        status.textContent = "";
      }
      root.addEventListener("change", (event) => {
        if ((event.target as HTMLInputElement).name === "promo-kind") showText();
      });
      preview.addEventListener("focus", () => preview.scrollIntoView({ block: "nearest" }));
      copyButton.addEventListener("click", async () => {
        const name = kindNames[selectedKind()];
        try {
          await navigator.clipboard.writeText(preview.value);
          copyButton.textContent = `✓ ${name} 글 복사함`;
          copyButton.classList.add("is-done");
          status.textContent = `✓ ${name} 글을 복사했습니다.`;
          status.dataset.state = "success";
        } catch {
          // 자동 복사가 막히면 접어 둔 글 미리 보기를 펼쳐 글을 골라 둔다(직접 복사).
          textFold.open = true;
          preview.focus({ preventScroll: true });
          preview.select();
          preview.scrollIntoView({ block: "nearest" });
          status.textContent = "자동 복사가 막혔습니다. 펼친 글 미리 보기에서 골라 둔 글을 직접 복사해 주세요.";
          status.dataset.state = "error";
        }
      });
      printButton.addEventListener("click", () => window.print());

      // 담은 거래 요약(단지 · 종류 / 금액). 서버 값은 textContent로만 넣는다.
      function renderPicked(items: PromoItem[]) {
        pickedCount.textContent = `${items.length}건`;
        pickedList.replaceChildren(...items.map((item) => {
          const li = document.createElement("li");
          const name = document.createElement("span");
          name.textContent = `${item.aptName || "단지명 없음"} · ${kindLabel(item)}`;
          const price = document.createElement("strong");
          price.textContent = priceText(item);
          li.append(name, price);
          return li;
        }));
      }

      // 카드 그림: 크게 보기 그림과 ① 저장 링크(data 주소, CSP img-src에 blob이 없어 data를 쓴다). 서버 값은 textContent·속성으로만 넣는다.
      async function drawCards(cards: PromoCard[]) {
        const canvas = document.createElement("canvas");
        const today = todayInKorea();
        const figures: HTMLElement[] = [];
        const links: HTMLElement[] = [];
        const prints: HTMLImageElement[] = [];
        let overflow = false;
        for (const [index, card] of cards.entries()) {
          const result = await renderPromoCard(canvas, card);
          overflow ||= result.overflow;
          const figure = document.createElement("figure");
          figure.className = "rt-promo__card";
          const image = document.createElement("img");
          image.src = result.dataUrl;
          image.width = 540;
          image.height = 675;
          image.alt = `카드 그림${cards.length > 1 ? ` ${index + 1}/${cards.length}장` : ""}: ${card.title}`;
          const name = promoFileName(today, index, cards.length);
          const caption = document.createElement("figcaption");
          const file = document.createElement("small");
          file.textContent = name;
          caption.append(file);
          figure.append(image, caption);
          figures.push(figure);
          const wrap = document.createElement("div");
          wrap.className = "rt-step__download";
          const link = document.createElement("a");
          link.className = "work-primary-button rt-promo__download";
          link.href = result.dataUrl;
          link.download = name;
          link.dataset.promoDownload = "";
          const label = cards.length > 1 ? `${index + 1}장 저장` : "그림 저장";
          link.textContent = label;
          link.addEventListener("click", () => {
            link.textContent = `✓ ${cards.length > 1 ? `${index + 1}장` : "그림"} 저장함`;
            link.classList.add("is-done");
          });
          const linkFile = document.createElement("small");
          linkFile.textContent = name;
          wrap.append(link, linkFile);
          links.push(wrap);
          const printed = document.createElement("img");
          printed.src = result.dataUrl;
          printed.alt = image.alt;
          prints.push(printed);
        }
        cardList.replaceChildren(...figures);
        downloads.replaceChildren(...links);
        sheet.replaceChildren(...prints);
        sheet.dataset.count = String(cards.length);
        cardCount.textContent = cards.length > 1 ? `${cards.length}장` : "";
        cardWarn.hidden = !overflow;
        cardLoading.hidden = true;
        printButton.disabled = false;
      }

      async function start() {
        statePanel.hidden = true;
        notice.hidden = true;
        boot.hidden = false;
        const { ids, error } = parsePromoIds(window.location.search);
        if (error) {
          showState("담은 거래가 없습니다", error === "none" ? "실거래가 목록에서 홍보물에 넣을 거래를 담은 뒤 '홍보물 만들기'를 눌러 주세요." : "주소의 거래 목록이 올바르지 않습니다. 실거래가 목록에서 다시 담아 주세요.", { symbol: "0" });
          return;
        }
        let data: IdsResponse;
        try {
          const session = await getWorkSession({ refresh: true });
          if (!session.realpriceEnabled) throw new WorkApiError("disabled", { code: "REALPRICE_DISABLED" });
          data = await readWork<IdsResponse>("/realprice/trades", `ids=${ids.join(",")}`);
        } catch (failure) {
          const code = failure instanceof WorkApiError ? failure.code : null;
          const retryAt = failure instanceof WorkApiError ? failure.retryAt : null;
          if (code === "REALPRICE_DISABLED") showState("실거래가 탭이 아직 켜지지 않았습니다", "켜기 값을 등록하면 자료 받기와 목록이 켜집니다. 켜기 값 등록은 개발 담당이 합니다.", { symbol: "–" });
          else showState("담은 거래를 불러오지 못했습니다", apiErrorText(code, { retryAt }), { canRetry: code !== "AUTH_REQUIRED" });
          return;
        }
        const selection = promoSelection(data);
        const input = { items: selection.items, receivedAt: selection.receivedAt, office };
        const blocked = promoBlockReason(input);
        if (selection.notices.length > 0) {
          pick("[data-promo-notice-text]").textContent = selection.notices.join(" ");
          notice.hidden = false;
        }
        if (blocked) {
          showState("홍보물을 만들 수 없습니다", blocked, { symbol: "!", canRetry: selection.items.length > 0 && !selection.receivedAt });
          return;
        }
        texts = promoTexts(input) as Record<Kind, string>;
        // 거래 흐름(보드 63번): 담은 매매의 흐름을 한 번에 묻는다. 못 받거나 계산하지 못한 거래는 지금 모양 그대로 그린다(글 4가지는 바꾸지 않음).
        let insights: Record<string, unknown> = {};
        const saleIds = selection.items.filter((item: PromoItem) => item.kind === "sale").map((item: PromoItem) => item.tradeKey);
        if (saleIds.length > 0) {
          try {
            const flow = await readWork<{ items: { tradeKey: string }[] }>("/realprice/insights", `ids=${saleIds.join(",")}`);
            insights = Object.fromEntries(flow.items.map((item) => [item.tradeKey, item]));
          } catch {
            insights = {};
          }
        }
        const cards = promoCards({ ...input, insights }) as PromoCard[];
        cardTotal = cards.length;
        renderPicked(selection.items as PromoItem[]);
        boot.hidden = true;
        main.hidden = false;
        showText();
        try {
          await drawCards(cards);
        } catch {
          cardLoading.textContent = "카드 그림을 그리지 못했습니다. 화면을 새로 고쳐 주세요. 글은 그대로 복사할 수 있습니다.";
        }
      }
      retry.addEventListener("click", () => void start());

      void start();
    }
  </script>
</AdminLayout>
