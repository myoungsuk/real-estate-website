---
import AdminIcon from "../../../../components/admin/AdminIcon.astro";
import AdminPageHelp from "../../../../components/admin/AdminPageHelp.astro";
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import {
  DEFAULT_REALPRICE_FILTERS,
  DONG_GU_UMD_NAMES,
  REALPRICE_AREA_OPTIONS,
  REALPRICE_KIND_OPTIONS,
  REALPRICE_PERIODS,
  REALPRICE_PRICE_OPTIONS,
} from "../../../../lib/work/realprice-view.mjs";

// 단계 P 실거래가(P1-d). 사용자 시안 결정 2026-11-19 12:58:48: 979px 이하 B안(설명 한 줄·상태 한 줄 요약·거르기 접기), 980px 이상 0안.
// 화면은 하나이고 두 모양은 CSS(admin.css '실거래가')와 아래 스크립트의 펼침 처리로 나눈다. 서버를 부르므로 탭 미리 그리기 prerender 목록에 넣지 않는다.
const settingsHref = "/admin/work/realprice/settings/";
const mainLead = "대전 동구 아파트 실거래 신고 자료를 10분마다 조금씩 받아 둡니다. 계약일 기준이며, 신고 기한(30일) 때문에 최근 거래는 늘어날 수 있습니다.";
const criterion = "같은 단지·같은 전용면적에서 계약일이 앞선 매매(해제·직거래 뺌)의 최고가보다 높은 거래";
const selects = [
  { key: "period", id: "rt-period", label: "기간(계약일)", options: REALPRICE_PERIODS },
  { key: "kind", id: "rt-kind", label: "거래 종류", options: REALPRICE_KIND_OPTIONS },
  { key: "area", id: "rt-area", label: "전용면적", options: REALPRICE_AREA_OPTIONS },
  { key: "price", id: "rt-price", label: "금액(전월세는 보증금)", options: REALPRICE_PRICE_OPTIONS },
  { key: "umd", id: "rt-umd", label: "법정동", options: [{ value: "", label: "전체 법정동" }, ...DONG_GU_UMD_NAMES.map((name) => ({ value: name, label: name }))] },
] as const;
const defaults: Record<string, string | boolean> = DEFAULT_REALPRICE_FILTERS;
---

<AdminLayout
  title="실거래가 | 행복한부동산 관리자"
  description="대전 동구 아파트 실거래 신고 자료를 계약일 최근순으로 보고 거르는 관리자 업무 도구입니다."
>
  <div class="work-ui work-doc rt-doc" data-rt-page>
    <header class="work-doc__header">
      <span class="work-round-icon work-round-icon--title" data-tone="navy">
        <AdminIcon name="chart" size={22} />
      </span>
      <h1>실거래가</h1>
      <span class="admin-stage-badge">국토교통부 공개 자료</span>
    </header>

    <p class="work-doc__lead rt-lead--full">{mainLead}</p>
    <p class="work-doc__lead rt-lead--short">계약일 기준 · 최근 거래는 늘어날 수 있음</p>

    <AdminPageHelp page="/admin/work/realprice/" />

    <p class="rt-boot" role="status" data-rt-boot>실거래가 자료를 불러오고 있습니다…</p>

    <section class="admin-panel rt-state" aria-labelledby="rt-state-title" data-rt-state hidden>
      <div class="admin-empty-state">
        <span aria-hidden="true" data-rt-state-symbol>!</span>
        <div>
          <h2 id="rt-state-title" data-rt-state-title></h2>
          <p data-rt-state-body></p>
          <button class="admin-secondary-button rt-state__action" type="button" data-rt-state-retry hidden>다시 불러오기</button>
        </div>
      </div>
    </section>

    <details class="rt-sum" data-rt-sum hidden>
      <summary>
        <span class="rt-sum__text">
          <span class="sr-only">자료 받기 상태: </span>
          <span class="rt-sum__warn" data-rt-sum-warn hidden>
            <span class="admin-badge admin-badge--warning" data-rt-sum-badge>받기 멈춤</span>
            <strong data-rt-sum-warn-text></strong>
          </span>
          <span class="rt-sum__line" data-rt-sum-line></span>
          <span class="rt-sum__fill" data-rt-sum-fill hidden></span>
        </span>
        <span class="rt-fold__action" aria-hidden="true" data-rt-sum-action>자세히</span>
      </summary>
      <div class="rt-sum__body">
        <p class="rt-sum__lead">{mainLead}</p>
        <p class="rt-sum__high" data-rt-sum-high hidden></p>
        <section class="rt-status" aria-label="자료 받기 상태">
          <dl>
            <div><dt>마지막으로 받은 시각</dt><dd data-rt-last></dd></div>
            <div><dt>받은 범위</dt><dd data-rt-range></dd></div>
            <div><dt>받기 상태</dt><dd><span class="admin-badge" data-rt-badge></span></dd></div>
          </dl>
          <p class="rt-status__warn" data-rt-status-warn hidden></p>
          <a class="admin-text-link rt-status__link" href={settingsHref}>설정·다시 받기 <span aria-hidden="true">→</span></a>
        </section>
      </div>
    </details>

    <section class="admin-panel rt-backfill" aria-labelledby="rt-backfill-title" data-rt-backfill hidden>
      <h2 id="rt-backfill-title">과거 자료 채우기</h2>
    </section>

    <section class="admin-panel rt-state" aria-labelledby="rt-empty-title" data-rt-nodata hidden>
      <div class="admin-empty-state">
        <span aria-hidden="true">0</span>
        <div>
          <h2 id="rt-empty-title">아직 받은 거래가 없습니다</h2>
          <p>처음에는 2006년부터 지금까지의 자료를 10분마다 한 달씩 채웁니다. 다 채우기까지 며칠 걸리고, 최근 4개월이 먼저 보입니다. 이 화면은 닫아 두셔도 됩니다.</p>
        </div>
      </div>
    </section>

    <div data-rt-main hidden>
      <div class="work-row rt-mode" role="radiogroup" aria-labelledby="rt-mode-label">
        <span class="work-row__label" id="rt-mode-label">보기</span>
        <div class="work-segment">
          <label class="work-choice">
            <input type="radio" name="rt-mode" value="new" checked autocomplete="off" />
            <span>새 거래</span>
          </label>
          <label class="work-choice">
            <input type="radio" name="rt-mode" value="watch" autocomplete="off" />
            <span>관심 단지</span>
          </label>
        </div>
      </div>

      <p class="rt-watch-line" data-rt-watch-line hidden>
        <span data-rt-watch-names></span>
        <a class="admin-text-link" href={settingsHref}>설정에서 바꾸기</a>
      </p>

      <section class="admin-panel rt-state" aria-labelledby="rt-watch-empty-title" data-rt-watch-empty hidden>
        <div class="admin-empty-state">
          <span aria-hidden="true">0</span>
          <div>
            <h2 id="rt-watch-empty-title">관심 단지를 아직 고르지 않았습니다</h2>
            <p>설정에서 관심 단지를 넣으면 그 단지의 거래만 모아 봅니다.</p>
            <a class="admin-primary-button rt-state__action" href={settingsHref}>설정에서 고르기</a>
          </div>
        </div>
      </section>

      <details class="rt-fold" data-rt-fold>
        <summary>
          <span class="rt-fold__title">거르기</span>
          <span class="rt-fold__summary" data-rt-fold-summary>최근 3개월 · 해제 빼기</span>
          <span class="rt-fold__action" aria-hidden="true" data-rt-fold-action>펼치기</span>
        </summary>
        <div class="admin-listing-filters rt-filters" role="search" aria-label="실거래 거르기">
          {selects.map((select) => (
            <div class="admin-field">
              <label for={select.id}>{select.label}</label>
              <select id={select.id} data-rt-filter={select.key} autocomplete="off">
                {select.options.map((option) => (
                  <option value={option.value} selected={option.value === defaults[select.key]}>{option.label}</option>
                ))}
              </select>
            </div>
          ))}
          <div class="rt-filter-checks">
            <label class="work-check">
              <input type="checkbox" data-rt-filter="excludeCancelled" checked autocomplete="off" />
              <span>해제 빼기</span>
            </label>
            <label class="work-check">
              <input type="checkbox" data-rt-filter="excludeDirect" autocomplete="off" />
              <span>직거래 빼기</span>
            </label>
          </div>
          <button class="admin-filter-reset" type="button" data-rt-reset disabled>거르기 초기화</button>
        </div>
      </details>

      <section class="admin-panel rt-list" aria-labelledby="rt-list-title" data-rt-list>
        <div class="admin-panel__heading admin-panel__heading--list rt-list__heading">
          <div>
            <p class="admin-eyebrow rt-wide-only">계약일 최근순</p>
            <h2 id="rt-list-title">새 거래 <span><span data-rt-count></span><span class="rt-wide-only" data-rt-count-suffix> 보는 중</span><span class="rt-narrow-only" data-rt-count-suffix> · 계약일 최근순</span></span></h2>
          </div>
        </div>
        <p class="admin-inline-notice rt-notice" data-rt-notice hidden><span aria-hidden="true">i</span><span data-rt-notice-text></span></p>
        <p class="rt-criterion rt-criterion--above" data-rt-criterion><strong>신고가</strong> {criterion}</p>
        <p class="rt-loading" role="status" data-rt-loading hidden>거래를 불러오고 있습니다…</p>
        <div class="rt-skeleton" aria-hidden="true" data-rt-skeleton hidden>
          {[1, 2, 3, 4].map(() => <div><span></span><span></span><span></span></div>)}
        </div>
        <div class="rt-error" role="alert" data-rt-error hidden>
          <p><span class="admin-badge admin-badge--danger">목록을 보일 수 없음</span></p>
          <p data-rt-error-text></p>
          <button class="admin-secondary-button" type="button" data-rt-retry>다시 불러오기</button>
        </div>
        <div class="admin-empty-state admin-empty-state--filtered" data-rt-zero hidden>
          <span aria-hidden="true">0</span>
          <div>
            <h3>조건에 맞는 거래가 없습니다.</h3>
            <p>기간을 늘리거나 거래 종류·법정동·금액 조건을 바꿔 보세요.</p>
            <button class="admin-text-button" type="button" data-rt-zero-reset>거르기 초기화</button>
          </div>
        </div>
        <div class="admin-table-wrap rt-table-wrap" data-rt-table-wrap hidden>
          <table class="admin-table rt-table">
            <caption class="sr-only">실거래 목록(계약일 최근순)</caption>
            <thead>
              <tr>
                <th scope="col">단지</th>
                <th scope="col">전용면적·층</th>
                <th scope="col">금액</th>
                <th scope="col">거래</th>
                <th scope="col">표시</th>
                <th scope="col">계약일</th>
                <th scope="col">법정동</th>
                <th scope="col" class="rt-only-card">새로 들어옴</th>
                <th scope="col" class="rt-pick-col">홍보물</th>
              </tr>
            </thead>
            <tbody data-rt-rows></tbody>
          </table>
        </div>
        <p class="rt-criterion rt-criterion--below" data-rt-criterion><strong>신고가</strong> {criterion}</p>
        <div class="rt-more" data-rt-more hidden>
          <button class="admin-secondary-button" type="button" data-rt-more-button>30건 더 보기</button>
        </div>
        <div class="rt-pick-bar" data-rt-pick-bar hidden>
          <p data-rt-pick-text></p>
          <a class="admin-primary-button" href="/admin/work/realprice/promo/" data-rt-promo-link>홍보물 만들기</a>
          <button class="admin-secondary-button" type="button" data-rt-pick-clear>비우기</button>
        </div>
        <p class="sr-only" role="status" data-rt-live></p>
      </section>
    </div>
  </div>

  <script>
    import { getWorkSession, readWork, WorkApiError } from "../../../../lib/work-realprice-client";
    import { renderBackfillBars } from "../../../../lib/work-realprice-dom";
    import { todayInKorea } from "../../../../lib/work/legal-dates.mjs";
    import {
      DEFAULT_REALPRICE_FILTERS,
      apiErrorText,
      dateText,
      filterSummary,
      isDefaultFilters,
      kindLabel,
      kstLong,
      monthText,
      priceParts,
      sizeText,
      statusView,
      tradesQuery,
    } from "../../../../lib/work/realprice-view.mjs";
    import { PROMO_IDS_MAX, isPromoSelectable, promoHref, selectionText } from "../../../../lib/work/realprice-promo.mjs";
    import { formatKoreanWon } from "../../../../lib/work/work-format.mjs";

    interface Trade {
      tradeKey: string;
      kind: "sale" | "rent" | "presale";
      dealDate: string;
      umdName: string;
      aptName: string | null;
      areaM2: number;
      floor: number | null;
      priceWon: number | null;
      depositWon: number | null;
      monthlyRentWon: number | null;
      dealingGbn: "broker" | "direct" | null;
      cancelled: boolean;
      aptDong: string | null;
      recordHigh: boolean | null;
      prevMaxWon: number | null;
      isNew: boolean;
    }
    interface TradesResponse {
      items: Trade[];
      nextCursor: string | null;
      recordHighReady: boolean;
      warnings: { code: string; level?: string }[];
    }
    interface WatchResponse {
      version: number;
      items: { aptSeq: string; displayName: string; complexSlug: string | null }[];
    }
    type Filters = { period: string; kind: string; area: string; price: string; umd: string; excludeCancelled: boolean; excludeDirect: boolean };
    type Status = Parameters<typeof statusView>[0];

    const root = document.querySelector<HTMLElement>("[data-rt-page]");
    if (root) {
      const pick = <T extends Element = HTMLElement>(selector: string) => root.querySelector<T>(selector) as T;
      const boot = pick("[data-rt-boot]");
      const statePanel = pick("[data-rt-state]");
      const sum = pick<HTMLDetailsElement>("[data-rt-sum]");
      const sumAction = pick("[data-rt-sum-action]");
      const backfill = pick("[data-rt-backfill]");
      const noData = pick("[data-rt-nodata]");
      const main = pick("[data-rt-main]");
      const watchLine = pick("[data-rt-watch-line]");
      const watchEmpty = pick("[data-rt-watch-empty]");
      const fold = pick<HTMLDetailsElement>("[data-rt-fold]");
      const foldAction = pick("[data-rt-fold-action]");
      const foldSummary = pick("[data-rt-fold-summary]");
      const resetButton = pick<HTMLButtonElement>("[data-rt-reset]");
      const list = pick("[data-rt-list]");
      const listTitle = pick("#rt-list-title");
      const count = pick("[data-rt-count]");
      const countSuffixes = [...root.querySelectorAll<HTMLElement>("[data-rt-count-suffix]")];
      const notice = pick("[data-rt-notice]");
      const noticeText = pick("[data-rt-notice-text]");
      const criteria = [...root.querySelectorAll<HTMLElement>("[data-rt-criterion]")];
      const loading = pick("[data-rt-loading]");
      const skeleton = pick("[data-rt-skeleton]");
      const errorBox = pick("[data-rt-error]");
      const errorText = pick("[data-rt-error-text]");
      const zero = pick("[data-rt-zero]");
      const tableWrap = pick("[data-rt-table-wrap]");
      const rows = pick("[data-rt-rows]");
      const more = pick("[data-rt-more]");
      const moreButton = pick<HTMLButtonElement>("[data-rt-more-button]");
      const live = pick("[data-rt-live]");
      const pickBar = pick("[data-rt-pick-bar]");
      const pickText = pick("[data-rt-pick-text]");
      const promoLink = pick<HTMLAnchorElement>("[data-rt-promo-link]");
      const wide = window.matchMedia("(min-width: 980px)");

      let filters: Filters = { ...DEFAULT_REALPRICE_FILTERS };
      let mode: "new" | "watch" = "new";
      let status: Status | null = null;
      let problem = false;
      let highInSum = false;
      let items: Trade[] = [];
      let cursor: string | null = null;
      let requestSeq = 0;
      let controller: AbortController | null = null;
      // 홍보물에 넣을 거래(P1-e): 이 화면 메모리에만 둔다(브라우저 저장 없음). 거르기·보기를 바꿔도 남고, 최대 PROMO_IDS_MAX건.
      const picked = new Map<string, Trade>();

      const show = (element: HTMLElement, visible: boolean) => { element.hidden = !visible; };
      const errorCode = (error: unknown) => (error instanceof WorkApiError ? error.code : null);

      function showState(title: string, body: string, { symbol = "!", retry = false } = {}) {
        boot.hidden = true;
        pick("[data-rt-state-symbol]").textContent = symbol;
        pick("[data-rt-state-title]").textContent = title;
        pick("[data-rt-state-body]").textContent = body;
        show(pick("[data-rt-state-retry]"), retry);
        statePanel.hidden = false;
      }

      function showBootError(error: unknown) {
        const code = errorCode(error);
        if (code === "REALPRICE_DISABLED") {
          showState("실거래가 탭이 아직 켜지지 않았습니다", "켜기 값을 등록하면 자료 받기와 목록이 켜집니다. 켜기 값 등록은 개발 담당이 합니다.", { symbol: "–" });
        } else if (code === "REALPRICE_CONFIG_MISSING") {
          showState("실거래가 설정이 빠져 있습니다", "자료를 받는 데 필요한 연결 설정 가운데 빠진 것이 있어 목록을 보일 수 없습니다. 개발 담당에게 '실거래가 설정 누락'이라고 알려 주세요. 받아 둔 자료는 지워지지 않았습니다.");
        } else {
          showState("실거래가를 불러오지 못했습니다", apiErrorText(code), { retry: code !== "AUTH_REQUIRED" });
        }
      }

      // 979px 이하: 상태는 문제가 있을 때만 펼쳐 두고(12:58:48 결정) 거르기는 접는다. 980px 이상: 둘 다 늘 펼친다(요약 줄은 CSS가 숨김).
      function applyLayout() {
        sum.open = wide.matches || problem;
        fold.open = wide.matches;
      }
      const syncActions = () => {
        sumAction.textContent = sum.open ? "접기" : "자세히";
        foldAction.textContent = fold.open ? "접기" : "펼치기";
      };
      sum.addEventListener("toggle", syncActions);
      fold.addEventListener("toggle", syncActions);
      wide.addEventListener("change", applyLayout);

      function renderStatus(current: Status) {
        const view = statusView(current, { nowMs: Date.now(), todayKst: todayInKorea() });
        problem = Boolean(view.problem);
        sum.classList.toggle("rt-sum--warn", problem);
        show(pick("[data-rt-sum-warn]"), problem);
        pick("[data-rt-sum-badge]").textContent = view.problem?.stop ? "받기 멈춤" : "확인 필요";
        pick("[data-rt-sum-warn-text]").textContent = view.problem?.label ?? "";
        pick("[data-rt-sum-line]").textContent = view.line;
        const fill = pick("[data-rt-sum-fill]");
        fill.textContent = view.fill;
        show(fill, Boolean(view.fill));
        // 신고가 판정 준비 전: 979px 이하는 위 한 줄 끝("· 신고가는 채운 뒤")과 이 문장으로 알리고 목록 위 안내는 숨긴다(CSS). 980px 이상은 목록 위 안내 그대로.
        highInSum = view.fillHigh;
        const sumHigh = pick("[data-rt-sum-high]");
        sumHigh.textContent = highInSum ? highWaitText(current) : "";
        show(sumHigh, highInSum);
        pick("[data-rt-last]").textContent = view.lastLong;
        pick("[data-rt-range]").textContent = view.range;
        const badge = pick("[data-rt-badge]");
        badge.className = `admin-badge admin-badge--${view.badge.tone}`;
        badge.textContent = view.badge.text;
        const warn = pick("[data-rt-status-warn]");
        warn.textContent = view.problem
          ? `${view.problem.message}${view.problem.stop && current?.lastSuccessAt ? ` 아래 목록은 ${kstLong(current.lastSuccessAt)}까지 받은 자료입니다.` : ""}`
          : "";
        show(warn, problem);
        sum.hidden = false;
        if (!view.totals.complete) renderBackfillBars(backfill, current);
        show(backfill, !view.totals.complete);
        return view;
      }

      // ── 목록 ──

      const cell = (className: string, label: string) => {
        const td = document.createElement("td");
        td.className = className;
        td.dataset.label = label;
        return td;
      };
      const tag = (text: string, className: string) => {
        const span = document.createElement("span");
        span.className = `rt-tag ${className}`;
        span.textContent = text;
        return span;
      };

      // 홍보물 고르기 칸: 해제된 거래는 고를 수 없다(설계서 22.10절). 다 고르면(최대 건수) 나머지 칸은 잠근다.
      function pickCell(item: Trade) {
        const td = cell("rt-pick", "홍보물");
        const label = document.createElement("label");
        label.className = "admin-review-select";
        const box = document.createElement("input");
        box.type = "checkbox";
        box.value = item.tradeKey;
        box.autocomplete = "off";
        const selectable = isPromoSelectable(item);
        box.dataset.rtPick = selectable ? "on" : "off";
        box.checked = selectable && picked.has(item.tradeKey);
        box.disabled = !selectable || (!box.checked && picked.size >= PROMO_IDS_MAX);
        box.setAttribute("aria-label", `${item.aptName || "단지명 없음"} ${dateText(item.dealDate)} ${kindLabel(item)}${selectable ? " 홍보물에 넣기" : " 해제된 거래라 홍보물에 넣을 수 없음"}`);
        const text = document.createElement("span");
        text.textContent = selectable ? "고르기" : "고를 수 없음";
        label.append(box, text);
        td.append(label);
        return td;
      }

      function syncPicks() {
        const full = picked.size >= PROMO_IDS_MAX;
        for (const box of rows.querySelectorAll<HTMLInputElement>("input[data-rt-pick]")) {
          if (box.dataset.rtPick !== "on") continue;
          box.checked = picked.has(box.value);
          box.disabled = !box.checked && full;
        }
        pickText.textContent = selectionText(picked.size);
        const href = promoHref([...picked.keys()]);
        if (href) promoLink.href = href;
        pickBar.hidden = picked.size === 0;
      }
      rows.addEventListener("change", (event) => {
        const box = event.target as HTMLInputElement;
        if (box.dataset.rtPick !== "on") return;
        const item = items.find((trade) => trade.tradeKey === box.value);
        if (box.checked && item && picked.size < PROMO_IDS_MAX) picked.set(box.value, item);
        else picked.delete(box.value);
        syncPicks();
        live.textContent = picked.size >= PROMO_IDS_MAX ? `${selectionText(picked.size)}. 더 고르려면 하나를 빼 주세요.` : selectionText(picked.size);
      });
      pick("[data-rt-pick-clear]").addEventListener("click", () => {
        picked.clear();
        syncPicks();
        live.textContent = "고른 거래를 비웠습니다.";
      });
      // 막대 실제 높이를 아래 여백(admin.css의 scroll-padding-bottom)에 넘겨, Tab으로 옮긴 포커스가 막대 뒤로 숨지 않게 한다.
      if (typeof ResizeObserver === "function") {
        new ResizeObserver(() => {
          if (pickBar.hidden) return;
          document.documentElement.style.setProperty("--rt-pick-bar-h", `${Math.ceil(pickBar.getBoundingClientRect().height)}px`);
        }).observe(pickBar);
      }

      // 서버 값은 모두 textContent로 넣는다(HTML로 해석하지 않음).
      function rowOf(item: Trade, showHigh: boolean) {
        const tr = document.createElement("tr");
        tr.className = item.cancelled ? "rt-row is-cancelled" : "rt-row";
        const high = showHigh && item.recordHigh === true;
        const name = cell("rt-name", "단지");
        const strong = document.createElement("strong");
        strong.textContent = item.aptName || "단지명 없음";
        name.append(strong);
        const size = cell("rt-size", "전용면적·층");
        size.textContent = sizeText(item);
        const price = cell("rt-price", "금액");
        const parts = priceParts(item);
        price.append(parts.main);
        if (parts.monthly) {
          const monthly = document.createElement("span");
          monthly.className = "rt-price__monthly";
          monthly.textContent = parts.monthly;
          price.append(" ", monthly);
        }
        if (high && Number.isSafeInteger(item.prevMaxWon)) {
          const prev = document.createElement("small");
          prev.className = "rt-prev";
          prev.textContent = `앞선 최고 ${formatKoreanWon(item.prevMaxWon)}`;
          price.append(prev);
        }
        const kind = cell("rt-kind", "거래");
        kind.append(kindLabel(item));
        if (item.dealingGbn === "direct") {
          const direct = document.createElement("small");
          direct.textContent = "직거래";
          kind.append(direct);
        }
        const flags = cell("rt-flags", "표시");
        if (high) flags.append(tag("신고가", "rt-tag--high"));
        if (item.cancelled) flags.append(tag("해제", "rt-tag--cancel"));
        if (item.isNew) flags.append(tag("새로 들어옴", "rt-tag--new rt-only-table"));
        const date = cell("rt-date", "계약일");
        date.textContent = dateText(item.dealDate);
        const umd = cell("rt-umd", "법정동");
        umd.textContent = item.umdName;
        const fresh = cell("rt-new rt-only-card", "새로 들어옴");
        if (item.isNew) fresh.append(tag("새로 들어옴", "rt-tag--new"));
        tr.append(name, size, price, kind, flags, date, umd, fresh, pickCell(item));
        return tr;
      }

      function setListTitle(text: string) {
        const first = listTitle.firstChild;
        if (first?.nodeType === Node.TEXT_NODE) first.nodeValue = `${text} `;
      }

      function setListBusy(busy: boolean) {
        list.setAttribute("aria-busy", busy ? "true" : "false");
        show(loading, busy);
        show(skeleton, busy);
        for (const suffix of countSuffixes) suffix.hidden = busy;
        if (busy) {
          count.textContent = "불러오는 중";
          for (const element of [errorBox, zero, tableWrap, more, notice]) element.hidden = true;
        }
      }

      function highWaitText(current: Status | null) {
        const through = current?.coveredThrough ? `, 지금 ${monthText(current.coveredThrough)}까지` : "";
        return `신고가 판정 준비 중(매매 과거 자료 채우는 중${through}). 과거 자료가 빠진 채 표시하면 신고가가 아닌 거래를 신고가로 보일 수 있어 다 채운 뒤 표시합니다.`;
      }

      function renderNotice(data: TradesResponse) {
        let text = "";
        if (!data.recordHighReady) {
          text = highWaitText(status);
        } else if (data.warnings.some((warning) => warning.code === "RT_READ_BUDGET")) {
          text = "오늘 조회가 많아 신고가 표시를 잠시 껐습니다. 한국 시각 오전 9시 뒤에 다시 보입니다. 목록은 그대로 볼 수 있습니다.";
        }
        noticeText.textContent = text;
        show(notice, Boolean(text));
        notice.classList.toggle("rt-notice--in-sum", !data.recordHighReady && highInSum);
        const showHigh = !text;
        for (const element of criteria) element.hidden = !showHigh;
        return showHigh;
      }

      function renderList(data: TradesResponse, appended: number) {
        setListBusy(false);
        const showHigh = renderNotice(data);
        if (appended === 0) rows.replaceChildren();
        const start = items.length - data.items.length;
        // 고른 뒤 다시 받기로 해제된 거래는 고른 것에서 뺀다(홍보물 화면도 다시 읽을 때 한 번 더 뺀다).
        for (const item of data.items) if (picked.has(item.tradeKey) && !isPromoSelectable(item)) picked.delete(item.tradeKey);
        rows.append(...items.slice(start).map((item) => rowOf(item, showHigh)));
        syncPicks();
        count.textContent = `${items.length.toLocaleString("ko-KR")}건`;
        show(tableWrap, items.length > 0);
        show(zero, items.length === 0);
        if (items.length === 0) for (const element of criteria) element.hidden = true;
        show(more, Boolean(cursor));
        moreButton.disabled = false;
        moreButton.textContent = "30건 더 보기";
        live.textContent = appended > 0 ? `${data.items.length}건을 더 불러왔습니다. 모두 ${items.length}건입니다.` : `${items.length}건을 보여 줍니다.`;
      }

      function renderListError(error: unknown) {
        setListBusy(false);
        const retryAt = error instanceof WorkApiError ? error.retryAt : null;
        errorText.textContent = apiErrorText(errorCode(error), { retryAt });
        count.textContent = "";
        for (const suffix of countSuffixes) suffix.hidden = true;
        errorBox.hidden = false;
        for (const element of [zero, more, notice, ...criteria]) element.hidden = true;
        tableWrap.hidden = items.length === 0;
      }

      async function loadList({ append = false } = {}) {
        const request = ++requestSeq;
        controller?.abort();
        controller = new AbortController();
        if (append) {
          moreButton.disabled = true;
          moreButton.textContent = "불러오는 중…";
        } else {
          items = [];
          cursor = null;
          setListBusy(true);
        }
        try {
          const query = tradesQuery(filters, { watch: mode === "watch", cursor: append ? cursor : null, todayKst: todayInKorea() });
          const data = await readWork<TradesResponse>("/realprice/trades", query, controller.signal);
          if (request !== requestSeq) return;
          items = append ? [...items, ...data.items] : data.items;
          cursor = data.nextCursor;
          renderList(data, append ? data.items.length : 0);
        } catch (error) {
          if (request !== requestSeq || (error instanceof DOMException && error.name === "AbortError")) return;
          if (append) {
            moreButton.disabled = false;
            moreButton.textContent = "30건 더 보기";
          }
          renderListError(error);
        }
      }

      // ── 보기·관심 단지 ──

      async function showMode() {
        const request = ++requestSeq;
        controller?.abort();
        setListTitle(mode === "watch" ? "관심 단지 거래" : "새 거래");
        watchLine.hidden = true;
        watchEmpty.hidden = true;
        fold.hidden = false;
        list.hidden = false;
        if (mode === "new") {
          void loadList();
          return;
        }
        setListBusy(true);
        let watch: WatchResponse;
        try {
          watch = await readWork<WatchResponse>("/realprice/watch");
        } catch (error) {
          if (request !== requestSeq) return;
          renderListError(error);
          return;
        }
        if (request !== requestSeq) return;
        if (watch.items.length === 0) {
          setListBusy(false);
          fold.hidden = true;
          list.hidden = true;
          watchEmpty.hidden = false;
          return;
        }
        pick("[data-rt-watch-names]").textContent = `관심 단지 ${watch.items.length}곳: ${watch.items.map((item) => item.displayName).join(" · ")}`;
        watchLine.hidden = false;
        void loadList();
      }

      for (const input of root.querySelectorAll<HTMLInputElement>('input[name="rt-mode"]')) {
        input.addEventListener("change", () => {
          if (!input.checked) return;
          mode = input.value === "watch" ? "watch" : "new";
          void showMode();
        });
      }

      // ── 거르기 ──

      const filterInputs = [...root.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-rt-filter]")];
      function syncFilterControls() {
        for (const input of filterInputs) {
          const key = input.dataset.rtFilter as keyof Filters;
          if (input instanceof HTMLInputElement && input.type === "checkbox") input.checked = Boolean(filters[key]);
          else input.value = String(filters[key]);
        }
        foldSummary.textContent = filterSummary(filters);
        resetButton.disabled = isDefaultFilters(filters);
      }
      for (const input of filterInputs) {
        input.addEventListener("change", () => {
          const key = input.dataset.rtFilter as keyof Filters;
          filters = { ...filters, [key]: input instanceof HTMLInputElement && input.type === "checkbox" ? input.checked : input.value };
          syncFilterControls();
          void loadList();
        });
      }
      const resetFilters = () => {
        filters = { ...DEFAULT_REALPRICE_FILTERS };
        syncFilterControls();
        void loadList();
      };
      resetButton.addEventListener("click", resetFilters);
      pick("[data-rt-zero-reset]").addEventListener("click", resetFilters);
      moreButton.addEventListener("click", () => {
        if (cursor) void loadList({ append: true });
      });
      pick("[data-rt-retry]").addEventListener("click", () => void showMode());

      // ── 처음 불러오기: 세션(켜짐·설정) → 상태 → 목록 ──

      async function start() {
        statePanel.hidden = true;
        boot.hidden = false;
        try {
          const session = await getWorkSession({ refresh: true });
          if (!session.realpriceEnabled) throw new WorkApiError("disabled", { code: "REALPRICE_DISABLED" });
          status = await readWork<Status>("/realprice/status");
        } catch (error) {
          showBootError(error);
          return;
        }
        boot.hidden = true;
        const view = renderStatus(status);
        applyLayout();
        syncActions();
        if (view.empty) {
          noData.hidden = false;
          return;
        }
        main.hidden = false;
        syncFilterControls();
        void showMode();
      }
      pick("[data-rt-state-retry]").addEventListener("click", () => void start());

      void start();
    }
  </script>
</AdminLayout>
