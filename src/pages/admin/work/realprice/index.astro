---
import AdminIcon from "../../../../components/admin/AdminIcon.astro";
import AdminPageHelp from "../../../../components/admin/AdminPageHelp.astro";
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import {
  DEFAULT_REALPRICE_FILTERS,
  DONG_GU_UMD_NAMES,
  REALPRICE_AREA_OPTIONS,
  REALPRICE_KIND_OPTIONS,
  REALPRICE_PERIODS,
  REALPRICE_PRICE_OPTIONS,
  chipText,
} from "../../../../lib/work/realprice-view.mjs";
import { PROMO_IDS_MAX, PROMO_PATH, PROMO_PLACES, PROMO_STYLE_DEFAULT, PROMO_STYLES } from "../../../../lib/work/realprice-promo.mjs";
import { COMPLEX_FLOW_RULE } from "../../../../lib/work/realprice-complex-view.mjs";

// 단계 P 실거래가(P1-d, P1-f). 운영자 결정 2026-11-20 13:36:35 D안: 위 상태 한 줄 → 보기 3칸(새 거래·주요 거래·관심 단지) → 찾기칸 →
// 거르기 단추 6개(기간·평형·금액·신고가만·분양권만·더 보기) → 'n건 보는 중'·켜짐 줄·다 담기 → 목록(거래마다 담기 체크칸). 휴대폰·PC가 같은 순서이고
// 폭에 따른 모양은 CSS(admin.css '실거래가')가 나눈다. 서버를 부르므로 탭 미리 그리기 prerender 목록에 넣지 않는다.
// 거래 흐름(보드 63번, 2026-11-20 운영자 "권하는 조합"): 매매 거래마다 12개월 흐름선·직전 거래·최고가 대비(앞선 최고 기준)·최근 3개월 건수.
// 1221px 이상 표는 칸 3개(흐름 아래 3개월 건수, 거래 종류·표시는 금액 아래, 법정동·준공연도는 단지 아래 작은 줄), 1220px 이하 카드는 '흐름·직전 거래'를 눌러 펼친다. 쪽을 그린 뒤 보이는 매매 ID만 30개씩 한 번에 묻고 페이지 메모리에서 다시 쓴다.
// 오른쪽 미리보기 칸(D-3, 2026-11-23 사용자 승인 "이대로 구현"·"세로로 2장"): 1221px 이상만 380px 칸에 담은 거래의 홍보물 카드(지금 홍보물 화면 그림 그대로, 2장이면 세로)와
// 그림 저장·글 복사·종이로 뽑기(A4)를 두고, 층·동은 표의 전용면적 아래 작은 줄로 내린다. 1220px 이하는 칸 없이 아래 막대 '홍보물 만들기' 그대로다.
const settingsHref = "/admin/work/realprice/settings/";
const mainLead = "대전 동구 아파트 실거래 신고 자료를 10분마다 조금씩 받아 둡니다. 계약일 기준이며, 신고 기한(30일) 때문에 최근 거래는 늘어날 수 있습니다.";
const criterion = "같은 단지·같은 전용면적에서 계약일이 앞선 매매(해제·직거래 뺌)의 최고가보다 높은 거래";
// 거르기 단추(chip)는 고른 값을 짧은 글자로 보이고, 누르면 휴대폰·PC 기본 고르기 목록(경계까지 쓴 글자)이 열린다.
const chipSelects = [
  { key: "period", id: "rt-period", label: "기간(계약일)", options: REALPRICE_PERIODS },
  { key: "area", id: "rt-area", label: "평형(전용면적)", options: REALPRICE_AREA_OPTIONS },
  { key: "price", id: "rt-price", label: "금액(전월세는 보증금)", options: REALPRICE_PRICE_OPTIONS },
] as const;
const moreSelects = [
  { key: "kind", id: "rt-kind", label: "거래 종류", options: REALPRICE_KIND_OPTIONS },
  { key: "umd", id: "rt-umd", label: "법정동", options: [{ value: "", label: "전체 법정동" }, ...DONG_GU_UMD_NAMES.map((name) => ({ value: name, label: name }))] },
] as const;
const defaults: Record<string, string | boolean> = DEFAULT_REALPRICE_FILTERS;
const chipTextOf = (key: "period" | "area" | "price") => chipText(key, String(defaults[key])).text;
---

<AdminLayout
  title="실거래가 | 행복한부동산 관리자"
  description="대전 동구 아파트 실거래 신고 자료를 계약일 최근순으로 보고 거르는 관리자 업무 도구입니다."
>
  <div class="work-ui work-doc rt-doc" data-rt-page>
    <header class="work-doc__header">
      <span class="work-round-icon work-round-icon--title" data-tone="navy">
        <AdminIcon name="chart" size={22} />
      </span>
      <h1>실거래가</h1>
      <span class="admin-stage-badge">국토교통부 공개 자료</span>
    </header>

    <AdminPageHelp page="/admin/work/realprice/" />

    <p class="rt-boot" role="status" data-rt-boot>실거래가 자료를 불러오고 있습니다…</p>

    <section class="admin-panel rt-state" aria-labelledby="rt-state-title" data-rt-state hidden>
      <div class="admin-empty-state">
        <span aria-hidden="true" data-rt-state-symbol>!</span>
        <div>
          <h2 id="rt-state-title" data-rt-state-title></h2>
          <p data-rt-state-body></p>
          <button class="admin-secondary-button rt-state__action" type="button" data-rt-state-retry hidden>다시 불러오기</button>
        </div>
      </div>
    </section>

    <details class="rt-sum" data-rt-sum hidden>
      <summary>
        <span class="rt-sum__text">
          <span class="sr-only">자료 받기 상태: </span>
          <span class="rt-sum__warn" data-rt-sum-warn hidden>
            <span class="admin-badge admin-badge--warning" data-rt-sum-badge>받기 멈춤</span>
            <strong data-rt-sum-warn-text></strong>
          </span>
          <span class="rt-sum__head"><span class="rt-sum__line" data-rt-sum-line></span><span class="rt-sum__basis"> · 계약일 기준</span></span>
          <span class="rt-sum__fill" data-rt-sum-fill hidden></span>
        </span>
        <span class="rt-sum__action" aria-hidden="true" data-rt-sum-action>자세히</span>
      </summary>
      <div class="rt-sum__body">
        <p class="rt-sum__lead">{mainLead}</p>
        <p class="rt-sum__high" data-rt-sum-high hidden></p>
        <section class="rt-status" aria-label="자료 받기 상태">
          <dl>
            <div><dt>마지막으로 받은 시각</dt><dd data-rt-last></dd></div>
            <div><dt>받은 범위</dt><dd data-rt-range></dd></div>
            <div><dt>받기 상태</dt><dd><span class="admin-badge" data-rt-badge></span></dd></div>
          </dl>
          <p class="rt-status__warn" data-rt-status-warn hidden></p>
          <a class="admin-text-link rt-status__link" href={settingsHref}>설정·다시 받기 <span aria-hidden="true">→</span></a>
        </section>
      </div>
    </details>

    <section class="admin-panel rt-backfill" aria-labelledby="rt-backfill-title" data-rt-backfill hidden>
      <h2 id="rt-backfill-title">과거 자료 채우기</h2>
    </section>

    <section class="admin-panel rt-state" aria-labelledby="rt-empty-title" data-rt-nodata hidden>
      <div class="admin-empty-state">
        <span aria-hidden="true">0</span>
        <div>
          <h2 id="rt-empty-title">아직 받은 거래가 없습니다</h2>
          <p>처음에는 2006년부터 지금까지의 자료를 10분마다 한 달씩 채웁니다. 다 채우기까지 며칠 걸리고, 최근 4개월이 먼저 보입니다. 이 화면은 닫아 두셔도 됩니다.</p>
        </div>
      </div>
    </section>

    <div class="rt-split">
      <div data-rt-main hidden>
        <div class="work-row rt-mode" role="radiogroup" aria-labelledby="rt-mode-label">
          <span class="work-row__label" id="rt-mode-label">보기</span>
          <div class="work-segment">
            <label class="work-choice">
              <input type="radio" name="rt-mode" value="new" checked autocomplete="off" />
              <span>새 거래</span>
            </label>
            <label class="work-choice">
              <input type="radio" name="rt-mode" value="major" autocomplete="off" />
              <span>주요 거래</span>
            </label>
            <label class="work-choice">
              <input type="radio" name="rt-mode" value="watch" autocomplete="off" />
              <span>관심 단지</span>
            </label>
          </div>
        </div>

        <p class="rt-watch-line" data-rt-watch-line hidden>
          <span data-rt-watch-names></span>
          <a class="admin-text-link" href={settingsHref}>설정에서 바꾸기</a>
        </p>

        <section class="admin-panel rt-state" aria-labelledby="rt-watch-empty-title" data-rt-watch-empty hidden>
          <div class="admin-empty-state">
            <span aria-hidden="true">0</span>
            <div>
              <h2 id="rt-watch-empty-title">관심 단지를 아직 고르지 않았습니다</h2>
              <p>설정에서 관심 단지를 넣으면 그 단지의 거래만 모아 봅니다.</p>
              <a class="admin-primary-button rt-state__action" href={settingsHref}>설정에서 고르기</a>
            </div>
          </div>
        </section>

        <div class="rt-top" data-rt-top>
          <div class="rt-find" role="search" aria-label="단지·동 이름으로 찾기">
            <label class="sr-only" for="rt-q">단지 이름이나 동 이름</label>
            <input id="rt-q" type="search" maxlength="30" placeholder="단지 이름이나 동 이름" enterkeyhint="search" autocomplete="off" data-rt-q />
            <button class="rt-find__go" type="button" data-rt-q-go>찾기</button>
          </div>
          <div class="rt-chips" role="group" aria-label="거르기">
            {chipSelects.map((select) => (
              <label class="rt-chip rt-chip--menu rt-chip--select" data-rt-chip={select.key}>
                <span class="rt-chip__text" aria-hidden="true" data-rt-chip-text={select.key}>{chipTextOf(select.key)}</span>
                <select id={select.id} aria-label={select.label} data-rt-filter={select.key} autocomplete="off">
                  {select.options.map((option) => (
                    <option value={option.value} selected={option.value === defaults[select.key]}>{option.label}</option>
                  ))}
                </select>
              </label>
            ))}
            <button class="rt-chip" type="button" aria-pressed="false" data-rt-toggle="highOnly">신고가만</button>
            <button class="rt-chip" type="button" aria-pressed="false" data-rt-toggle="presale">분양권만</button>
            <button class="rt-chip rt-chip--menu" type="button" aria-expanded="false" aria-controls="rt-more-filters" data-rt-more-toggle>더 보기</button>
          </div>
        </div>
        <div class="admin-listing-filters rt-filters" id="rt-more-filters" role="group" aria-label="거르기 더 보기" data-rt-more-filters hidden>
          {moreSelects.map((select) => (
            <div class="admin-field">
              <label for={select.id}>{select.label}</label>
              <select id={select.id} data-rt-filter={select.key} autocomplete="off">
                {select.options.map((option) => (
                  <option value={option.value} selected={option.value === defaults[select.key]}>{option.label}</option>
                ))}
              </select>
            </div>
          ))}
          <div class="rt-filter-checks">
            <label class="work-check">
              <input type="checkbox" data-rt-filter="excludeCancelled" checked autocomplete="off" />
              <span>해제 빼기</span>
            </label>
            <label class="work-check">
              <input type="checkbox" data-rt-filter="excludeDirect" autocomplete="off" />
              <span>직거래 빼기</span>
            </label>
          </div>
          <p class="rt-filters__major" data-rt-major-note hidden>주요 거래는 최근 30일 매매(해제·직거래 뺌)만 봅니다. 거래 종류·해제·직거래는 '새 거래'에서 바꿉니다.</p>
          <button class="admin-filter-reset" type="button" data-rt-reset disabled>거르기 초기화</button>
        </div>

        <section class="admin-panel rt-list" aria-labelledby="rt-list-title" data-rt-list>
          <div class="rt-strip" data-rt-strip>
            <div class="rt-strip__text">
              <h2 id="rt-list-title"><span class="sr-only" data-rt-list-name>새 거래</span> <span data-rt-count></span><span data-rt-count-suffix> 보는 중</span></h2>
              <p class="rt-strip__on"><span data-rt-on-text>거르기 없음 · 해제 거래 뺌</span><button class="rt-strip__clear" type="button" data-rt-clear-all hidden>모두 끄기</button></p>
            </div>
            <button class="rt-take" type="button" data-rt-take hidden>위에서 6건 담기</button>
          </div>
          <p class="admin-inline-notice rt-notice" data-rt-notice hidden><span aria-hidden="true">i</span><span data-rt-notice-text></span></p>
          <p class="rt-loading" role="status" data-rt-loading hidden>거래를 불러오고 있습니다…</p>
          <div class="rt-skeleton" aria-hidden="true" data-rt-skeleton hidden>
            {[1, 2, 3, 4].map(() => <div><span></span><span></span><span></span></div>)}
          </div>
          <div class="rt-error" role="alert" data-rt-error hidden>
            <p><span class="admin-badge admin-badge--danger">목록을 보일 수 없음</span></p>
            <p data-rt-error-text></p>
            <button class="admin-secondary-button" type="button" data-rt-retry>다시 불러오기</button>
          </div>
          <div class="rt-empty" data-rt-zero hidden>
            <h3 data-rt-zero-title>조건에 맞는 거래가 없습니다.</h3>
            <p data-rt-zero-body>기간을 늘리거나 거래 종류·법정동·금액 조건을 바꿔 보세요.</p>
            <div class="rt-empty__actions" data-rt-zero-actions>
              <button type="button" data-rt-zero-action="reset">거르기 초기화</button>
            </div>
          </div>
          <div class="admin-table-wrap rt-table-wrap" data-rt-table-wrap hidden>
            <table class="admin-table rt-table">
              <caption class="sr-only">실거래 목록(계약일 최근순)</caption>
              <thead>
                <tr>
                  <th scope="col" class="rt-pick-col">담기</th>
                  <th scope="col">단지</th>
                  <th scope="col" class="rt-th-size"><span>전용면적·</span><wbr />층</th>
                  <th scope="col">금액</th>
                  <th scope="col" class="rt-only-card">거래</th>
                  <th scope="col" class="rt-only-card">표시</th>
                  <th scope="col" class="rt-only-table rt-th-wrap">흐름<wbr />(12개월)</th>
                  <th scope="col" class="rt-only-table rt-th-wrap">직전 거래</th>
                  <th scope="col" class="rt-only-table rt-th-wrap">최고가 대비</th>
                  <th scope="col">계약일</th>
                  <th scope="col" class="rt-only-card">법정동</th>
                  <th scope="col" class="rt-only-card">새로 들어옴</th>
                  <th scope="col" class="rt-only-card">흐름·직전 거래</th>
                </tr>
              </thead>
              <tbody data-rt-rows></tbody>
            </table>
          </div>
          <p class="rt-criterion rt-criterion--below" data-rt-criterion><strong>신고가</strong> {criterion}</p>
          <div class="rt-more" data-rt-more hidden>
            <button class="admin-secondary-button" type="button" data-rt-more-button>30건 더 보기</button>
          </div>
          <div class="rt-pick-bar" data-rt-pick-bar hidden>
            <p data-rt-pick-text></p>
            <a class="admin-primary-button rt-pick-bar__promo" href="/admin/work/realprice/promo/" data-rt-promo-link>홍보물 만들기</a>
            <button class="admin-secondary-button" type="button" data-rt-pick-clear>비우기</button>
          </div>
          <p class="sr-only" role="status" data-rt-live></p>
        </section>
      </div>
      <aside class="rt-preview" aria-labelledby="rt-preview-title" data-rt-preview>
        <div class="rt-preview__head">
          <h2 class="rt-preview__title" id="rt-preview-title">미리보기 <small data-rt-preview-count>담은 거래 0건</small></h2>
          <div data-rt-preview-where hidden>
            <p class="rt-preview__where" id="rt-preview-style-title">카드 모양</p>
            <div class="rt-preview__styles" role="radiogroup" aria-labelledby="rt-preview-style-title">
              {PROMO_STYLES.map(([value, label]) => (
                <label class="rt-preview__style">
                  <input type="radio" name="rt-promo-style" value={value} checked={value === PROMO_STYLE_DEFAULT} autocomplete="off" />
                  <span>{label}</span>
                </label>
              ))}
            </div>
          </div>
        </div>
        <div class="rt-preview__body">
          <div class="rt-preview__empty" data-rt-preview-empty>
            <b>담은 거래가 없습니다</b>
            <span>목록에서 거래를 체크하면 여기에 홍보물 그림이 바로 보입니다(최대 {PROMO_IDS_MAX}건).</span>
          </div>
          <p class="rt-loading" role="status" data-rt-preview-loading hidden>홍보물 그림을 그리고 있습니다…</p>
          <p class="admin-inline-notice rt-notice" data-rt-preview-notice hidden><span aria-hidden="true">i</span><span data-rt-preview-notice-text></span></p>
          <div class="rt-preview__blocked" data-rt-preview-blocked hidden>
            <p data-rt-preview-blocked-text></p>
            <button class="admin-secondary-button" type="button" data-rt-preview-retry hidden>미리보기 다시 그리기</button>
          </div>
          <div class="rt-preview__cards" data-rt-preview-cards></div>
          <p class="rt-promo__warn" data-rt-preview-warn hidden>글이 길어 그림 아래 칸과 겹칠 수 있습니다. '크게 보기·글 미리 보기'에서 확인해 주세요.</p>
        </div>
        <div class="rt-preview__act" data-rt-preview-act hidden>
          <div class="rt-preview__downloads" data-rt-preview-downloads></div>
          <p class="rt-preview__size" data-rt-preview-size></p>
          <p class="rt-preview__where" id="rt-preview-copy-title">올릴 곳에 맞춘 글 복사</p>
          <div class="rt-places rt-places--panel" role="group" aria-labelledby="rt-preview-copy-title">
            {PROMO_PLACES.map(([value, label]) => (
              <button class="rt-place" type="button" data-rt-preview-copy={value} aria-describedby="rt-preview-post">
                <b>{label}</b>
                <small data-rt-preview-copy-state>글 복사</small>
              </button>
            ))}
          </div>
          <p class="rt-preview__hint" id="rt-preview-post" data-rt-preview-post>올릴 곳 단추를 누르면 그곳에 맞춘 글이 복사됩니다(출처·명시사항 포함).</p>
          <p class="admin-form-status" role="status" aria-live="polite" data-rt-preview-status></p>
          <button class="admin-secondary-button" type="button" data-rt-preview-print>종이로 뽑기(A4)</button>
          <a class="admin-text-link rt-preview__more" href={PROMO_PATH} data-rt-preview-link>크게 보기·글 미리 보기 <span aria-hidden="true">→</span></a>
        </div>
      </aside>
      <!-- 단지 상세 칸(2026-11-25): 거래 줄을 누르면 연다. 1221px 이상은 미리보기 칸 자리에 겹치고, 1220px 이하는 화면 전체. 받은 자료는 화면 메모리에만 둔다. -->
      <dialog class="rt-detail" aria-labelledby="rt-detail-title" data-rt-detail>
        <div class="rt-detail__head">
          <div class="rt-detail__titles">
            <p class="rt-detail__kicker">단지 상세 · 매매</p>
            <h2 class="rt-detail__title" id="rt-detail-title" tabindex="-1" data-rt-detail-title>단지 상세</h2>
            <p class="rt-detail__sub" data-rt-detail-sub hidden></p>
          </div>
          <button class="rt-detail__x" type="button" aria-label="단지 상세 닫기" data-rt-detail-close><span aria-hidden="true">×</span></button>
        </div>
        <div class="rt-detail__body" data-rt-detail-body>
          <p class="rt-loading" role="status" data-rt-detail-loading>단지 상세를 불러오고 있습니다…</p>
          <p class="rt-detail__msg" role="status" data-rt-detail-msg hidden></p>
          <div class="rt-detail__content" data-rt-detail-content hidden>
            <div class="rt-detail__tabs" role="group" aria-label="전용면적 고르기" data-rt-detail-tabs></div>
            <section class="rt-detail__latest" aria-labelledby="rt-detail-latest-title">
              <h3 class="rt-detail__h" id="rt-detail-latest-title">이 면적 최근 거래</h3>
              <p class="rt-detail__price"><strong data-rt-detail-price></strong><span class="rt-tag rt-detail__high" data-rt-detail-high hidden>신고가</span></p>
              <p class="rt-detail__meta" data-rt-detail-meta></p>
              <p class="rt-detail__prev"><span data-rt-detail-prev></span> <b class="rt-detail__change" data-rt-detail-change hidden></b></p>
            </section>
            <dl class="rt-detail__stats" data-rt-detail-stats></dl>
            <section class="rt-detail__flow" aria-labelledby="rt-detail-flow-title">
              <h3 class="rt-detail__h" id="rt-detail-flow-title">가격 흐름(36개월)</h3>
              <div class="rt-detail__chart" data-rt-detail-chart></div>
              <div class="rt-detail__ticks" aria-hidden="true" data-rt-detail-ticks></div>
              <p class="rt-detail__note-line" data-rt-detail-flow-note></p>
            </section>
            <section class="rt-detail__recent-box" aria-labelledby="rt-detail-recent-title">
              <h3 class="rt-detail__h" id="rt-detail-recent-title">최근 거래</h3>
              <ol class="rt-detail__recent" data-rt-detail-recent></ol>
            </section>
            <p class="rt-detail__note-line" data-rt-detail-partial hidden></p>
            <p class="rt-detail__note-line">{COMPLEX_FLOW_RULE}</p>
          </div>
        </div>
        <div class="rt-detail__act">
          <p class="rt-detail__pick-note" data-rt-detail-pick-note hidden></p>
          <button class="admin-secondary-button" type="button" data-rt-detail-close>목록으로</button>
          <button class="admin-primary-button" type="button" aria-pressed="false" disabled data-rt-detail-pick>홍보물에 담기</button>
        </div>
        <p class="sr-only" role="status" data-rt-detail-live></p>
      </dialog>
    </div>
  </div>

  <script>
    import office from "../../../../data/office.json";
    import { renderPromoCard, type PromoCard, type PromoStyle } from "../../../../lib/work-realprice-card";
    import { getWorkSession, readWork, WorkApiError } from "../../../../lib/work-realprice-client";
    import { renderBackfillBars } from "../../../../lib/work-realprice-dom";
    import { todayInKorea } from "../../../../lib/work/legal-dates.mjs";
    import {
      DEFAULT_REALPRICE_FILTERS,
      REALPRICE_PERIODS,
      REALPRICE_VIEW_HIGH_PAGE_SIZE,
      REALPRICE_VIEW_MAJOR_DAYS,
      REALPRICE_VIEW_PAGE_SIZE,
      activeFilterLine,
      apiErrorText,
      chipText,
      cleanComplexQuery,
      dateText,
      emptyView,
      isDefaultFilters,
      kindLabel,
      kstLong,
      monthText,
      priceParts,
      sizeText,
      statusView,
      tradesQuery,
    } from "../../../../lib/work/realprice-view.mjs";
    import {
      PROMO_IDS_MAX,
      PROMO_PATH,
      PROMO_PLACES,
      PROMO_STYLE_DEFAULT,
      isPromoSelectable,
      isPromoStyle,
      promoCards,
      promoFileName,
      promoHref,
      promoSteps,
      promoTexts,
      promoUpText,
      selectionText,
      takeButtonView,
      takeResultText,
      takeVisible,
      textCount,
    } from "../../../../lib/work/realprice-promo.mjs";
    import { loadPromoTrades } from "../../../../lib/work/realprice-promo-load.mjs";
    import { formatKoreanWon } from "../../../../lib/work/work-format.mjs";
    import { INSIGHT_BUDGET_NOTICE, INSIGHT_ERROR_NOTICE, insightBatches, insightView, isInsightCandidate, sparkGeometry } from "../../../../lib/work/realprice-insight-view.mjs";
    import { canOpenComplex } from "../../../../lib/work/realprice-complex-view.mjs";
    import { setupComplexDetail, type ComplexArea, type ComplexResponse } from "../../../../lib/work-realprice-detail";

    interface Trade {
      tradeKey: string;
      kind: "sale" | "rent" | "presale";
      dealDate: string;
      umdName: string;
      aptSeq: string | null;
      aptName: string | null;
      areaM2: number;
      floor: number | null;
      buildYear: number | null;
      priceWon: number | null;
      depositWon: number | null;
      monthlyRentWon: number | null;
      dealingGbn: "broker" | "direct" | null;
      cancelled: boolean;
      aptDong: string | null;
      recordHigh: boolean | null;
      prevMaxWon: number | null;
      isNew: boolean;
    }
    interface TradesResponse {
      items: Trade[];
      nextCursor: string | null;
      recordHighReady: boolean;
      warnings: { code: string; level?: string }[];
      major?: { since: string; days: number; top: number };
    }
    type Insight = { tradeKey: string; available: boolean; reason?: string; series?: { ym: string; medianWon: number | null; count: number }[] } & Record<string, unknown>;
    interface InsightsResponse {
      items: Insight[];
      missing: string[];
      warnings: { code: string; level?: string }[];
    }
    interface WatchResponse {
      version: number;
      items: { aptSeq: string; displayName: string; complexSlug: string | null }[];
    }
    type Filters = {
      period: string;
      kind: string;
      area: string;
      price: string;
      umd: string;
      excludeCancelled: boolean;
      excludeDirect: boolean;
      q: string;
      highOnly: boolean;
    };
    type Mode = "new" | "major" | "watch";
    type Status = Parameters<typeof statusView>[0];

    const root = document.querySelector<HTMLElement>("[data-rt-page]");
    if (root) {
      const pick = <T extends Element = HTMLElement>(selector: string) => root.querySelector<T>(selector) as T;
      const boot = pick("[data-rt-boot]");
      const statePanel = pick("[data-rt-state]");
      const sum = pick<HTMLDetailsElement>("[data-rt-sum]");
      const sumAction = pick("[data-rt-sum-action]");
      const backfill = pick("[data-rt-backfill]");
      const noData = pick("[data-rt-nodata]");
      const main = pick("[data-rt-main]");
      const watchLine = pick("[data-rt-watch-line]");
      const watchEmpty = pick("[data-rt-watch-empty]");
      const top = pick("[data-rt-top]");
      const qInput = pick<HTMLInputElement>("[data-rt-q]");
      const moreToggle = pick<HTMLButtonElement>("[data-rt-more-toggle]");
      const moreFilters = pick("[data-rt-more-filters]");
      const majorNote = pick("[data-rt-major-note]");
      const resetButton = pick<HTMLButtonElement>("[data-rt-reset]");
      const list = pick("[data-rt-list]");
      const listName = pick("[data-rt-list-name]");
      const onText = pick("[data-rt-on-text]");
      const clearAll = pick<HTMLButtonElement>("[data-rt-clear-all]");
      const takeButton = pick<HTMLButtonElement>("[data-rt-take]");
      const count = pick("[data-rt-count]");
      const countSuffixes = [...root.querySelectorAll<HTMLElement>("[data-rt-count-suffix]")];
      const notice = pick("[data-rt-notice]");
      const noticeText = pick("[data-rt-notice-text]");
      const criteria = [...root.querySelectorAll<HTMLElement>("[data-rt-criterion]")];
      const loading = pick("[data-rt-loading]");
      const skeleton = pick("[data-rt-skeleton]");
      const errorBox = pick("[data-rt-error]");
      const errorText = pick("[data-rt-error-text]");
      const zero = pick("[data-rt-zero]");
      const tableWrap = pick("[data-rt-table-wrap]");
      const rows = pick("[data-rt-rows]");
      const more = pick("[data-rt-more]");
      const moreButton = pick<HTMLButtonElement>("[data-rt-more-button]");
      const live = pick("[data-rt-live]");
      const pickBar = pick("[data-rt-pick-bar]");
      const pickText = pick("[data-rt-pick-text]");
      const promoLink = pick<HTMLAnchorElement>("[data-rt-promo-link]");
      const zeroTitle = pick("[data-rt-zero-title]");
      const zeroBody = pick("[data-rt-zero-body]");
      const zeroActions = pick("[data-rt-zero-actions]");

      let filters: Filters = { ...DEFAULT_REALPRICE_FILTERS };
      let mode: Mode = "new";
      // 지금 목록에 그린 거래('신고가만'이면 받은 거래 가운데 신고가만). '다 담기'는 이 순서로 담는다.
      let shown: Trade[] = [];
      let status: Status | null = null;
      let problem = false;
      let highInSum = false;
      let items: Trade[] = [];
      let cursor: string | null = null;
      let requestSeq = 0;
      let controller: AbortController | null = null;
      // 홍보물에 넣을 거래(P1-e): 이 화면 메모리에만 둔다(브라우저 저장 없음). 거르기·보기를 바꿔도 남고, 최대 PROMO_IDS_MAX건.
      const picked = new Map<string, Trade>();
      // 단지 상세 칸(2026-11-25). 아래 미리보기 칸을 만든 뒤 채운다.
      let detail: ReturnType<typeof setupComplexDetail> | null = null;
      // 거래 흐름(보드 63번): 받은 결과를 거래 ID로 이 화면 메모리에만 둔다(브라우저 저장·주소 없음). 거르기·쪽을 바꿔도 같은 ID는 다시 묻지 않는다.
      const insights = new Map<string, Insight>();
      let insightSeq = 0;
      let insightHigh = true;

      const show = (element: HTMLElement, visible: boolean) => { element.hidden = !visible; };
      const errorCode = (error: unknown) => (error instanceof WorkApiError ? error.code : null);

      function showState(title: string, body: string, { symbol = "!", retry = false } = {}) {
        boot.hidden = true;
        pick("[data-rt-state-symbol]").textContent = symbol;
        pick("[data-rt-state-title]").textContent = title;
        pick("[data-rt-state-body]").textContent = body;
        show(pick("[data-rt-state-retry]"), retry);
        statePanel.hidden = false;
      }

      function showBootError(error: unknown) {
        const code = errorCode(error);
        if (code === "REALPRICE_DISABLED") {
          showState("실거래가 탭이 아직 켜지지 않았습니다", "켜기 값을 등록하면 자료 받기와 목록이 켜집니다. 켜기 값 등록은 개발 담당이 합니다.", { symbol: "–" });
        } else if (code === "REALPRICE_CONFIG_MISSING") {
          showState("실거래가 설정이 빠져 있습니다", "자료를 받는 데 필요한 연결 설정 가운데 빠진 것이 있어 목록을 보일 수 없습니다. 개발 담당에게 '실거래가 설정 누락'이라고 알려 주세요. 받아 둔 자료는 지워지지 않았습니다.");
        } else {
          showState("실거래가를 불러오지 못했습니다", apiErrorText(code), { retry: code !== "AUTH_REQUIRED" });
        }
      }

      // 상태 한 줄은 휴대폰·PC 모두 접어 두고 문제가 있을 때만 펼쳐 둔다(D안, 2026-11-20 13:36:35). '더 보기' 거르기도 처음에는 접는다.
      function applyLayout() {
        sum.open = problem;
      }
      const syncActions = () => {
        sumAction.textContent = sum.open ? "접기" : "자세히";
      };
      sum.addEventListener("toggle", syncActions);

      function renderStatus(current: Status) {
        const view = statusView(current, { nowMs: Date.now(), todayKst: todayInKorea() });
        problem = Boolean(view.problem);
        sum.classList.toggle("rt-sum--warn", problem);
        show(pick("[data-rt-sum-warn]"), problem);
        pick("[data-rt-sum-badge]").textContent = view.problem?.stop ? "받기 멈춤" : "확인 필요";
        pick("[data-rt-sum-warn-text]").textContent = view.problem?.label ?? "";
        pick("[data-rt-sum-line]").textContent = view.line;
        const fill = pick("[data-rt-sum-fill]");
        fill.textContent = view.fill;
        show(fill, Boolean(view.fill));
        // 신고가 판정 준비 전: 979px 이하는 위 한 줄 끝("· 신고가는 채운 뒤")과 이 문장으로 알리고 목록 위 안내는 숨긴다(CSS). 980px 이상은 목록 위 안내 그대로.
        highInSum = view.fillHigh;
        const sumHigh = pick("[data-rt-sum-high]");
        sumHigh.textContent = highInSum ? highWaitText(current) : "";
        show(sumHigh, highInSum);
        pick("[data-rt-last]").textContent = view.lastLong;
        pick("[data-rt-range]").textContent = view.range;
        const badge = pick("[data-rt-badge]");
        badge.className = `admin-badge admin-badge--${view.badge.tone}`;
        badge.textContent = view.badge.text;
        const warn = pick("[data-rt-status-warn]");
        warn.textContent = view.problem
          ? `${view.problem.message}${view.problem.stop && current?.lastSuccessAt ? ` 아래 목록은 ${kstLong(current.lastSuccessAt)}까지 받은 자료입니다.` : ""}`
          : "";
        show(warn, problem);
        sum.hidden = false;
        if (!view.totals.complete) renderBackfillBars(backfill, current);
        show(backfill, !view.totals.complete);
        return view;
      }

      // ── 목록 ──

      const cell = (className: string, label: string) => {
        const td = document.createElement("td");
        td.className = className;
        td.dataset.label = label;
        return td;
      };
      const srOnly = (text: string) => {
        const span = document.createElement("span");
        span.className = "sr-only";
        span.textContent = text;
        return span;
      };
      const tag = (text: string, className: string) => {
        const span = document.createElement("span");
        span.className = `rt-tag ${className}`;
        span.textContent = text;
        return span;
      };

      // 홍보물 담기 칸(2026-11-24 사용자 답 "화면 배치까지": 줄 맨 앞 체크칸): 해제된 거래는 담을 수 없다(설계서 22.10절). 다 담으면(최대 건수) 나머지 칸은 잠근다.
      // 진짜 체크 칸은 44px 칸 전체를 덮는 투명한 칸으로 두고(키보드 Space·화면 읽기는 체크 칸 그대로), 보이는 네모는 그림일 뿐이다(aria-hidden).
      function pickCell(item: Trade) {
        const td = cell("rt-pick", "담기");
        const label = document.createElement("label");
        label.className = "admin-review-select rt-pick-button";
        const box = document.createElement("input");
        box.type = "checkbox";
        box.value = item.tradeKey;
        box.autocomplete = "off";
        const selectable = isPromoSelectable(item);
        box.dataset.rtPick = selectable ? "on" : "off";
        box.checked = selectable && picked.has(item.tradeKey);
        box.disabled = !selectable || (!box.checked && picked.size >= PROMO_IDS_MAX);
        box.setAttribute("aria-label", `${item.aptName || "단지명 없음"} ${dateText(item.dealDate)} ${kindLabel(item)}${selectable ? " 홍보물에 담기" : " 해제된 거래라 홍보물에 담을 수 없음"}`);
        const mark = document.createElement("span");
        mark.className = "rt-pick-mark";
        mark.setAttribute("aria-hidden", "true");
        label.append(box, mark);
        td.append(label);
        return td;
      }

      // '다 담기' 단추: 보이는 거래·남은 자리·담은 수에 맞춘 글자(realprice-promo.mjs takeButtonView). 보이는 거래가 없으면 숨긴다.
      function syncTake() {
        const view = takeButtonView(shown, new Set(picked.keys()));
        takeButton.textContent = view.text;
        takeButton.disabled = view.disabled;
        takeButton.hidden = shown.length === 0;
      }

      function syncPicks() {
        const full = picked.size >= PROMO_IDS_MAX;
        for (const box of rows.querySelectorAll<HTMLInputElement>("input[data-rt-pick]")) {
          if (box.dataset.rtPick !== "on") continue;
          box.checked = picked.has(box.value);
          box.disabled = !box.checked && full;
        }
        pickText.textContent = selectionText(picked.size);
        const href = promoHref([...picked.keys()]);
        if (href) promoLink.href = href;
        pickBar.hidden = picked.size === 0;
        syncTake();
        schedulePreview();
        detail?.syncPick();
      }
      rows.addEventListener("change", (event) => {
        const box = event.target as HTMLInputElement;
        if (box.dataset.rtPick !== "on") return;
        const item = items.find((trade) => trade.tradeKey === box.value);
        if (box.checked && item && picked.size < PROMO_IDS_MAX) picked.set(box.value, item);
        else picked.delete(box.value);
        syncPicks();
        live.textContent = picked.size >= PROMO_IDS_MAX ? `${selectionText(picked.size)}. 더 담으려면 하나를 빼 주세요.` : selectionText(picked.size);
      });
      takeButton.addEventListener("click", () => {
        const { add, skippedCancelled } = takeVisible(shown, new Set(picked.keys()));
        for (const item of add) picked.set(item.tradeKey, item);
        syncPicks();
        live.textContent = takeResultText(add.length, skippedCancelled, picked.size);
      });
      pick("[data-rt-pick-clear]").addEventListener("click", () => {
        picked.clear();
        syncPicks();
        live.textContent = "담은 거래를 비웠습니다.";
      });
      // 막대 실제 높이를 아래 여백(admin.css의 scroll-padding-bottom)에 넘겨, Tab으로 옮긴 포커스가 막대 뒤로 숨지 않게 한다.
      if (typeof ResizeObserver === "function") {
        new ResizeObserver(() => {
          if (pickBar.hidden) return;
          document.documentElement.style.setProperty("--rt-pick-bar-h", `${Math.ceil(pickBar.getBoundingClientRect().height)}px`);
        }).observe(pickBar);
      }

      // ── 오른쪽 미리보기 칸(D-3, 1221px 이상만) ──
      // 담은 거래가 바뀌면 잠깐 기다렸다가(연달아 담기) 공용 모듈로 ids를 다시 읽고(해제 거래 빼기·명시사항 빈 칸 막기), 지금 홍보물 화면과 같은 카드를 그린다.
      // 칸이 보이지 않으면(1220px 이하, CSS가 숨김) 부르지 않고, 넓혀서 보이게 되면 그때 그린다. 그림은 data 주소(CSP img-src에 blob 없음)이고, 서버 값은 textContent·속성으로만 넣는다.
      type PromoKind = "instagram" | "threads" | "blog" | "kakao";
      // 2026-11-24 사용자 답: '어디에 올릴까요?' 대신 카드 모양 4개(처음 '기본')와 올릴 곳 단추 4개(누르면 그곳 글 복사, '✓ 복사됨').
      const preview = pick("[data-rt-preview]");
      const previewShown = () => preview.getClientRects().length > 0;
      const previewCount = pick("[data-rt-preview-count]");
      const previewWhere = pick("[data-rt-preview-where]");
      const previewEmpty = pick("[data-rt-preview-empty]");
      const previewLoading = pick("[data-rt-preview-loading]");
      const previewNotice = pick("[data-rt-preview-notice]");
      const previewBlocked = pick("[data-rt-preview-blocked]");
      const previewRetry = pick<HTMLButtonElement>("[data-rt-preview-retry]");
      const previewCards = pick("[data-rt-preview-cards]");
      const previewWarn = pick("[data-rt-preview-warn]");
      const previewAct = pick("[data-rt-preview-act]");
      const previewDownloads = pick("[data-rt-preview-downloads]");
      const previewCopyButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-rt-preview-copy]")];
      const previewPost = pick("[data-rt-preview-post]");
      const previewStatus = pick("[data-rt-preview-status]");
      const previewLink = pick<HTMLAnchorElement>("[data-rt-preview-link]");
      const promoKindNames = Object.fromEntries(PROMO_PLACES) as Record<PromoKind, string>;
      let previewKey = "";
      let previewStyleKey = "";
      // 같은 거래를 모양만 바꿔 다시 그릴 때는 서버를 다시 부르지 않는다(받은 자료·흐름을 이 화면 메모리에만 둠).
      let previewLoaded: { input: { items: unknown; receivedAt: unknown; office: unknown; insights?: Record<string, unknown> }; flow: Record<string, unknown>; count: number } | null = null;
      let previewSeq = 0;
      let previewTimer = 0;
      let previewTexts: Record<PromoKind, string> | null = null;
      let previewImages: { src: string; alt: string }[] = [];

      function schedulePreview() {
        window.clearTimeout(previewTimer);
        previewTimer = window.setTimeout(() => void renderPreview(), 250);
      }
      if (typeof ResizeObserver === "function") new ResizeObserver(() => { if (previewShown()) schedulePreview(); }).observe(preview);

      // ── 단지 상세 칸(2026-11-25) ──
      // 거래 줄(표·카드)을 누르거나 단지 이름 단추를 누르면 연다. 담기 체크칸·흐름 펼치기·링크·단추를 누른 것은 그것만 한다.
      // '홍보물에 담기'는 목록 체크칸과 같은 picked(최대 PROMO_IDS_MAX건, 해제 거래 제외)를 쓰고, 담은 거래가 목록에 없으면 칸의 자료로 담는다(홍보물·미리보기는 ID로 다시 읽음).
      detail = setupComplexDetail({
        dialog: pick<HTMLDialogElement>("[data-rt-detail]"),
        preview,
        previewShown,
        pick: {
          max: PROMO_IDS_MAX,
          has: (tradeKey) => picked.has(tradeKey),
          count: () => picked.size,
          toggle: (data: ComplexResponse, area: ComplexArea) => {
            const latest = area.latest;
            if (!latest) return "";
            if (picked.has(latest.tradeKey)) picked.delete(latest.tradeKey);
            else {
              const trade: Trade = items.find((item) => item.tradeKey === latest.tradeKey) ?? {
                tradeKey: latest.tradeKey, kind: "sale", dealDate: latest.dealDate, umdName: data.complex?.umdName ?? "", aptSeq: data.complex?.aptSeq ?? null,
                aptName: data.complex?.aptName ?? null, areaM2: area.areaM2, floor: latest.floor, buildYear: data.complex?.buildYear ?? null, priceWon: latest.priceWon,
                depositWon: null, monthlyRentWon: null, dealingGbn: latest.dealingGbn, cancelled: false, aptDong: null, recordHigh: latest.recordHigh, prevMaxWon: area.prevMaxWon, isNew: false,
              };
              if (!isPromoSelectable(trade) || picked.size >= PROMO_IDS_MAX) return selectionText(picked.size);
              picked.set(trade.tradeKey, trade);
            }
            syncPicks();
            return selectionText(picked.size);
          },
        },
      });
      if (typeof ResizeObserver === "function") new ResizeObserver(() => detail?.place()).observe(preview);
      rows.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        const opener = target.closest<HTMLButtonElement>("button[data-rt-open]");
        if (!opener && target.closest("input, label, button, a, summary, details, select")) return;
        const tr = target.closest<HTMLTableRowElement>("tr.is-openable");
        if (!tr) return;
        // 글자를 끌어 고른 것은 여는 것으로 보지 않는다.
        if (!opener && String(window.getSelection?.() ?? "") !== "") return;
        const item = items.find((trade) => trade.tradeKey === tr.dataset.rtKey);
        if (!item || !canOpenComplex(item)) return;
        detail?.open({ tradeKey: item.tradeKey, aptSeq: item.aptSeq as string, aptName: item.aptName, umdName: item.umdName, areaM2: item.areaM2 }, opener ?? tr.querySelector<HTMLButtonElement>("button[data-rt-open]"));
      });
      previewRetry.addEventListener("click", () => {
        previewKey = "";
        previewLoaded = null;
        void renderPreview();
      });

      const previewStyle = () => {
        const value = root.querySelector<HTMLInputElement>('input[name="rt-promo-style"]:checked')?.value;
        return (isPromoStyle(value) ? value : PROMO_STYLE_DEFAULT) as PromoStyle;
      };
      function resetPreviewCopied() {
        for (const button of previewCopyButtons) {
          button.classList.remove("is-done");
          const state = button.querySelector("[data-rt-preview-copy-state]");
          if (state) state.textContent = "글 복사";
        }
        previewStatus.textContent = "";
      }
      root.addEventListener("change", (event) => {
        if ((event.target as HTMLInputElement).name === "rt-promo-style") void renderPreview();
      });

      function showPreviewBlocked(text: string, canRetry: boolean) {
        previewLoading.hidden = true;
        pick("[data-rt-preview-blocked-text]").textContent = text;
        previewRetry.hidden = !canRetry;
        previewBlocked.hidden = false;
      }

      // 거래 흐름: 목록이 이미 받은 것은 다시 쓰고, 없는 매매만 한 번 묻는다. 못 받으면 그 거래는 흐름 없이 그린다(홍보물 화면과 같음).
      async function previewInsights(items: { tradeKey: string; kind: string }[]) {
        const found: Record<string, unknown> = {};
        const need: string[] = [];
        for (const item of items) {
          if (item.kind !== "sale") continue;
          const known = insights.get(item.tradeKey);
          if (known) found[item.tradeKey] = known;
          else need.push(item.tradeKey);
        }
        if (need.length === 0) return found;
        try {
          const data = await readWork<InsightsResponse>("/realprice/insights", `ids=${need.join(",")}`);
          for (const insight of data.items) {
            insights.set(insight.tradeKey, insight);
            found[insight.tradeKey] = insight;
          }
        } catch {
          // 흐름 없이 그린다.
        }
        return found;
      }

      async function renderPreview() {
        if (!previewShown()) return;
        const ids = [...picked.keys()];
        const key = ids.join(",");
        const style = previewStyle();
        if (key === previewKey && style === previewStyleKey) return;
        const reuse = key === previewKey && previewLoaded !== null;
        previewKey = key;
        previewStyleKey = style;
        const seq = ++previewSeq;
        previewCount.textContent = `담은 거래 ${ids.length}건`;
        previewLink.href = promoHref(ids) ?? PROMO_PATH;
        previewImages = [];
        previewCards.replaceChildren();
        previewDownloads.replaceChildren();
        previewWarn.hidden = true;
        previewBlocked.hidden = true;
        previewAct.hidden = true;
        resetPreviewCopied();
        if (!reuse) {
          previewTexts = null;
          previewLoaded = null;
          previewNotice.hidden = true;
          previewWhere.hidden = true;
        }
        previewEmpty.hidden = ids.length > 0;
        if (ids.length === 0) {
          previewLoading.hidden = true;
          return;
        }
        previewLoading.hidden = false;
        if (!reuse) {
          let loaded: Awaited<ReturnType<typeof loadPromoTrades>>;
          try {
            loaded = await loadPromoTrades(readWork, ids, office);
          } catch (error) {
            if (seq !== previewSeq) return;
            const code = errorCode(error);
            showPreviewBlocked(`담은 거래를 불러오지 못했습니다. ${apiErrorText(code)}`, code !== "AUTH_REQUIRED");
            return;
          }
          if (seq !== previewSeq) return;
          const { selection, input, blocked } = loaded;
          if (selection.notices.length > 0) {
            pick("[data-rt-preview-notice-text]").textContent = selection.notices.join(" ");
            previewNotice.hidden = false;
          }
          if (blocked) {
            showPreviewBlocked(blocked, selection.items.length > 0 && !selection.receivedAt);
            return;
          }
          const flow = await previewInsights(selection.items);
          if (seq !== previewSeq) return;
          // 글 4가지는 흐름을 받은 뒤 만든다(그린 흐름이 있을 때만 출처 줄 아래 흐름 기준 줄, 홍보물 화면과 같음, 2026-11-25).
          previewTexts = promoTexts({ ...input, insights: flow }) as Record<PromoKind, string>;
          previewLoaded = { input, flow, count: selection.items.length };
        }
        const { input, flow, count } = previewLoaded as NonNullable<typeof previewLoaded>;
        const cards = promoCards({ ...input, insights: flow, style }) as PromoCard[];
        const canvas = document.createElement("canvas");
        const today = todayInKorea();
        const figures: HTMLElement[] = [];
        const links: HTMLElement[] = [];
        const images: { src: string; alt: string }[] = [];
        let overflow = false;
        try {
          for (const [index, card] of cards.entries()) {
            const result = await renderPromoCard(canvas, card);
            if (seq !== previewSeq) return;
            overflow ||= result.overflow;
            const alt = `카드 그림${cards.length > 1 ? ` ${index + 1}/${cards.length}장` : ""}: ${card.title}`;
            const image = document.createElement("img");
            image.src = result.dataUrl;
            image.width = 540;
            image.height = 675;
            image.alt = alt;
            figures.push(image);
            images.push({ src: result.dataUrl, alt });
            const link = document.createElement("a");
            link.className = "work-primary-button rt-preview__save";
            link.href = result.dataUrl;
            link.download = promoFileName(today, index, cards.length);
            link.dataset.rtPreviewDownload = "";
            link.textContent = cards.length > 1 ? `${index + 1}장 저장` : "그림 저장";
            link.addEventListener("click", () => {
              link.textContent = `✓ ${cards.length > 1 ? `${index + 1}장` : "그림"} 저장함`;
              link.classList.add("is-done");
            });
            links.push(link);
          }
        } catch {
          if (seq !== previewSeq) return;
          showPreviewBlocked("카드 그림을 그리지 못했습니다. '크게 보기·글 미리 보기'에서 다시 만들어 주세요.", false);
          return;
        }
        previewImages = images;
        previewCards.replaceChildren(...figures);
        previewDownloads.replaceChildren(...links);
        pick("[data-rt-preview-size]").textContent = `1080×1350 PNG · ${cards.length}장`;
        previewCount.textContent = `담은 거래 ${count}건 · 그림 ${cards.length}장`;
        previewWarn.hidden = !overflow;
        previewLoading.hidden = true;
        previewWhere.hidden = false;
        previewAct.hidden = false;
      }

      // 올릴 곳 단추: 그 곳 글을 복사하고 '✓ 복사됨'으로 바꾼 뒤, 글자 수와 그 앱에서 할 일을 한 줄로 알린다(홍보물 화면과 같은 글).
      for (const button of previewCopyButtons) {
        button.addEventListener("click", async () => {
          if (!previewTexts) return;
          const kind = button.dataset.rtPreviewCopy as PromoKind;
          const name = promoKindNames[kind];
          const counted = textCount(kind, previewTexts[kind]);
          const steps = promoSteps(kind, { cardCount: previewImages.length || 1, counted });
          resetPreviewCopied();
          previewPost.textContent = `${steps.text} ${steps.post}`;
          try {
            await navigator.clipboard.writeText(previewTexts[kind]);
            button.classList.add("is-done");
            const state = button.querySelector("[data-rt-preview-copy-state]");
            if (state) state.textContent = "✓ 복사됨";
            previewStatus.textContent = `✓ ${name} 글을 복사했습니다.`;
            previewStatus.dataset.state = "success";
          } catch {
            previewStatus.textContent = "자동 복사가 막혔습니다. '크게 보기·글 미리 보기'에서 글을 골라 직접 복사해 주세요.";
            previewStatus.dataset.state = "error";
          }
        });
      }

      // 종이로 뽑기(A4): 누를 때만 인쇄용 판(.rt-print-sheet, 홍보물 화면과 같은 인쇄 CSS)을 붙였다가 인쇄가 끝나면 뗀다. 평소 목록 인쇄는 그대로다.
      pick<HTMLButtonElement>("[data-rt-preview-print]").addEventListener("click", async () => {
        if (previewImages.length === 0) return;
        for (const old of root.querySelectorAll(".rt-print-sheet")) old.remove();
        const sheet = document.createElement("div");
        sheet.className = "rt-print-sheet";
        sheet.dataset.count = String(previewImages.length);
        const printed = previewImages.map(({ src, alt }) => {
          const image = document.createElement("img");
          image.src = src;
          image.alt = alt;
          return image;
        });
        sheet.append(...printed);
        root.append(sheet);
        await Promise.all(printed.map((image) => image.decode().catch(() => undefined)));
        window.addEventListener("afterprint", () => sheet.remove(), { once: true });
        window.print();
      });

      // 서버 값은 모두 textContent로 넣는다(HTML로 해석하지 않음).
      function rowOf(item: Trade, showHigh: boolean) {
        const tr = document.createElement("tr");
        tr.className = item.cancelled ? "rt-row is-cancelled" : "rt-row";
        const high = showHigh && item.recordHigh === true;
        const name = cell("rt-name", "단지");
        const strong = document.createElement("strong");
        strong.textContent = item.aptName || "단지명 없음";
        // 단지 상세 칸(2026-11-25): 단지 번호가 있는 거래는 이름이 단추다(키보드·화면 읽기용). 줄의 다른 빈 곳을 눌러도 같은 칸이 열린다.
        if (canOpenComplex(item)) {
          const open = document.createElement("button");
          open.type = "button";
          open.className = "rt-name__open";
          open.dataset.rtOpen = item.tradeKey;
          open.setAttribute("aria-haspopup", "dialog");
          open.append(strong, srOnly(" 단지 상세 보기"));
          name.append(open);
          tr.classList.add("is-openable");
        } else name.append(strong);
        // 딱지(분양권·▲ 신고가)는 단지 이름 옆에 둔다(2026-11-24, 표·카드 같음).
        if (item.kind === "presale") name.append(tag("분양권", "rt-tag--presale"));
        if (high) name.append(tag("신고가", "rt-tag--high"));
        const sub = document.createElement("small");
        sub.className = "rt-name__sub rt-only-table";
        sub.textContent = [item.umdName, Number.isInteger(item.buildYear) ? `${item.buildYear}년` : ""].filter(Boolean).join(" · ");
        name.append(sub);
        const size = cell("rt-size", "전용면적·층");
        // 1221px 이상 표는 층·동을 전용면적 아래 작은 줄로 내린다(D-3, 미리보기 칸 자리). 글자는 그대로 "84.97㎡ · 10층 · 103동"이고 카드는 한 줄이다.
        const [areaPart, ...restParts] = sizeText(item).split(" · ");
        size.append(areaPart);
        if (restParts.length > 0) {
          const sep = document.createElement("span");
          sep.className = "rt-size__sep";
          sep.textContent = " · ";
          const rest = document.createElement("span");
          rest.className = "rt-size__rest";
          rest.textContent = restParts.join(" · ");
          size.append(sep, rest);
        }
        const price = cell("rt-price", "금액");
        const parts = priceParts(item);
        price.append(parts.main);
        if (parts.monthly) {
          const monthly = document.createElement("span");
          monthly.className = "rt-price__monthly";
          monthly.textContent = parts.monthly;
          price.append(" ", monthly);
        }
        const up = high ? promoUpText(item) : "";
        if (up) {
          const rise = document.createElement("small");
          rise.className = "rt-up";
          rise.textContent = up;
          rise.append(srOnly(" 앞선 최고보다"));
          price.append(rise);
        }
        if (high && Number.isSafeInteger(item.prevMaxWon)) {
          const prev = document.createElement("small");
          prev.className = "rt-prev";
          prev.textContent = `앞선 최고 ${formatKoreanWon(item.prevMaxWon)}`;
          price.append(prev);
        }
        const kind = cell("rt-kind rt-only-card", "거래");
        kind.append(kindLabel(item));
        if (item.dealingGbn === "direct") {
          const direct = document.createElement("small");
          direct.textContent = "직거래";
          kind.append(direct);
        }
        const flags = cell("rt-flags rt-only-card", "표시");
        if (item.cancelled) flags.append(tag("해제", "rt-tag--cancel"));
        if (item.isNew) flags.append(tag("새로 들어옴", "rt-tag--new rt-only-table"));
        const date = cell("rt-date", "계약일");
        date.textContent = dateText(item.dealDate);
        const umd = cell("rt-umd rt-only-card", "법정동");
        umd.textContent = item.umdName;
        const fresh = cell("rt-new rt-only-card", "새로 들어옴");
        if (item.isNew) fresh.append(tag("새로 들어옴", "rt-tag--new"));
        // 1221px 이상 표: 거래 종류·직거래·표시를 금액 아래 작은 줄로(거래 흐름 칸 자리를 내려고, 보드 63번). 카드는 위 칸 그대로.
        const meta = document.createElement("span");
        meta.className = "rt-price__meta rt-only-table";
        meta.append(item.dealingGbn === "direct" ? `${kindLabel(item)} · 직거래` : kindLabel(item));
        if (item.cancelled) meta.append(tag("해제", "rt-mtag rt-mtag--cancel"));
        if (item.isNew) meta.append(tag("새로 들어옴", "rt-mtag rt-mtag--new"));
        price.append(meta);
        const flow = cell("rt-flow rt-only-table", "흐름(12개월)");
        const last = cell("rt-last rt-only-table", "직전 거래");
        const ratio = cell("rt-ratio rt-only-table", "최고가 대비");
        const fold = cell("rt-flowcell rt-only-card", "흐름·직전 거래");
        tr.dataset.rtKey = item.tradeKey;
        tr.append(pickCell(item), name, size, price, kind, flags, flow, last, ratio, date, umd, fresh, fold);
        fillInsight(tr, item);
        return tr;
      }

      // ── 거래 흐름(보드 63번) ──

      const SVG_NS = "http://www.w3.org/2000/svg";
      const small = (text: string, className = "") => {
        const element = document.createElement("small");
        if (className) element.className = className;
        element.textContent = text;
        return element;
      };
      // 흐름선 그림(화면 읽기 프로그램에는 옆 글자로 알리고 그림은 숨김). 서버 숫자만 좌표로 쓴다.
      function sparkSvg(series: Insight["series"], prevYm: string | null, width: number, height: number) {
        const geo = sparkGeometry(series, { width, height, padX: 5, padTop: 5, padBottom: 5, prevYm });
        if (!geo) return null;
        const svg = document.createElementNS(SVG_NS, "svg");
        svg.setAttribute("class", "rt-spark");
        svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
        svg.setAttribute("width", String(width));
        svg.setAttribute("height", String(height));
        svg.setAttribute("aria-hidden", "true");
        svg.setAttribute("focusable", "false");
        const shape = (tag: string, attributes: Record<string, string | number>) => {
          const element = document.createElementNS(SVG_NS, tag);
          for (const [key, value] of Object.entries(attributes)) element.setAttribute(key, String(value));
          svg.append(element);
        };
        shape("path", { class: "rt-spark__area", d: geo.area });
        shape("path", { class: "rt-spark__line", d: geo.line });
        if (geo.prev) shape("circle", { class: "rt-spark__prev", cx: geo.prev.x, cy: geo.prev.y, r: 3.5 });
        shape("circle", { class: "rt-spark__end", cx: geo.end.x, cy: geo.end.y, r: 4 });
        return svg;
      }

      // 표 칸에만 까닭을 쓴다. 카드의 '흐름·직전 거래' 줄은 누를 것이 없으므로 비워 숨기고, 까닭은 목록 위 한 줄(신고가 준비 안내·showInsightNotice)로 알린다.
      const failNote = (tr: HTMLTableRowElement, reasonText: string) => {
        tr.querySelector<HTMLElement>(".rt-flow")?.replaceChildren(small(`흐름: ${reasonText}`, "rt-insight-note"));
        tr.querySelector<HTMLElement>(".rt-flowcell")?.replaceChildren();
      };

      // 한 줄의 흐름 칸 4개(표)와 펼치기 칸(카드)을 채운다. 결과가 아직 없으면 기다림 표시, 계산하지 않는 거래는 빈 칸 + 화면 읽기용 까닭.
      function fillInsight(tr: HTMLTableRowElement, item: Trade) {
        const [flow, last, ratio, fold] = [".rt-flow", ".rt-last", ".rt-ratio", ".rt-flowcell"].map((selector) => tr.querySelector<HTMLElement>(selector) as HTMLElement);
        if (!flow) return;
        for (const element of [flow, last, ratio, fold]) element.replaceChildren();
        flow.classList.remove("is-wait");
        if (!isInsightCandidate(item)) {
          flow.append(srOnly("흐름은 매매만 계산"));
          return;
        }
        const insight = insights.get(item.tradeKey);
        if (!insight) {
          flow.classList.add("is-wait");
          flow.append(srOnly("흐름 불러오는 중"));
          return;
        }
        const view = insightView(insight, { high: insightHigh && item.recordHigh === true });
        if (!view.available) {
          // 한도·준비 중·불러오지 못함은 뜻을 글자로 보인다(빈 칸·0으로 두지 않음). 매매가 아닌 까닭은 화면 읽기에만.
          if (["budget", "pending", "error"].includes(String(view.reason))) failNote(tr, String(view.reasonText));
          else flow.append(srOnly(`흐름: ${view.reasonText}`));
          return;
        }
        const chart = sparkSvg(insight.series, view.prevYm, 72, 34);
        flow.append(chart ?? small("한 달만 거래", "rt-insight-note"), srOnly(view.chartNote ? String(view.chartNote) : `최근 12개월 가운데 거래 있는 달 ${view.months}개`), small(`3개월 ${view.recentText}`, "rt-flow__count"));
        if (view.prevPrice) {
          const won = document.createElement("span");
          won.className = "rt-last__won";
          // 표 칸은 '앞선 최고 …만'처럼 '원'을 뺀다(1221px 넓은 글꼴에서 표가 넘치지 않게). 카드 펼침 줄은 '원'까지 쓴다.
          won.textContent = String(view.prevPrice).replace(/ 원$/u, "");
          last.append(won, small(String(view.prevSub)));
        }
        else last.append(small("직전 거래 없음", "rt-insight-note"));
        const strong = document.createElement("strong");
        strong.textContent = String(view.ratioText);
        ratio.append(strong);
        if (view.maxText) ratio.append(small(`앞선 최고 ${String(view.maxText).replace(/ 원$/u, "")}`));
        // 카드: '흐름·직전 거래'를 누르면 흐름선·직전 거래·칸 3개를 펼친다(처음에는 접힘).
        const details = document.createElement("details");
        details.className = "rt-flowfold";
        const summary = document.createElement("summary");
        summary.textContent = String(view.summary);
        const box = document.createElement("div");
        box.className = "rt-flowfold__box";
        const wide = sparkSvg(insight.series, view.prevYm, 320, 64);
        wide?.removeAttribute("width");
        wide?.removeAttribute("height");
        box.append(wide ?? small(String(view.chartNote), "rt-insight-note"));
        const prevLine = document.createElement("p");
        prevLine.className = "rt-flowfold__prev";
        prevLine.textContent = `${view.prevPrice ? "○ " : ""}${view.prevLine}`;
        const mini = document.createElement("dl");
        mini.className = "rt-mini3";
        for (const [label, value] of [["앞선 최고", view.maxText ? String(view.maxText).replace(/ 원$/u, "") : "없음"], ["최고가 대비", view.ratioText], ["최근 3개월", view.recentText]]) {
          const group = document.createElement("div");
          const dt = document.createElement("dt");
          dt.textContent = String(label);
          const dd = document.createElement("dd");
          dd.textContent = String(value);
          group.append(dt, dd);
          mini.append(group);
        }
        box.append(prevLine, mini, small("같은 단지·같은 전용면적. 흐름선은 월별 가운데 값, 최고·직전은 실제 거래(계약일 기준).", "rt-flowfold__basis"));
        details.append(summary, box);
        fold.append(details);
      }

      function fillInsights() {
        for (const tr of rows.querySelectorAll<HTMLTableRowElement>("tr[data-rt-key]")) {
          const item = shown.find((trade) => trade.tradeKey === tr.dataset.rtKey);
          if (item) fillInsight(tr, item);
        }
      }

      // 지금 보이는 매매 가운데 아직 모르는 ID만 30개씩 묻는다. 그사이 목록이 바뀌면 남은 묶음은 묻지 않는다(받은 결과는 남겨 다시 씀).
      async function loadInsights() {
        const seq = ++insightSeq;
        if (shown.some((item) => insights.get(item.tradeKey)?.reason === "budget")) showInsightNotice(INSIGHT_BUDGET_NOTICE);
        for (const ids of insightBatches(shown, insights)) {
          if (seq !== insightSeq) return;
          try {
            const data = await readWork<InsightsResponse>("/realprice/insights", `ids=${ids.join(",")}`);
            for (const insight of data.items) insights.set(insight.tradeKey, insight);
            for (const id of data.missing) insights.set(id, { tradeKey: id, available: false, reason: "error" });
            if (data.warnings.some((warning) => warning.code === "RT_READ_BUDGET")) showInsightNotice(INSIGHT_BUDGET_NOTICE);
            fillInsights();
          } catch (error) {
            // 하루 끝 상한(429)은 이 화면에서 다시 묻지 않고, 그 밖의 실패는 다음에 목록을 그릴 때 다시 묻는다.
            if (errorCode(error) === "RT_READ_BUDGET") {
              for (const id of ids) insights.set(id, { tradeKey: id, available: false, reason: "budget" });
              showInsightNotice(INSIGHT_BUDGET_NOTICE);
              fillInsights();
              continue;
            }
            if (seq !== insightSeq) return;
            for (const id of ids) {
              const tr = rows.querySelector<HTMLTableRowElement>(`tr[data-rt-key="${CSS.escape(id)}"]`);
              if (tr) {
                tr.querySelector(".rt-flow")?.classList.remove("is-wait");
                failNote(tr, "불러오지 못함");
              }
            }
            showInsightNotice(INSIGHT_ERROR_NOTICE);
          }
        }
      }

      // 흐름 표시를 한도로 껐거나 불러오지 못했을 때 목록 위 안내(신고가 안내가 이미 있으면 그 안내를 그대로 둔다).
      function showInsightNotice(text: string) {
        if (!notice.hidden) return;
        noticeText.textContent = text;
        notice.hidden = false;
      }

      // 목록 이름(새 거래·주요 거래·관심 단지 거래)은 보기 3칸에 이미 보이므로 화면 읽기 프로그램에만 읽힌다(제목은 'n건 보는 중').
      function setListTitle(text: string) {
        listName.textContent = text;
      }

      const pageSize = () => (filters.highOnly ? REALPRICE_VIEW_HIGH_PAGE_SIZE : REALPRICE_VIEW_PAGE_SIZE);
      const moreText = () => `${pageSize()}건 더 보기`;

      function setListBusy(busy: boolean) {
        list.setAttribute("aria-busy", busy ? "true" : "false");
        show(loading, busy);
        show(skeleton, busy);
        for (const suffix of countSuffixes) suffix.hidden = busy;
        if (busy) {
          count.textContent = "불러오는 중";
          shown = [];
          for (const element of [errorBox, zero, tableWrap, more, notice, takeButton]) element.hidden = true;
        }
      }

      // 0건 글자·단추(realprice-view.mjs emptyView). 단추는 data-rt-zero-action으로 아래 한 곳에서 처리한다.
      function renderEmpty(highUnavailable: boolean) {
        const view = emptyView(filters, { major: mode === "major", loaded: items.length, highUnavailable });
        zeroTitle.textContent = view.title;
        zeroBody.textContent = view.body;
        zeroActions.replaceChildren(...view.actions.map(({ action, label }) => {
          const button = document.createElement("button");
          button.type = "button";
          button.dataset.rtZeroAction = action;
          button.textContent = label;
          return button;
        }));
      }

      function highWaitText(current: Status | null) {
        const through = current?.coveredThrough ? `, 지금 ${monthText(current.coveredThrough)}까지` : "";
        return `신고가 판정 준비 중(매매 과거 자료 채우는 중${through}). 과거 자료가 빠진 채 표시하면 신고가가 아닌 거래를 신고가로 보일 수 있어 다 채운 뒤 표시합니다. 흐름·직전 거래도 그때 함께 보입니다.`;
      }

      function renderNotice(data: TradesResponse) {
        let text = "";
        if (!data.recordHighReady) {
          text = highWaitText(status);
        } else if (data.warnings.some((warning) => warning.code === "RT_READ_BUDGET")) {
          text = "오늘 조회가 많아 신고가 표시를 잠시 껐습니다. 한국 시각 오전 9시 뒤에 다시 보입니다. 목록은 그대로 볼 수 있습니다.";
        }
        noticeText.textContent = text;
        show(notice, Boolean(text));
        notice.classList.toggle("rt-notice--in-sum", !data.recordHighReady && highInSum);
        const showHigh = !text;
        for (const element of criteria) element.hidden = !showHigh;
        return showHigh;
      }

      // '켜짐' 줄과 '모두 끄기'. 신고가만이면 몇 건 가운데서 골랐는지도 쓴다.
      function renderOnLine() {
        const line = activeFilterLine(filters, { major: mode === "major" });
        onText.textContent = filters.highOnly && items.length > 0 ? `${line} · 불러온 ${items.length.toLocaleString("ko-KR")}건 가운데` : line;
        clearAll.hidden = isDefaultFilters(filters);
      }

      function renderList(data: TradesResponse, appended: number) {
        setListBusy(false);
        const showHigh = renderNotice(data);
        // 고른 뒤 다시 받기로 해제된 거래는 고른 것에서 뺀다(홍보물 화면도 다시 읽을 때 한 번 더 뺀다).
        for (const item of data.items) if (picked.has(item.tradeKey) && !isPromoSelectable(item)) picked.delete(item.tradeKey);
        // '신고가만'은 받은 거래에서 화면이 거른다(서버는 그대로, 2026-11-20 결정). 신고가 판정을 못 하는 때는 0건과 그 까닭을 보인다.
        shown = filters.highOnly ? (showHigh ? items.filter((item) => item.recordHigh === true) : []) : items;
        insightHigh = showHigh;
        rows.replaceChildren(...shown.map((item) => rowOf(item, showHigh)));
        syncPicks();
        void loadInsights();
        count.textContent = `${shown.length.toLocaleString("ko-KR")}건`;
        renderOnLine();
        show(tableWrap, shown.length > 0);
        show(zero, shown.length === 0);
        if (shown.length === 0) {
          renderEmpty(filters.highOnly && !showHigh);
          for (const element of criteria) element.hidden = true;
        }
        show(more, Boolean(cursor) && !(filters.highOnly && !showHigh));
        moreButton.disabled = false;
        moreButton.textContent = moreText();
        const highNote = filters.highOnly ? ` 그 가운데 신고가 ${shown.length}건을 보여 줍니다.` : "";
        live.textContent = appended > 0
          ? `${data.items.length}건을 더 불러왔습니다. 모두 ${items.length}건입니다.${highNote}`
          : filters.highOnly ? `${items.length}건을 불러왔습니다.${highNote}` : `${items.length}건을 보여 줍니다.`;
      }

      function renderListError(error: unknown) {
        setListBusy(false);
        const retryAt = error instanceof WorkApiError ? error.retryAt : null;
        errorText.textContent = apiErrorText(errorCode(error), { retryAt });
        count.textContent = "";
        for (const suffix of countSuffixes) suffix.hidden = true;
        errorBox.hidden = false;
        for (const element of [zero, more, notice, takeButton, ...criteria]) element.hidden = true;
        tableWrap.hidden = items.length === 0;
      }

      async function loadList({ append = false } = {}) {
        const request = ++requestSeq;
        controller?.abort();
        controller = new AbortController();
        if (append) {
          moreButton.disabled = true;
          moreButton.textContent = "불러오는 중…";
        } else {
          items = [];
          cursor = null;
          setListBusy(true);
        }
        try {
          const query = tradesQuery(filters, { watch: mode === "watch", major: mode === "major", cursor: append ? cursor : null, todayKst: todayInKorea() });
          const data = await readWork<TradesResponse>("/realprice/trades", query, controller.signal);
          if (request !== requestSeq) return;
          items = append ? [...items, ...data.items] : data.items;
          cursor = data.nextCursor;
          renderList(data, append ? data.items.length : 0);
        } catch (error) {
          if (request !== requestSeq || (error instanceof DOMException && error.name === "AbortError")) return;
          if (append) {
            moreButton.disabled = false;
            moreButton.textContent = moreText();
          }
          renderListError(error);
        }
      }

      // ── 보기·관심 단지 ──

      async function showMode() {
        const request = ++requestSeq;
        controller?.abort();
        setListTitle(mode === "watch" ? "관심 단지 거래" : mode === "major" ? "주요 거래" : "새 거래");
        watchLine.hidden = true;
        watchEmpty.hidden = true;
        top.hidden = false;
        list.hidden = false;
        syncFilterControls();
        if (mode !== "watch") {
          void loadList();
          return;
        }
        setListBusy(true);
        let watch: WatchResponse;
        try {
          watch = await readWork<WatchResponse>("/realprice/watch");
        } catch (error) {
          if (request !== requestSeq) return;
          renderListError(error);
          return;
        }
        if (request !== requestSeq) return;
        if (watch.items.length === 0) {
          setListBusy(false);
          top.hidden = true;
          moreFilters.hidden = true;
          moreToggle.setAttribute("aria-expanded", "false");
          list.hidden = true;
          watchEmpty.hidden = false;
          return;
        }
        pick("[data-rt-watch-names]").textContent = `관심 단지 ${watch.items.length}곳: ${watch.items.map((item) => item.displayName).join(" · ")}`;
        watchLine.hidden = false;
        void loadList();
      }

      for (const input of root.querySelectorAll<HTMLInputElement>('input[name="rt-mode"]')) {
        input.addEventListener("change", () => {
          if (!input.checked) return;
          mode = input.value === "watch" ? "watch" : input.value === "major" ? "major" : "new";
          void showMode();
        });
      }

      // ── 찾기·거르기 단추(P1-f D안) ──

      const filterInputs = [...root.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-rt-filter]")];
      const toggles = [...root.querySelectorAll<HTMLButtonElement>("[data-rt-toggle]")];
      const chipTexts = [...root.querySelectorAll<HTMLElement>("[data-rt-chip-text]")];
      // 주요 거래는 서버가 기간(최근 30일)·종류(매매)·해제·직거래를 정하므로 그 칸은 잠근다.
      const MAJOR_FIXED = new Set(["period", "kind", "excludeCancelled", "excludeDirect"]);
      // '더 보기' 안 칸(분양권만은 따로 단추가 있음) 가운데 켜진 것이 있으면 '더 보기' 단추도 켜짐으로 보인다.
      const moreSet = () => (filters.kind !== "all" && filters.kind !== "presale") || filters.umd !== "" || !filters.excludeCancelled || filters.excludeDirect;
      function syncFilterControls() {
        const major = mode === "major";
        for (const input of filterInputs) {
          const key = input.dataset.rtFilter as keyof Filters;
          if (input instanceof HTMLInputElement && input.type === "checkbox") input.checked = Boolean(filters[key]);
          else input.value = String(filters[key]);
          input.disabled = major && MAJOR_FIXED.has(key);
        }
        for (const span of chipTexts) {
          const key = span.dataset.rtChipText as "period" | "area" | "price";
          const view = chipText(key, String(filters[key]));
          const fixed = major && key === "period";
          span.textContent = fixed ? `최근 ${REALPRICE_VIEW_MAJOR_DAYS}일` : view.text;
          span.parentElement?.classList.toggle("is-set", view.set && !fixed);
        }
        for (const button of toggles) {
          const on = button.dataset.rtToggle === "highOnly" ? filters.highOnly : filters.kind === "presale";
          button.setAttribute("aria-pressed", on ? "true" : "false");
          button.disabled = major && button.dataset.rtToggle === "presale";
        }
        moreToggle.classList.toggle("is-set", moreSet());
        majorNote.hidden = !major;
        resetButton.disabled = isDefaultFilters(filters);
      }
      for (const input of filterInputs) {
        input.addEventListener("change", () => {
          const key = input.dataset.rtFilter as keyof Filters;
          filters = { ...filters, [key]: input instanceof HTMLInputElement && input.type === "checkbox" ? input.checked : input.value };
          syncFilterControls();
          void loadList();
        });
      }
      for (const button of toggles) {
        button.addEventListener("click", () => {
          if (button.dataset.rtToggle === "highOnly") filters = { ...filters, highOnly: !filters.highOnly };
          else filters = { ...filters, kind: filters.kind === "presale" ? "all" : "presale" };
          syncFilterControls();
          void loadList();
        });
      }
      moreToggle.addEventListener("click", () => {
        const open = moreFilters.hidden;
        moreFilters.hidden = !open;
        moreToggle.setAttribute("aria-expanded", open ? "true" : "false");
      });
      // 찾기: '찾기' 단추·Enter(한글 입력 조합 중 Enter는 빼고)로만 찾는다. 칸을 비우면(지우기 ×) 바로 찾는 말 없이 다시 부른다.
      function applyQuery() {
        const q = cleanComplexQuery(qInput.value) ?? "";
        if (q === filters.q) return;
        filters = { ...filters, q };
        syncFilterControls();
        void loadList();
      }
      pick("[data-rt-q-go]").addEventListener("click", applyQuery);
      qInput.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" || event.isComposing) return;
        event.preventDefault();
        applyQuery();
      });
      qInput.addEventListener("input", () => {
        if (qInput.value.trim() === "" && filters.q !== "") applyQuery();
      });
      const resetFilters = () => {
        filters = { ...DEFAULT_REALPRICE_FILTERS };
        qInput.value = "";
        syncFilterControls();
        void loadList();
      };
      resetButton.addEventListener("click", resetFilters);
      clearAll.addEventListener("click", resetFilters);
      zeroActions.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-rt-zero-action]");
        if (!button) return;
        const action = button.dataset.rtZeroAction;
        if (action === "reset") {
          resetFilters();
          return;
        }
        if (action === "high-off") filters = { ...filters, highOnly: false };
        else if (action === "period-max") filters = { ...filters, period: REALPRICE_PERIODS[REALPRICE_PERIODS.length - 1].value };
        else if (action === "q-clear") {
          filters = { ...filters, q: "" };
          qInput.value = "";
          qInput.focus();
        }
        syncFilterControls();
        void loadList();
      });
      moreButton.addEventListener("click", () => {
        if (cursor) void loadList({ append: true });
      });
      pick("[data-rt-retry]").addEventListener("click", () => void showMode());

      // ── 처음 불러오기: 세션(켜짐·설정) → 상태 → 목록 ──

      async function start() {
        statePanel.hidden = true;
        boot.hidden = false;
        try {
          const session = await getWorkSession({ refresh: true });
          if (!session.realpriceEnabled) throw new WorkApiError("disabled", { code: "REALPRICE_DISABLED" });
          status = await readWork<Status>("/realprice/status");
        } catch (error) {
          showBootError(error);
          return;
        }
        boot.hidden = true;
        const view = renderStatus(status);
        applyLayout();
        syncActions();
        if (view.empty) {
          noData.hidden = false;
          return;
        }
        main.hidden = false;
        syncFilterControls();
        void showMode();
      }
      pick("[data-rt-state-retry]").addEventListener("click", () => void start());

      void start();
    }
  </script>
</AdminLayout>
