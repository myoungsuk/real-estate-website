---
import AdminIcon from "../../../components/admin/AdminIcon.astro";
import AdminPageHelp from "../../../components/admin/AdminPageHelp.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";

const tools = [
  {
    href: "/admin/work/fee/",
    icon: "fee",
    tone: "navy",
    title: "중개보수 계산",
    description: "법정 상한 보수, 협의 요율 금액, 부가세를 한쪽 의뢰인 기준으로 계산합니다.",
  },
  {
    href: "/admin/work/messages/",
    icon: "message",
    tone: "rose",
    title: "안내 문자",
    description: "가계약·약정금 입금·계약일 안내 문장을 만들고 복사하거나 문자 앱으로 엽니다.",
  },
  {
    href: "/admin/work/schedule/",
    icon: "schedule",
    tone: "gold",
    title: "계약 일정",
    description: "거래신고·자금조달계획서·임대차 신고 기한을 계산하고 .ics 파일로 내려받습니다.",
  },
] as const;

---

<AdminLayout
  title="도구 모음 | 행복한부동산 관리자"
  description="중개보수 계산, 안내 문자, 계약 일정 계산을 모은 관리자 업무 도구입니다."
>
  <div class="work-ui work-home">
    <header class="work-home__header">
      <div>
        <p class="work-home__meta">
          계산·문장 도구는 저장하지 않음 <span aria-hidden="true">·</span> 손님·장부·할 일은 서버에 저장 <span aria-hidden="true">·</span> <span data-work-today>오늘</span>
        </p>
        <h1>도구 모음</h1>
        <p class="work-home__lead">상담과 계약 준비에 쓰는 계산·문구 도구입니다.</p>
      </div>
    </header>

    <AdminPageHelp page="/admin/work/" />

    {/* 지금 쓸 수 있는 도구 3개를 맨 위에 크게(사용자 선택 2026-11-18 CD1, F6-2). 보이는 순서와 키보드 순서가 같게 마크업 순서로 둔다. */}
    <section class="work-home__tools" aria-labelledby="work-tools-title">
      <h2 id="work-tools-title" class="sr-only">도구 바로가기</h2>
      <ul>
        {tools.map((tool) => (
          <li>
            <a class="work-tool-row" href={tool.href}>
              <span class="work-round-icon work-round-icon--large" data-tone={tool.tone}>
                <AdminIcon name={tool.icon} size={20} />
              </span>
              <span class="work-tool-row__text">
                <strong>{tool.title}</strong>
                <span>{tool.description}</span>
              </span>
              <AdminIcon name="chevron-right" size={18} />
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- 휴지통 바로가기(사용자 선택 2026-11-22 14:31:26). 개수를 싣지 않아 서버를 부르지 않으므로 이 화면의 탭 미리 그리기를 그대로 둔다. -->
    <nav class="tr-homelinks" aria-label="휴지통 바로가기"><a class="admin-text-link" href="/admin/work/trash/">휴지통 <small>지운 자료 7일 보관</small> <span aria-hidden="true">→</span></a></nav>

    <p class="work-home__notice">
      <AdminIcon name="shield" size={18} />
      <span>계산·문장 도구에는 손님 전화번호·주민등록번호를 넣지 마세요(손님 이름은 영수증 '받는 분'에만). 저장하지 않아 새로 고치거나 화면을 닫으면 입력값이 모두 사라집니다. 손님 이름·전화번호는 '손님' 화면에 남깁니다.</span>
    </p>

    <div class="work-home__grid">
      {/* 빈 '이번 달' 달력을 달력 화면 고리로 바꿈(사용자 답 2026-11-26 08:59:51). 서버를 부르지 않아 이 화면의 탭 미리 그리기를 그대로 둔다. */}
      <section class="work-card work-calendar-link" aria-labelledby="work-calendar-title">
        <div class="work-card__head">
          <span class="work-round-icon" data-tone="gold">
            <AdminIcon name="schedule" size={15} />
          </span>
          <h2 id="work-calendar-title">달력</h2>
        </div>
        <p class="work-calendar-link__lead">
          거래 일정(계약일·중도금·잔금·신고 기한), 날짜 있는 할 일, 직접 넣은 일정(집 보여 주기·상담·반복 일정)을 한 달 달력으로 봅니다. <small data-work-today-long></small>
        </p>
        <ul class="work-calendar-link__marks" aria-label="달력 표시">
          <li><span aria-hidden="true">◆</span> 돈 날짜</li>
          <li><span aria-hidden="true">▲</span> 기한</li>
          <li><span aria-hidden="true">●</span> 안내·상담</li>
          <li><span aria-hidden="true">■</span> 일상</li>
          <li><span aria-hidden="true">☐</span> 할 일</li>
        </ul>
        <a class="work-card__link" href="/admin/work/calendar/">
          달력 열기
          <AdminIcon name="chevron-right" size={16} />
        </a>
      </section>

      <div class="work-home__side">
        {/* 오늘까지(지난 것 포함) 열린 할 일 최대 5개. 읽기만 하고 끝내기는 할 일 화면에서 한다(시안 2026-11-22 13:22:11). */}
        <section class="work-card" aria-labelledby="work-todo-title" data-tk-home>
          <div class="work-card__head">
            <span class="work-round-icon" data-tone="rose">
              <AdminIcon name="check" size={15} />
            </span>
            <h2 id="work-todo-title">오늘 할 일</h2>
          </div>
          <p class="work-card__empty" role="status" data-tk-home-state>할 일을 불러오고 있습니다…</p>
          <ul class="tk-home" data-tk-home-list hidden></ul>
          <button class="work-secondary-button tk-home-retry" type="button" data-tk-home-retry hidden>다시 불러오기</button>
          <a class="work-card__link" href="/admin/work/tasks/" data-tk-home-link hidden>
            <span data-tk-home-link-text>할 일 화면으로</span>
            <AdminIcon name="chevron-right" size={16} />
          </a>
        </section>

        <section class="work-card" aria-labelledby="work-deadline-title">
          <div class="work-card__head">
            <span class="work-round-icon" data-tone="navy">
              <AdminIcon name="clock" size={15} />
            </span>
            <h2 id="work-deadline-title">다가오는 기한</h2>
          </div>
          <p class="work-card__empty">거래마다 저장한 기한은 달력과 대시보드 '다가오는 계약 일정'에 모입니다. 저장하지 않고 기한만 계산하려면 계약 일정 화면을 씁니다.</p>
          <a class="work-card__link" href="/admin/work/calendar/">
            달력에서 보기
            <AdminIcon name="chevron-right" size={16} />
          </a>
          <a class="work-card__link" href="/admin/work/schedule/">
            계약 일정 계산하기
            <AdminIcon name="chevron-right" size={16} />
          </a>
        </section>
      </div>
    </div>
  </div>

  <script>
    import { todayInKorea } from "../../../lib/work/legal-dates.mjs";

    // 머리의 오늘 날짜와 달력 고리 칸의 오늘 날짜(서버 요청 없음).
    const [todayYear, todayMonth, todayDay] = todayInKorea().split("-").map(Number);
    const weekdayNames = ["일", "월", "화", "수", "목", "금", "토"];
    const todayWeekday = weekdayNames[new Date(Date.UTC(todayYear, todayMonth - 1, todayDay)).getUTCDay()];
    document.querySelectorAll<HTMLElement>("[data-work-today]").forEach((element) => {
      element.textContent = `${todayYear}.${String(todayMonth).padStart(2, "0")}.${String(todayDay).padStart(2, "0")}(${todayWeekday})`;
    });
    document.querySelectorAll<HTMLElement>("[data-work-today-long]").forEach((element) => {
      element.textContent = `오늘은 ${todayMonth}월 ${todayDay}일 ${todayWeekday}요일입니다.`;
    });
  </script>

  <script>
    import { WorkApiError, getTaskSession, listTasks } from "../../../lib/work-tasks-client";
    import { homeItem } from "../../../lib/work-tasks-dom";
    import { todayInKorea } from "../../../lib/work/legal-dates.mjs";
    import { isRetryable } from "../../../lib/work/customers-view.mjs";
    import { TASK_HOME_SHOWN, TASK_PAGE_SIZE, homeLinkText, homeStateText, taskListQuery } from "../../../lib/work/tasks-view.mjs";

    // '오늘 할 일' 칸: 업무 세션이 켜져 있을 때만 오늘까지 열린 할 일을 부른다(꺼짐·구조 옛날·실패는 칸 안 한 줄).
    // 이 화면은 탭 미리 그리기(prerender) 목록에 있으므로, 미리 그리는 동안에는 부르지 않고 화면이 실제로 보인 뒤에 부른다.
    const card = document.querySelector<HTMLElement>("[data-tk-home]");
    const state = card?.querySelector<HTMLElement>("[data-tk-home-state]");
    const list = card?.querySelector<HTMLElement>("[data-tk-home-list]");
    const retry = card?.querySelector<HTMLButtonElement>("[data-tk-home-retry]");
    const link = card?.querySelector<HTMLAnchorElement>("[data-tk-home-link]");
    const linkText = card?.querySelector<HTMLElement>("[data-tk-home-link-text]");

    if (card && state && list && retry && link && linkText) {
      let token = 0;
      const show = (text: string, { canRetry = false } = {}) => {
        state.textContent = text;
        state.hidden = !text;
        retry.hidden = !canRetry;
      };
      async function loadHome() {
        const mine = ++token;
        const today = todayInKorea();
        list!.hidden = true;
        link!.hidden = true;
        show("할 일을 불러오고 있습니다…");
        try {
          const session = await getTaskSession({ refresh: true });
          if (mine !== token) return;
          if (!session.enabled) {
            show(homeStateText("WORK_DISABLED"));
            return;
          }
          const page = await listTasks(taskListQuery({ until: today, limit: TASK_PAGE_SIZE }));
          if (mine !== token) return;
          list!.replaceChildren(...page.items.slice(0, TASK_HOME_SHOWN).map((task) => homeItem(task, today)));
          list!.hidden = page.items.length === 0;
          show(page.items.length === 0 ? "오늘까지 할 일이 없습니다." : "");
          linkText!.textContent = homeLinkText(page.items.length, Boolean(page.nextCursor));
          link!.hidden = false;
        } catch (error) {
          if (mine !== token) return;
          const code = error instanceof WorkApiError ? error.code : null;
          show(homeStateText(code), { canRetry: code !== "WORK_DISABLED" && code !== "WORK_SCHEMA_OUTDATED" && isRetryable(code) });
        }
      }
      retry.addEventListener("click", () => void loadHome());
      const doc = document as Document & { prerendering?: boolean };
      if (doc.prerendering) document.addEventListener("prerenderingchange", () => void loadHome(), { once: true });
      else void loadHome();
      // 뒤로 가기 캐시에서 돌아오면 다시 부른다(그사이 끝낸 할 일이 남아 보이지 않게).
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) void loadHome();
      });
    }
  </script>
</AdminLayout>
