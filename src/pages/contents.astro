---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { publishedBlogContents, publishedYoutubeContents } from "../lib/content";
import { office } from "../lib/site";

const title = "대전 동구 지역 콘텐츠 | 행복한부동산";
const description = "행복한부동산이 운영하는 네이버 블로그와 유튜브의 대전 동구 지역 콘텐츠를 안내합니다.";
---

<BaseLayout {title} {description}>
  <PageIntro eyebrow="LOCAL CONTENT" title="블로그와 유튜브를 따로 확인하세요" description="읽을 지역 소식은 블로그에서, 현장 영상은 유튜브에서 구분해 볼 수 있습니다." />
  <section class="section" aria-labelledby="content-category-heading">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">콘텐츠 카테고리</p><h2 id="content-category-heading">원하는 방식으로 지역 정보를 확인하세요</h2></div></div>
      <div class="two-column content-category-grid">
        <article class="info-card content-category-card"><p class="eyebrow">NAVER BLOG</p><h3>블로그 {publishedBlogContents.length}건</h3><p>대전 동구와 리더스시티 소식을 글과 사진으로 확인합니다.</p><div><a class="button button--primary" href="/blog/">블로그 보기</a><a class="text-link" href={office.naverBlogUrl} target="_blank" rel="noopener noreferrer">네이버 원문 ↗</a></div></article>
        <article class="info-card content-category-card"><p class="eyebrow">YOUTUBE</p><h3>유튜브 {publishedYoutubeContents.length}건</h3><p>단지와 지역 현장을 자동재생 없이 필요한 영상만 골라 봅니다.</p><div><a class="button button--primary" href="/youtube/">유튜브 보기</a><a class="text-link" href={office.youtubeUrl} target="_blank" rel="noopener noreferrer">유튜브 채널 ↗</a></div></article>
      </div>
    </div>
  </section>
  <section class="section"><div class="shell source-notice"><p class="eyebrow">콘텐츠 원칙</p><h2>원문과 출처를 분명하게 연결합니다.</h2><div class="three-column"><article class="info-card"><h3>직접 선택</h3><p>실제 지역과 상담에 도움이 되는 글과 영상만 운영자가 선택합니다.</p></article><article class="info-card"><h3>원문 우선</h3><p>제목과 짧은 안내만 제공하고 자세한 내용은 공식 원문에서 확인합니다.</p></article><article class="info-card"><h3>과장 금지</h3><p>확정되지 않은 개발 계획과 시세를 사실처럼 단정하지 않습니다.</p></article></div></div></section>
</BaseLayout>
