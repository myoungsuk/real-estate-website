---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import ContactPanel from "../components/ContactPanel.astro";
import ExternalContentList from "../components/ExternalContentList.astro";
import { publishedBlogContents, publishedYoutubeContents } from "../lib/content";

const title = "대전 동구 지역 콘텐츠 | 행복한부동산";
const description = "행복한부동산이 운영하는 네이버 블로그와 유튜브의 대전 동구 지역 콘텐츠를 안내합니다.";
---

<BaseLayout {title} {description}>
  <PageIntro eyebrow="LOCAL CONTENT" title="대전 동구 지역 콘텐츠" description="홈페이지에 원문을 복제하지 않고, 운영자가 확인한 공식 블로그와 유튜브의 동구 지역 소식으로 연결합니다." />
  <section class="section" aria-labelledby="blog-content-heading">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">네이버 블로그</p><h2 id="blog-content-heading">THE BLOG</h2></div><p>운영자가 직접 고른 대전 동구와 리더스시티 소식을 원문으로 연결합니다.</p></div>
      <ExternalContentList items={publishedBlogContents} emptyLabel="공개할 블로그 글을 준비하고 있습니다." pageSize={9} />
    </div>
  </section>
  <section class="section section--soft" aria-labelledby="youtube-content-heading">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">유튜브</p><h2 id="youtube-content-heading">YOUTUBE</h2></div><p>자동재생 없이 썸네일과 설명을 보고 필요한 영상만 선택할 수 있습니다.</p></div>
      <ExternalContentList items={publishedYoutubeContents} emptyLabel="공개할 유튜브 영상을 준비하고 있습니다." pageSize={6} />
    </div>
  </section>
  <section class="section"><div class="shell source-notice"><p class="eyebrow">콘텐츠 원칙</p><h2>원문과 출처를 분명하게 연결합니다.</h2><div class="three-column"><article class="info-card"><h3>직접 선택</h3><p>실제 지역과 상담에 도움이 되는 글과 영상만 운영자가 선택합니다.</p></article><article class="info-card"><h3>원문 우선</h3><p>제목과 짧은 안내만 제공하고 자세한 내용은 공식 원문에서 확인합니다.</p></article><article class="info-card"><h3>과장 금지</h3><p>확정되지 않은 개발 계획과 시세를 사실처럼 단정하지 않습니다.</p></article></div></div></section>
  <ContactPanel />
</BaseLayout>
