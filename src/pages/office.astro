---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import ContactPanel from "../components/ContactPanel.astro";
import { emailHref, formatOfficeHours, office } from "../lib/site";

const title = "사무소 소개 | 대전 동구 행복한부동산";
const description = "대전 동구의 매물과 지역 정보를 직접 확인하고 판단 근거를 중심으로 상담하는 리더스시티행복한공인중개사사무소입니다.";
---

<BaseLayout {title} {description}>
  <PageIntro eyebrow="OFFICE" title="사무소 소개" description="리더스시티5블록 단지 내 상가를 거점으로 백진옥 대표가 대전 동구 지역 상담을 직접 안내합니다." />
  <section class="section">
    <div class="shell office-story">
      <figure class="representative-card">
        <img
          src="/images/office/representative-baek-jinok.webp"
          alt="리더스시티 행복한부동산 백진옥 대표"
          width="900"
          height="900"
        />
        <figcaption><strong>백진옥 대표</strong><span>공인중개사 · 직접 상담</span></figcaption>
      </figure>
      <article class="office-message">
        <p class="eyebrow">대표 인사말</p>
        <h2>충분히 비교하고<br />납득한 뒤 선택하세요.</h2>
        <div class="claim-strip claim-strip--office" aria-label="운영 현황">
          <ul>
            {office.publicClaims.items.map((claim) => <li><span>{claim.label}</span><strong>{claim.value}</strong></li>)}
          </ul>
        </div>
        {office.introduction.map((paragraph) => <p>{paragraph}</p>)}
      </article>
    </div>
  </section>
  <section class="section section--soft">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">상담 원칙</p><h2>편안하지만 꼼꼼하게</h2></div>
        <p>최신 정보와 전문성을 꾸준히 익히고, 고객님의 상황에 맞는 선택지를 이해하기 쉽게 설명합니다.</p>
      </div>
      <div class="three-column">
        <article class="info-card"><span>01</span><h3>동구 현장에 가까운 안내</h3><p>천동 사무소를 거점으로 대전 동구의 시세 변화와 동네 분위기, 매물 정보를 가까이에서 확인합니다.</p></article>
        <article class="info-card"><span>02</span><h3>충분한 비교</h3><p>가격·면적·입주 조건을 비교하고, 급하게 결정하도록 재촉하지 않습니다.</p></article>
        <article class="info-card"><span>03</span><h3>공개 정보 안내</h3><p>네이버에 공개된 동·호수와 매물 조건은 그대로 안내하고, 의뢰인 연락처 등 개인정보는 공개하지 않습니다.</p></article>
      </div>
    </div>
  </section>
  <section class="section" aria-labelledby="office-gallery-heading">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">OFFICE PHOTO</p><h2 id="office-gallery-heading">편하게 상담받는 공간</h2></div>
        <p>단지 자료와 지역 지도를 함께 보며 조건을 차근차근 비교할 수 있습니다.</p>
      </div>
      <div class="office-gallery">
        <figure><img src="/images/office/office-interior.webp" alt="리더스시티 행복한부동산 사무실 내부 전경" width="1200" height="900" loading="lazy" /><figcaption>사무실 내부 전경</figcaption></figure>
        <figure><img src="/images/office/office-consultation.webp" alt="지역 지도와 단지 자료가 준비된 상담 공간" width="1200" height="900" loading="lazy" /><figcaption>지역·단지 자료 상담 공간</figcaption></figure>
        <figure><img src="/images/office/office-meeting-room.webp" alt="햇빛이 드는 편안한 상담 테이블" width="1200" height="900" loading="lazy" /><figcaption>편안하게 비교하는 상담 테이블</figcaption></figure>
      </div>
    </div>
  </section>
  <section class="section section--navy">
    <div class="shell office-facts">
      <div><p class="eyebrow">등록 정보</p><h2>확인 가능한 사무소 정보</h2></div>
      <dl>
        <div><dt>법적 상호</dt><dd>{office.legalName}</dd></div>
        <div><dt>대표자</dt><dd>{office.representative}</dd></div>
        <div><dt>등록번호</dt><dd>{office.registrationNumber}</dd></div>
        <div><dt>사업자등록번호</dt><dd>{office.businessNumber}</dd></div>
        <div><dt>소재지</dt><dd>{office.address}</dd></div>
        <div><dt>연락처</dt><dd>{office.mobile}</dd></div>
        <div><dt>이메일</dt><dd><a href={emailHref}>{office.email}</a></dd></div>
        <div>
          <dt>영업시간</dt>
          <dd class="office-hours">
            {office.hours.map((hour) => <span><b>{hour.label}</b> {formatOfficeHours(hour)}</span>)}
          </dd>
        </div>
        <div><dt>주차</dt><dd>{office.parking}</dd></div>
      </dl>
    </div>
  </section>
  <ContactPanel />
</BaseLayout>
