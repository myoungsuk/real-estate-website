---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import ContactPanel from "../../components/ContactPanel.astro";
import complexes from "../../data/complexes.json";

export function getStaticPaths() {
  return complexes.map((complex) => ({ params: { slug: complex.slug }, props: { complex } }));
}

const { complex } = Astro.props;
const title = `${complex.name} 단지정보·매물 | 대전 동구 행복한부동산`;
const description = `${complex.name}의 확인된 단지 정보와 공개 매물을 안내합니다.`;
---

<BaseLayout {title} {description}>
  <PageIntro eyebrow={`${complex.areaName} · ${complex.eyebrow}`} title={complex.name} description="공식 자료와 현장 확인을 마친 내용부터 공개합니다." />
  <section class="section">
    <div class="shell two-column two-column--wide">
      <article class="statement-card statement-card--number">
        <span>{complex.mark}</span>
        <p>{complex.areaName} · {complex.eyebrow}</p>
      </article>
      <div class="preparing-copy">
        <p class="eyebrow">단지 이야기</p>
        <h2>{complex.introTitle}</h2>
        <p>{complex.summary}</p>
        {complex.introduction.map((paragraph) => <p>{paragraph}</p>)}
        <a class="button button--secondary" href={`/properties/?area=${complex.areaSlug}`}>{complex.areaName} 매물 보기</a>
      </div>
    </div>
  </section>
  <section class="section section--soft">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">공개 예정 정보</p><h2>확인 후 채워질 내용</h2></div><p>확인되지 않은 수치를 임시값으로 채우지 않습니다.</p></div>
      <div class="three-column">
        <article class="info-card"><h3>단지 기본</h3><p>세대수, 동수, 사용승인일, 면적형, 주차와 난방</p></article>
        <article class="info-card"><h3>생활 환경</h3><p>교통, 학교, 생활편의, 커뮤니티와 현장 동선</p></article>
        <article class="info-card"><h3>연결 정보</h3><p>공개 매물, 관련 블로그와 유튜브 원문 링크</p></article>
      </div>
    </div>
  </section>
  <ContactPanel title={`${complex.name} 조건을 직접 확인해 드립니다`} />
</BaseLayout>
