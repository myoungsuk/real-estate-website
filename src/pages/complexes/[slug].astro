---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import ContactPanel from "../../components/ContactPanel.astro";
import complexes from "../../data/complexes.json";

export function getStaticPaths() {
  return complexes.map((complex) => ({ params: { slug: complex.slug }, props: { complex } }));
}

const { complex } = Astro.props;
const title = `${complex.name} 단지정보·매물 | 천동 행복한부동산`;
const description = `${complex.name}의 확인된 단지 정보와 공개 매물을 안내합니다.`;
---

<BaseLayout {title} {description}>
  <PageIntro eyebrow={`LEADERS CITY ${complex.block}`} title={complex.name} description="공식 자료와 현장 확인을 마친 내용부터 공개합니다." />
  <section class="section">
    <div class="shell two-column two-column--wide">
      <article class="statement-card statement-card--number">
        <span>{complex.block}</span>
        <p>리더스시티</p>
      </article>
      <div class="preparing-copy">
        <p class="eyebrow">정보 확인 중</p>
        <h2>정확한 단지 자료를 준비하고 있습니다.</h2>
        <p>{complex.summary}</p>
        <p>세대수·면적형·주차·난방·학교·교통 등 숫자 정보는 출처와 기준일이 확인된 후 추가합니다. 현재 궁금한 내용은 전화나 문자로 직접 확인해 주세요.</p>
        <a class="button button--secondary" href="/properties/">이 블록 매물 보기</a>
      </div>
    </div>
  </section>
  <section class="section section--soft">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">공개 예정 정보</p><h2>확인 후 채워질 내용</h2></div><p>확인되지 않은 수치를 임시값으로 채우지 않습니다.</p></div>
      <div class="three-column">
        <article class="info-card"><h3>단지 기본</h3><p>세대수, 동수, 사용승인일, 면적형, 주차와 난방</p></article>
        <article class="info-card"><h3>생활 환경</h3><p>교통, 학교, 생활편의, 커뮤니티와 현장 동선</p></article>
        <article class="info-card"><h3>연결 정보</h3><p>공개 매물, 관련 블로그와 유튜브 원문 링크</p></article>
      </div>
    </div>
  </section>
  <ContactPanel title={`${complex.name} 조건을 직접 확인해 드립니다`} />
</BaseLayout>
