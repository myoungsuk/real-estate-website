---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import ContactPanel from "../../components/ContactPanel.astro";
import ExternalContentList from "../../components/ExternalContentList.astro";
import NaverListingCard from "../../components/NaverListingCard.astro";
import { getPublishedExternalContentsByIds } from "../../lib/content";
import { createComplexListingPreview, selectComplexListings } from "../../lib/complex-listings.mjs";
import { matchPublishedComplexByListingTitle, publishedComplexes } from "../../lib/complexes";
import { naverListings, naverListingsUpdatedAt } from "../../lib/naver-listings";
import { getResponsivePublicImageSrcSet } from "../../lib/responsive-images";

export function getStaticPaths() {
  return publishedComplexes.map((complex) => ({ params: { slug: complex.slug }, props: { complex } }));
}

const { complex } = Astro.props;
const title = complex.seo.title;
const description = complex.seo.description;
const relatedContents = getPublishedExternalContentsByIds(complex.relatedContentIds);
const relatedListings = selectComplexListings(naverListings, complex.slug, matchPublishedComplexByListingTitle);
const relatedListingPreview = createComplexListingPreview(relatedListings);
const visibleRelatedListings = relatedListingPreview.items;
const unitCategories = [...new Set(complex.unitGroups.map((unit) => unit.category))];
const maxUnitHouseholds = Math.max(1, ...complex.unitGroups.map((unit) => unit.households));
const amenitySource = complex.sources.find((source) => /관리시설/u.test(source.label));
const sinheungLivingLabels = ["단지 규모", "사용승인", "주차", "면적 구성"];
const amenityGalleryBySlug: Record<string, Array<{ src: string; alt: string; title: string; description: string }>> = {
  "sinheung-sk-view": [
    {
      src: "/images/area/sinheung-sk-view-community-center.webp",
      alt: "신흥 SK뷰 La VIEW Center 입구와 작은도서관·실내골프연습장 안내",
      title: "La VIEW Center",
      description: "작은도서관과 실내골프연습장 안내가 보이는 커뮤니티동 입구",
    },
    {
      src: "/images/area/sinheung-sk-view-rest-garden.webp",
      alt: "신흥 SK뷰 단지 중앙 정원의 수경시설과 휴게 공간",
      title: "단지 중앙 정원",
      description: "수경시설과 휴게 테이블이 어우러진 단지 조경 공간",
    },
    {
      src: "/images/area/sinheung-sk-view-playground.webp",
      alt: "신흥 SK뷰 펭귄 테마 어린이놀이터",
      title: "테마 어린이놀이터",
      description: "펭귄 조형물과 놀이시설이 있는 단지 내 어린이놀이터",
    },
  ],
};
const amenityGallery = amenityGalleryBySlug[complex.slug] ?? [];
const verificationLabels = {
  official: "공식 확인",
  "operator-confirmed": "운영자 확인",
  "historical-plan": "과거 자료 · 현재 확인 필요",
  "check-required": "현장 확인 필요",
};
---

<BaseLayout
  {title}
  {description}
  breadcrumbItems={[
    { name: "홈", path: "/" },
    { name: "단지 정보", path: "/complexes/" },
    { name: complex.name, path: `/complexes/${complex.slug}/` },
  ]}
>
  <PageIntro eyebrow={`${complex.areaName} · ${complex.eyebrow} ${complex.mark}`} title={complex.name} description={complex.summary} />

  <section class="section">
    <div class="shell complex-story">
      {complex.image && (
        <figure class="complex-story__image">
          <picture>
            <source media="(max-width: 699px)" srcset={complex.image.src.replace(/\.webp$/u, "-640.webp")} />
            <img
              src={complex.image.src}
              srcset={getResponsivePublicImageSrcSet(complex.image.src)}
              sizes="(min-width: 1180px) 550px, 48vw"
              alt={complex.image.alt}
              width="2000"
              height="2000"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
            />
          </picture>
          <figcaption>{complex.name} 단지 전경</figcaption>
        </figure>
      )}
      <div class="complex-story__copy">
        <p class="eyebrow">단지 이야기</p>
        <h2>{complex.introTitle}</h2>
        {complex.introduction.map((paragraph) => <p>{paragraph}</p>)}
        <a class="button button--secondary" href={`/properties/?complex=${complex.slug}`}>{complex.name} 매물 보기</a>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="complex-listing-summary-heading">
    <div class="shell contact-panel">
      <div>
        <p class="eyebrow">현재 공개 매물</p>
        <h2 id="complex-listing-summary-heading">현재 등록된 {complex.name} 매물 {relatedListings.length}건</h2>
        <p>매물 목록 업데이트 {naverListingsUpdatedAt.replaceAll("-", ".")} 기준입니다. 가격·면적·층·방향을 바로 비교해 보세요.</p>
      </div>
      <div class="contact-panel__actions">
        <a class="button button--primary" href={`/properties/?complex=${complex.slug}`}>{complex.name} 현재 매물 보기</a>
        <a class="button button--secondary" href="#contact">{complex.name} 조건 상담</a>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="complex-facts-heading">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">단지 기본정보</p><h2 id="complex-facts-heading">{complex.name} 한눈에 보기</h2></div>
        <p>공개자료 확인일 {complex.confirmedAt}</p>
      </div>
      <dl class="complex-fact-grid">
        {complex.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="complex-units-heading">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">세대 구성</p><h2 id="complex-units-heading">면적별 세대 구성</h2></div>
        <p>면적은 전용면적 ㎡를 기준으로 표시합니다.</p>
      </div>
      <div class="complex-supply-grid">
        {complex.supplySummary.map((supply) => (
          <article>
            <span>{supply.label}</span>
            <strong>{supply.value}</strong>
            {supply.description && <p>{supply.description}</p>}
          </article>
        ))}
      </div>
      <div class="complex-unit-groups">
        {unitCategories.map((category) => (
          <section class="complex-unit-group" aria-label={`${category} 전용면적별 세대수`}>
            <h3>{category}</h3>
            <div class="complex-unit-list">
              {complex.unitGroups.filter((unit) => unit.category === category).map((unit) => (
                <div class="complex-unit-row">
                  <div class="complex-unit-row__label"><span>{unit.areaLabel}</span><strong>{unit.households.toLocaleString("ko-KR")}세대</strong></div>
                  <div class="complex-unit-bar" aria-hidden="true"><span style={`--unit-width: ${(unit.households / maxUnitHouseholds) * 100}%`}></span></div>
                  {unit.note && <small>{unit.note}</small>}
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
      {complex.unitDataNote && <p class="complex-data-note">{complex.unitDataNote}</p>}
    </div>
  </section>

  <section class="section section--navy" aria-labelledby="complex-living-heading">
    <div class="shell">
      <div class="content-section-heading content-section-heading--light">
        <p>단지와 주변 생활</p>
        <h2 id="complex-living-heading">{complex.name} 핵심 포인트</h2>
      </div>
      <div class="complex-living-grid">
        {complex.livingSections.map((section, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <p>{complex.slug === "sinheung-sk-view" ? sinheungLivingLabels[index] : section.category.toUpperCase()}</p>
            <h3>{section.title}</h3>
            <div>{section.description}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="complex-amenities-heading">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">단지시설</p><h2 id="complex-amenities-heading">{complex.name} 단지시설</h2></div>
      </div>
      {amenityGallery.length > 0 && (
              <div class="complex-amenity-gallery" role="group" aria-label={`${complex.name} 단지시설 직접 촬영 사진`}>
          {amenityGallery.map((image) => (
            <figure>
              <img src={image.src} alt={image.alt} width="960" height="640" loading="lazy" decoding="async" />
              <figcaption>
                <small>직접 촬영</small>
                <strong>{image.title}</strong>
                <span>{image.description}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      )}
      <div class="complex-amenity-grid">
        {complex.amenityGroups.map((group) => (
          <article class="complex-amenity-card">
            <div class="complex-amenity-card__heading">
              <h3>{group.title}</h3>
              <span data-verification={group.verification}>{verificationLabels[group.verification]}</span>
            </div>
            <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
            {group.note && <p>{group.note}</p>}
          </article>
        ))}
      </div>
      {amenitySource && (
        <p class="section-more"><a class="button button--secondary" href={amenitySource.url} target="_blank" rel="noopener noreferrer">{amenitySource.publisher} 원문 보기</a></p>
      )}
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="complex-checkpoints-heading">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">매물 체크리스트</p><h2 id="complex-checkpoints-heading">{complex.name} 매물 볼 때 체크할 것</h2></div>
      </div>
      <ol class="complex-checkpoint-list">
        {complex.checkpoints.map((checkpoint) => (
          <li><div><strong>{checkpoint.title}</strong><p>{checkpoint.description}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="complex-faq-heading">
    <div class="shell complex-faq-layout">
      <div>
        <p class="eyebrow">자주 묻는 질문</p>
        <h2 id="complex-faq-heading">{complex.name} 자주 묻는 질문</h2>
        <p>현재 공개 매물 {relatedListings.length}건과 공식자료를 기준으로 정리했습니다.</p>
      </div>
      <div class="complex-faq-list">
        {complex.faqs.map((faq) => (
          <details>
            <summary>{faq.question}<span aria-hidden="true">+</span></summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="complex-current-listings-heading" aria-live="polite">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">네이버 등록 매물</p><h2 id="complex-current-listings-heading">{complex.name} 현재 공개 매물</h2></div>
        <p>매물 목록 업데이트 {naverListingsUpdatedAt.replaceAll("-", ".")}</p>
      </div>
      {visibleRelatedListings.length > 0 ? (
        <>
          <div class="listing-grid">
            {visibleRelatedListings.map((listing, index) => <NaverListingCard {listing} rank={index} compact />)}
          </div>
          {relatedListingPreview.hasMore && (
            <p class="section-more"><a class="button button--secondary" href={`/properties/?complex=${complex.slug}`}>전체 {relatedListingPreview.total}건 보기</a></p>
          )}
        </>
      ) : (
        <div class="empty-state">
          <span class="empty-state__number" aria-hidden="true">0</span>
          <div><h3>현재 공개 목록에 {complex.name} 매물이 없습니다</h3><p>찾는 거래유형, 면적, 예산과 입주시기를 알려주시면 현재 확인 가능한 조건부터 안내해 드립니다.</p></div>
          <div class="empty-state__actions"><a class="button button--primary" href="#contact">{complex.name} 조건 상담</a></div>
        </div>
      )}
    </div>
  </section>

  {relatedContents.length > 0 && (
    <section class="section section--soft" aria-labelledby="complex-related-heading">
      <div class="shell">
        <div class="section-heading">
          <div><p class="eyebrow">블로그·영상</p><h2 id="complex-related-heading">{complex.name} 더 자세히 보기</h2></div>
          <p>단지 소개와 내부 영상, 실거래 비교 콘텐츠를 원문에서 확인할 수 있습니다.</p>
        </div>
        <ExternalContentList items={relatedContents} pageSize={3} />
      </div>
    </section>
  )}

  <section class="section complex-sources-section">
    <div class="shell complex-sources">
      <div>
        <p class="eyebrow">자료 출처</p>
        <h2>확인한 공개자료</h2>
        <p>단지 규모, 사용승인일, 면적 구성, 주차와 시설 목록은 아래 공개자료에서 확인했습니다. 각 원문도 바로 열어볼 수 있습니다.</p>
      </div>
      <ul>
        {complex.sources.map((source) => (
          <li>
            <a href={source.url} target="_blank" rel="noopener noreferrer">
              <span><small>{source.publisher} · {source.checkedAt}</small>{source.label}{source.note && <em>{source.note}</em>}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div id="contact"><ContactPanel title={`${complex.name} 매물 상담`} description="원하는 거래유형, 예산, 면적과 입주시기를 알려주시면 현재 공개 매물부터 비교해 드립니다." /></div>
</BaseLayout>
