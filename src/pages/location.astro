---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import ContactPanel from "../components/ContactPanel.astro";
import { emailHref, formatOfficeHours, kakaoHref, office, phoneHref } from "../lib/site";

const title = "오시는 길 | 리더스시티행복한공인중개사사무소";
const description = `${office.address}에 위치한 리더스시티행복한공인중개사사무소의 주소와 연락처입니다.`;
---

<BaseLayout {title} {description} breadcrumbItems={[{ name: "홈", path: "/" }, { name: "오시는 길", path: "/location/" }]}>
  <PageIntro eyebrow="LOCATION" title="오시는 길" description="리더스시티5블록 단지 내 상가 주차장을 이용할 수 있습니다. 방문 전 연락해 주시면 더 편하게 상담받을 수 있습니다." />
  <section class="section">
    <div class="shell location-grid">
      <figure class="location-photo">
        <img src="/images/office/office-storefront.webp" alt="리더스시티 행복한 공인중개사 사무소 외부 간판과 출입구" width="900" height="1049" />
        <figcaption>리더스시티5블록 근린생활시설 105호</figcaption>
      </figure>
      <div class="location-copy">
        <p class="eyebrow">행복한부동산</p><h2>{office.legalName}</h2>
        <dl class="contact-details">
          <div><dt>주소</dt><dd>{office.address}</dd></div>
          <div><dt>대표</dt><dd>{office.representative}</dd></div>
          <div><dt>전화</dt><dd><a href={phoneHref}>{office.mobile}</a></dd></div>
          <div><dt>이메일</dt><dd><a href={emailHref}>{office.email}</a></dd></div>
          <div><dt>영업시간</dt><dd class="location-hours">{office.hours.map((hour) => <span><b>{hour.label}</b> {formatOfficeHours(hour)}</span>)}</dd></div>
          <div><dt>주차</dt><dd>{office.parking}</dd></div>
          <div><dt>등록번호</dt><dd>{office.registrationNumber}</dd></div>
        </dl>
        <div class="hero__actions">
          <a class="button button--primary" href={office.naverPlaceUrl} target="_blank" rel="noopener noreferrer">네이버지도에서 보기</a>
          <a class="button button--secondary" href={phoneHref}>전화하기</a>
          <a class="button button--kakao" href={kakaoHref} target="_blank" rel="noopener noreferrer">카카오톡 상담</a>
        </div>
      </div>
    </div>
  </section>
  <ContactPanel title="방문 전에 연락해 주세요" description="상담 중 자리를 비울 수 있어 전화·문자·카카오톡으로 미리 알려주시면 좋습니다." />
</BaseLayout>
