---
import BaseLayout from "../layouts/BaseLayout.astro";
import { phoneHref } from "../lib/site";

const title = "페이지를 찾을 수 없습니다 | 행복한부동산";
const description = "요청한 페이지가 이동되었거나 존재하지 않습니다.";
---

<BaseLayout {title} {description} noindex>
  <section class="section not-found"><div class="shell narrow-shell"><p class="eyebrow">404 ERROR</p><h1>페이지를 찾을 수 없습니다.</h1><p>주소가 변경되었거나 공개가 종료된 정보일 수 있습니다.</p><div class="hero__actions"><a class="button button--primary" href="/">홈으로 이동</a><a class="button button--secondary" href="/properties/">매물 보기</a><a class="text-link" href={phoneHref}>전화 문의</a></div></div></section>
</BaseLayout>
