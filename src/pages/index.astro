---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExternalContentList from "../components/ExternalContentList.astro";
import NaverListingPager from "../components/NaverListingPager.astro";
import { homeContent, publishedBlogContents, publishedYoutubeVideoContents } from "../lib/content";
import { getComplexFact, publishedComplexes } from "../lib/complexes";
import { naverListings, naverListingsUpdatedAt } from "../lib/naver-listings";
import { getResponsivePublicImageSrcSet } from "../lib/responsive-images";
import { formatOfficeHours, kakaoHref, office, phoneHref, smsHref } from "../lib/site";

const title = "대전 동구 지역 전문 행복한부동산 | 매매·전세·월세";
const description = "백진옥 대표가 대전 동구의 매매·전세·월세와 리더스시티 정보를 직접 확인해 안내하는 행복한부동산입니다.";
const quickComplexes = publishedComplexes.filter(({ slug }) => slug === "leaders-city-4" || slug === "leaders-city-5");
const homeBlogContents = publishedBlogContents.slice(0, 9);
const homeYoutubeContents = publishedYoutubeVideoContents.slice(0, 6);
const siteUrl = Astro.site?.toString();
const websiteId = siteUrl ? new URL("#website", siteUrl).toString() : undefined;
const businessId = siteUrl ? new URL("#real-estate-agent", siteUrl).toString() : undefined;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: office.brandName,
      alternateName: office.legalName,
      url: siteUrl,
      inLanguage: "ko-KR",
      publisher: businessId ? { "@id": businessId } : undefined,
    },
    {
      "@type": ["RealEstateAgent", "LocalBusiness"],
      "@id": businessId,
      name: office.legalName,
      alternateName: office.brandName,
      url: siteUrl,
      telephone: office.mobile,
      email: office.email,
      areaServed: office.serviceArea,
      image: Astro.site ? new URL(homeContent.broker.portrait.src, Astro.site).toString() : undefined,
      logo: Astro.site ? new URL("/images/brand/leaders-city-happy-logo.png", Astro.site).toString() : undefined,
      hasMap: office.naverPlaceUrl,
      sameAs: [office.naverPlaceUrl, office.naverBlogUrl, office.youtubeUrl],
      identifier: [
        { "@type": "PropertyValue", name: "중개사무소 등록번호", value: office.registrationNumber },
        { "@type": "PropertyValue", name: "사업자등록번호", value: office.businessNumber },
      ],
      openingHoursSpecification: office.hours
        .filter((hour) => hour.opens && hour.closes)
        .map((hour) => ({
          "@type": "OpeningHoursSpecification",
          dayOfWeek: hour.days,
          opens: hour.opens,
          closes: hour.closes,
        })),
      address: {
        "@type": "PostalAddress",
        streetAddress: office.address,
        addressLocality: "대전광역시 동구",
        addressCountry: "KR",
      },
    },
  ],
};
---

<BaseLayout
  {title}
  {description}
  {structuredData}
  shareImage="/images/brand/og-home.png"
  shareImageAlt="리더스시티 행복한부동산 대전 동구 매매·전세·월세 안내"
  shareImageWidth={1200}
  shareImageHeight={630}
>
  <section class="broker-hero section" id="about" aria-labelledby="broker-heading">
    <div class="shell broker-hero__grid">
      <div class="broker-hero__copy">
        <p class="eyebrow">{homeContent.broker.eyebrow}</p>
        <h1 id="broker-heading">{homeContent.broker.headline}</h1>
        <p class="broker-hero__lead">{homeContent.broker.lead}</p>
        <div class="hero__actions">
          <a class="button button--primary" href="/properties/">현재 매물 {naverListings.length}건 보기</a>
          <a class="button button--secondary" href={phoneHref}>전화 상담 {office.mobile}</a>
          <a class="button button--secondary" href={smsHref}>문자로 문의하기</a>
        </div>
        <dl class="broker-hero__facts" aria-label="대표와 사무소 정보">
          <div><dt>대표</dt><dd>{office.representative} 공인중개사</dd></div>
          <div><dt>전문 지역</dt><dd>대전 동구 전역</dd></div>
          <div class="broker-hero__hours">
            <dt>상담 시간</dt>
            <dd>{office.hours.map((hour) => <span><b>{hour.label}</b>{formatOfficeHours(hour)}</span>)}</dd>
          </div>
        </dl>
      </div>
      <figure class="broker-hero__portrait">
        <img src={homeContent.broker.portrait.src} alt={homeContent.broker.portrait.alt} width="900" height="900" fetchpriority="high" />
        <figcaption><strong>{office.representative}</strong><span>대표 · 공인중개사</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="home-quick-nav" aria-labelledby="home-quick-nav-heading">
    <div class="shell home-quick-nav__inner">
      <div class="home-quick-nav__heading">
        <p class="eyebrow">빠른 탐색</p>
        <h2 id="home-quick-nav-heading">찾는 조건으로 바로 보기</h2>
      </div>
      <nav class="home-quick-nav__groups" aria-label="매물과 단지 빠른 탐색">
        <div class="home-quick-nav__group">
          <span>거래유형</span>
          <div class="home-quick-nav__links home-quick-nav__links--trade">
            <a href="/properties/?trade=sale">매매</a>
            <a href="/properties/?trade=jeonse">전세</a>
            <a href="/properties/?trade=monthly-rent">월세</a>
          </div>
        </div>
        <div class="home-quick-nav__group">
          <span>리더스시티</span>
          <div class="home-quick-nav__links home-quick-nav__links--complex">
            {quickComplexes.map((complex) => <a href={`/complexes/${complex.slug}/`}>{complex.name.replace("리더스시티", "")} 바로 보기</a>)}
          </div>
        </div>
      </nav>
    </div>
  </section>

  <section class="section area-photo-feature" aria-labelledby="office-photo-heading">
    <div class="shell area-photo-feature__grid">
      <figure>
        <img
          src={homeContent.office.image.src}
          srcset={getResponsivePublicImageSrcSet(homeContent.office.image.src)}
          sizes="(min-width: 1180px) 560px, (min-width: 700px) 50vw, calc(100vw - 32px)"
          alt={homeContent.office.image.alt}
          width="2000"
          height="2000"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{homeContent.office.eyebrow}</figcaption>
      </figure>
      <div class="area-photo-feature__copy">
        <p class="eyebrow">대전 동구 지역 전문</p>
        <h2 id="office-photo-heading">{homeContent.office.title}</h2>
        <p class="area-photo-feature__description">{homeContent.office.description}</p>
        <address class="area-photo-feature__address">{office.address}</address>
        <ul class="office-badges" aria-label="상담 특징">
          {homeContent.office.badges.map((badge) => <li>{badge}</li>)}
        </ul>
        <div class="area-photo-feature__actions">
          <a class="button button--primary" href="/office/">사무소 자세히 보기</a>
          <a class="button button--secondary" href="/location/">오시는 길</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft" id="listings" aria-labelledby="listing-heading">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">네이버 등록 매물</p><h2 id="listing-heading">현재 공개 중인 매물을 바로 확인하세요</h2></div>
        <a class="text-link" href={office.naverListingsUrl} target="_blank" rel="noopener noreferrer">네이버 등록 매물 보기 ↗</a>
      </div>
      <p class="section-note"><strong>매물 목록 업데이트: {naverListingsUpdatedAt.replaceAll("-", ".")}</strong> · 네이버에 공개된 동 번호·광고 층수·가격·면적을 함께 보여드립니다.</p>
      <NaverListingPager items={naverListings} pageSize={6} />
    </div>
  </section>

  <section class="section section--soft" id="leaders-city" aria-labelledby="area-guide-heading">
    <div class="shell area-guide">
      <div class="area-guide__intro">
        <p class="eyebrow">{homeContent.areaGuide.eyebrow}</p>
        <h2 id="area-guide-heading">{homeContent.areaGuide.title}</h2>
        <p>{homeContent.areaGuide.description}</p>
        <a class="text-link" href="/complexes/">대전 동구 단지정보 보기 →</a>
      </div>
      <div class="area-guide__cards">
        {homeContent.areaGuide.cards.map((card, index) => (
          <article class:list={["area-guide-card", index === 0 && "area-guide-card--featured"]}>
            <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </div>
    <div class="shell complex-comparison">
      <div class="complex-comparison__heading">
        <div><p class="eyebrow">4·5블록 기본정보</p><h3>확인된 단지 규모를 먼저 비교하세요</h3></div>
        <p>LH·사업주체 공개자료를 기준으로 2026년 8월 25일 확인했습니다.</p>
      </div>
      <div class="complex-comparison__scroll" tabindex="0" aria-label="리더스시티 4블록과 5블록 기본정보 비교표">
        <table>
          <thead><tr><th scope="col">단지</th><th scope="col">규모</th><th scope="col">입주</th><th scope="col">전용면적</th><th scope="col">상세</th></tr></thead>
          <tbody>
            {publishedComplexes.map((complex) => (
              <tr>
                <th scope="row">{complex.name}</th>
                <td>{getComplexFact(complex, "규모")}</td>
                <td>{getComplexFact(complex, "입주")}</td>
                <td>{getComplexFact(complex, "전용면적")}</td>
                <td><a href={`/complexes/${complex.slug}/`}>자세히 보기 →</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="complex-comparison__note">단지 정보는 공개자료 기준이며, 실제 계약 전에는 최신 공부·관리사무소·현장 내용을 다시 확인합니다.</p>
    </div>
  </section>

  <section class="section" id="blog" aria-labelledby="blog-heading">
    <div class="shell">
      <div class="content-section-heading">
        <p>리더스시티행복한부동산</p>
        <h2 id="blog-heading">THE BLOG</h2>
        <a class="button button--secondary" href="/blog/">블로그 전체 보기</a>
      </div>
      <ExternalContentList items={homeBlogContents} emptyLabel="공개할 블로그 글을 준비하고 있습니다." pageSize={9} paginate={false} />
    </div>
  </section>

  <section class="section section--navy" id="youtube" aria-labelledby="youtube-heading">
    <div class="shell">
      <div class="content-section-heading content-section-heading--light">
        <p>대전동구유튜브---천동리더스시티행복한부동산tv</p>
        <h2 id="youtube-heading">YOUTUBE</h2>
        <a class="button button--light" href="/youtube/">유튜브 전체 보기</a>
      </div>
      <ExternalContentList items={homeYoutubeContents} emptyLabel="공개할 일반 영상을 준비하고 있습니다." pageSize={6} categoryLabel="유튜브 일반 영상" paginate={false} hoverPreview />
    </div>
  </section>

  <section class="section" aria-labelledby="contact-heading">
    <div class="shell contact-panel">
      <div><p class="eyebrow">상담 안내</p><h2 id="contact-heading">찾는 집이 아직 공개되지 않았나요?</h2><p>원하는 동네, 거래유형, 면적을 알려주시면 대전 동구에서 현재 확인 가능한 정보를 안내해 드립니다.</p></div>
      <div class="contact-panel__actions">
        <a class="button button--primary" href={phoneHref}>{office.mobile}</a>
        <a class="button button--secondary" href={smsHref}>문자로 조건 보내기</a>
        <a class="button button--kakao" href={kakaoHref} target="_blank" rel="noopener noreferrer">카카오톡 상담</a>
      </div>
    </div>
  </section>
</BaseLayout>
