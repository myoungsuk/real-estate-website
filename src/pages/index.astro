---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExternalContentList from "../components/ExternalContentList.astro";
import ListingCard from "../components/ListingCard.astro";
import { homeContent, publishedBlogContents, publishedYoutubeContents } from "../lib/content";
import { publishedListings } from "../lib/listings";
import { formatOfficeHours, kakaoHref, office, phoneHref, smsHref } from "../lib/site";

const title = "대전 동구 지역 전문 행복한부동산 | 매매·전세·월세";
const description = "백진옥 대표가 대전 동구의 매매·전세·월세와 리더스시티 정보를 직접 확인해 안내하는 행복한부동산입니다.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": ["RealEstateAgent", "LocalBusiness"],
  name: office.legalName,
  alternateName: office.brandName,
  url: Astro.site?.toString(),
  telephone: office.mobile,
  email: office.email,
  areaServed: office.serviceArea,
  image: Astro.site ? new URL(homeContent.broker.portrait.src, Astro.site).toString() : undefined,
  hasMap: office.naverPlaceUrl,
  sameAs: [office.naverBlogUrl, office.youtubeUrl],
  identifier: [
    { "@type": "PropertyValue", name: "중개사무소 등록번호", value: office.registrationNumber },
    { "@type": "PropertyValue", name: "사업자등록번호", value: office.businessNumber },
  ],
  openingHoursSpecification: office.hours
    .filter((hour) => hour.opens && hour.closes)
    .map((hour) => ({
      "@type": "OpeningHoursSpecification",
      dayOfWeek: hour.days,
      opens: hour.opens,
      closes: hour.closes,
    })),
  address: {
    "@type": "PostalAddress",
    streetAddress: office.address,
    addressLocality: "대전광역시 동구",
    addressCountry: "KR",
  },
};
---

<BaseLayout {title} {description} {structuredData}>
  <section class="broker-hero section" id="about" aria-labelledby="broker-heading">
    <div class="shell broker-hero__grid">
      <div class="broker-hero__copy">
        <p class="eyebrow">{homeContent.broker.eyebrow}</p>
        <h1 id="broker-heading">{homeContent.broker.headline}</h1>
        <p class="broker-hero__lead">{homeContent.broker.lead}</p>
        <div class="hero__actions">
          <a class="button button--primary" href={phoneHref}>전화 상담 {office.mobile}</a>
          <a class="button button--secondary" href={smsHref}>문자로 문의하기</a>
        </div>
        <dl class="broker-hero__facts" aria-label="대표와 사무소 정보">
          <div><dt>대표</dt><dd>{office.representative} 공인중개사</dd></div>
          <div><dt>전문 지역</dt><dd>대전 동구 전역</dd></div>
          <div><dt>평일 상담</dt><dd>{formatOfficeHours(office.hours[0])}</dd></div>
        </dl>
        <div class="claim-strip" aria-label="운영 현황">
          <p>{office.publicClaims.basis}</p>
          <ul>{office.publicClaims.items.map((claim) => <li><span>{claim.label}</span><strong>{claim.value}</strong></li>)}</ul>
        </div>
      </div>
      <figure class="broker-hero__portrait">
        <img src={homeContent.broker.portrait.src} alt={homeContent.broker.portrait.alt} width="900" height="900" />
        <figcaption><strong>{office.representative}</strong><span>대표 · 공인중개사</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="office-hero" aria-labelledby="office-photo-heading">
    <img src={homeContent.office.image.src} alt={homeContent.office.image.alt} width="1600" height="1000" loading="lazy" />
    <div class="office-hero__overlay shell">
      <p>{homeContent.office.eyebrow}</p>
      <h2 id="office-photo-heading">{homeContent.office.title}</h2>
      <span>{homeContent.office.description}</span>
    </div>
  </section>

  <section class="section" aria-labelledby="office-specialist-heading">
    <div class="shell office-specialist">
      <div>
        <p class="office-location-pill">{office.address}</p>
        <p class="eyebrow">대전 동구 지역 전문</p>
        <h2 id="office-specialist-heading">리더스시티 행복한부동산</h2>
        <p>{office.introduction[0]}</p>
        <div class="hero__actions">
          <a class="button button--primary" href="/properties/">확인 매물 보기</a>
          <a class="text-link" href="/office/">사무소 자세히 보기 →</a>
        </div>
      </div>
      <ul class="office-badges" aria-label="상담 특징">
        {homeContent.office.badges.map((badge) => <li>{badge}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--soft" id="listings" aria-labelledby="listing-heading">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">실제 확인 매물</p><h2 id="listing-heading">관리자가 등록한 매물이 여기에 표시됩니다</h2></div>
        <a class="text-link" href="/properties/">전체 매물 보기 →</a>
      </div>
      <p class="section-note">공개 승인 상태인 매물만 가격·면적·최근 확인일과 함께 보여드립니다.</p>
      {publishedListings.length > 0 ? (
        <div class="listing-rail" aria-label="최근 확인 매물">
          {publishedListings.slice(0, 8).map((listing) => <ListingCard {listing} compact />)}
        </div>
      ) : (
        <div class="empty-state">
          <span class="empty-state__number" aria-hidden="true">0</span>
          <div><h3>첫 공개 매물을 준비하고 있습니다</h3><p>가짜 샘플 대신 실제 확인과 공개 승인을 마친 매물만 올립니다. 찾는 지역과 조건을 알려주시면 현재 확인 가능한 매물을 안내해 드립니다.</p></div>
          <a class="button button--secondary" href={phoneHref}>현재 매물 문의</a>
        </div>
      )}
    </div>
  </section>

  <section class="section" id="blog" aria-labelledby="blog-heading">
    <div class="shell">
      <div class="content-section-heading">
        <p>네이버 블로그</p>
        <h2 id="blog-heading">THE BLOG</h2>
        <a class="button button--secondary" href={office.naverBlogUrl} target="_blank" rel="noopener noreferrer">전체 글 보기</a>
      </div>
      <ExternalContentList items={publishedBlogContents.slice(0, 6)} emptyLabel="공개할 블로그 글을 준비하고 있습니다." />
    </div>
  </section>

  <section class="section section--navy" id="youtube" aria-labelledby="youtube-heading">
    <div class="shell">
      <div class="content-section-heading content-section-heading--light">
        <p>유튜브</p>
        <h2 id="youtube-heading">YOUTUBE</h2>
        <a class="button button--light" href={office.youtubeUrl} target="_blank" rel="noopener noreferrer">채널 바로가기</a>
      </div>
      <ExternalContentList items={publishedYoutubeContents.slice(0, 6)} emptyLabel="공개할 유튜브 영상을 준비하고 있습니다." />
    </div>
  </section>

  <section class="section section--soft" id="leaders-city" aria-labelledby="area-guide-heading">
    <div class="shell area-guide">
      <div class="area-guide__intro">
        <p class="eyebrow">{homeContent.areaGuide.eyebrow}</p>
        <h2 id="area-guide-heading">{homeContent.areaGuide.title}</h2>
        <p>{homeContent.areaGuide.description}</p>
        <a class="text-link" href="/complexes/">대전 동구 단지정보 보기 →</a>
      </div>
      <div class="area-guide__cards">
        {homeContent.areaGuide.cards.map((card, index) => (
          <article class:list={["area-guide-card", index === 0 && "area-guide-card--featured"]}>
            <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-heading">
    <div class="shell contact-panel">
      <div><p class="eyebrow">상담 안내</p><h2 id="contact-heading">찾는 집이 아직 공개되지 않았나요?</h2><p>원하는 동네, 거래유형, 면적을 알려주시면 대전 동구에서 현재 확인 가능한 정보를 안내해 드립니다.</p></div>
      <div class="contact-panel__actions">
        <a class="button button--primary" href={phoneHref}>{office.mobile}</a>
        <a class="button button--secondary" href={smsHref}>문자로 조건 보내기</a>
        <a class="button button--kakao" href={kakaoHref} target="_blank" rel="noopener noreferrer">카카오톡 상담</a>
      </div>
    </div>
  </section>
</BaseLayout>
