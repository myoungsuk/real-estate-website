---
import BaseLayout from "../layouts/BaseLayout.astro";
import { office, phoneHref, smsHref } from "../lib/site";

const title = "대전 동구 천동 리더스시티 행복한부동산 | 4·5블록 매물";
const description = "천동·신흥동 리더스시티 4블록과 5블록의 매매·전세·월세 정보를 직접 확인해 안내하는 행복한부동산입니다.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": ["RealEstateAgent", "LocalBusiness"],
  name: office.legalName,
  alternateName: office.brandName,
  url: Astro.site?.toString(),
  telephone: office.mobile,
  address: {
    "@type": "PostalAddress",
    streetAddress: office.address,
    addressLocality: "대전광역시 동구",
    addressCountry: "KR",
  },
};
---

<BaseLayout {title} {description} {structuredData}>
  <section class="hero section">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">대전 동구 · 천동 · 신흥동</p>
        <h1>리더스시티를 잘 아는<br /><span>행복한부동산</span></h1>
        <p class="hero__lead">
          근거로 말하고, 직접 확인한 정보로 안내하며,<br class="desktop-only" />
          고객이 스스로 판단할 수 있도록 돕습니다.
        </p>
        <div class="hero__actions">
          <a class="button button--primary" href={phoneHref}>전화로 상담하기</a>
          <a class="button button--secondary" href="/properties/">확인 매물 보기</a>
        </div>
        <dl class="hero__facts" aria-label="사무소 핵심 정보">
          <div><dt>대표</dt><dd>{office.representative}</dd></div>
          <div><dt>전문 지역</dt><dd>리더스시티 4·5블록</dd></div>
          <div><dt>상담</dt><dd>매매 · 전세 · 월세</dd></div>
        </dl>
      </div>

      <div class="hero__panel" aria-label="상담 안내">
        <div class="hero__panel-top">
          <p>내 집을 고르는 시간</p>
          <strong>복잡한 조건을<br />차분하게 비교해 드립니다.</strong>
        </div>
        <div class="hero__panel-grid" aria-hidden="true">
          <span>4</span><span>5</span><span>천동</span><span>신흥동</span>
        </div>
        <a href={smsHref}>지금 문자로 문의하기 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="quick-heading">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">빠른 찾기</p><h2 id="quick-heading">어떤 정보를 찾으시나요?</h2></div>
        <p>필요한 정보에서 상담까지 헤매지 않도록 핵심 메뉴를 모았습니다.</p>
      </div>
      <div class="quick-grid">
        <a class="quick-card" href="/properties/?trade=sale"><span>01</span><h3>매매</h3><p>확인된 매매 정보를 가격과 면적으로 비교합니다.</p><b>매물 보기 →</b></a>
        <a class="quick-card" href="/properties/?trade=jeonse"><span>02</span><h3>전세</h3><p>보증금과 입주 조건을 보기 쉽게 확인합니다.</p><b>매물 보기 →</b></a>
        <a class="quick-card" href="/properties/?trade=monthly-rent"><span>03</span><h3>월세</h3><p>보증금과 월 임대료 조건을 함께 살펴봅니다.</p><b>매물 보기 →</b></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="listing-heading">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">확인 매물</p><h2 id="listing-heading">실제 확인한 매물만 공개합니다</h2></div>
        <a class="text-link" href="/properties/">전체 매물 보기 →</a>
      </div>
      <div class="empty-state">
        <span class="empty-state__number" aria-hidden="true">0</span>
        <div>
          <h3>첫 공개 매물을 준비하고 있습니다</h3>
          <p>가짜 샘플 대신 실제 확인과 공개 승인을 마친 매물만 올립니다. 찾는 조건을 알려주시면 현재 확인 가능한 매물을 안내해 드립니다.</p>
        </div>
        <a class="button button--secondary" href={phoneHref}>현재 매물 문의</a>
      </div>
    </div>
  </section>

  <section class="section section--navy" aria-labelledby="complex-heading">
    <div class="shell">
      <div class="section-heading section-heading--light">
        <div><p class="eyebrow">단지 정보</p><h2 id="complex-heading">리더스시티 4블록과 5블록</h2></div>
        <p>확인된 자료에 근거해 블록별 정보를 분리해 안내합니다.</p>
      </div>
      <div class="complex-grid">
        <a class="complex-card" href="/complexes/leaders-city-4/"><span>LEADERS CITY</span><strong>4</strong><h3>리더스시티 4블록</h3><p>단지·생활 정보를 확인하는 공간</p><b>자세히 보기 →</b></a>
        <a class="complex-card complex-card--rose" href="/complexes/leaders-city-5/"><span>LEADERS CITY</span><strong>5</strong><h3>리더스시티 5블록</h3><p>단지·생활 정보를 확인하는 공간</p><b>자세히 보기 →</b></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="trust-heading">
    <div class="shell trust-grid">
      <div class="trust-portrait" aria-hidden="true">
        <span>백</span>
        <p>직접 확인 · 쉬운 설명 · 신뢰 상담</p>
      </div>
      <div class="trust-copy">
        <p class="eyebrow">행복한 상담 원칙</p>
        <h2 id="trust-heading">결정을 재촉하기보다<br />판단할 근거를 드립니다.</h2>
        <p>가격, 면적, 확인일과 출처를 분명히 구분하고 확인되지 않은 내용은 단정하지 않습니다. 궁금한 조건은 백진옥 대표가 직접 듣고 차분하게 안내합니다.</p>
        <ul class="check-list">
          <li>실제 확인한 공개 정보 중심</li>
          <li>정확한 동·호수와 고객 개인정보 비공개</li>
          <li>계약 전 조건과 현황 재확인</li>
        </ul>
        <a class="text-link" href="/office/">사무소 소개 보기 →</a>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="contact-heading">
    <div class="shell contact-panel">
      <div><p class="eyebrow">상담 안내</p><h2 id="contact-heading">찾는 집이 아직 공개되지 않았나요?</h2><p>원하는 블록, 거래유형, 면적을 알려주시면 현재 확인 가능한 정보를 안내해 드립니다.</p></div>
      <div class="contact-panel__actions">
        <a class="button button--primary" href={phoneHref}>{office.mobile}</a>
        <a class="button button--secondary" href={smsHref}>문자로 조건 보내기</a>
      </div>
    </div>
  </section>
</BaseLayout>
