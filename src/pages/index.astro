---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExternalContentList from "../components/ExternalContentList.astro";
import HomeWindowHero from "../components/HomeWindowHero.astro";
import NaverListingPager from "../components/NaverListingPager.astro";
import { homeContent, publishedBlogContents, publishedYoutubeVideoContents } from "../lib/content";
import { featuredComplexes, getComplexFact } from "../lib/complexes";
import { naverListings } from "../lib/naver-listings";
import { getResponsivePublicImageSrcSet } from "../lib/responsive-images";
import { formatOfficeHours, kakaoHref, office, phoneHref, smsHref } from "../lib/site";
import homeStyles from "../styles/home.css?inline";

const title = "대전 동구 지역 전문 행복한부동산 | 리더스시티·신흥 SK뷰";
const description = "리더스시티5블록 단지 내 행복한부동산입니다. 리더스시티 4·5블록과 신흥 SK뷰를 중심으로 천동·신흥동의 매매·전세·월세를 백진옥 대표 공인중개사가 직접 상담합니다.";
const homeBlogContents = publishedBlogContents.slice(0, 9);
const homeYoutubeContents = publishedYoutubeVideoContents.slice(0, 6);
const getHomeComplexFact = (
  complex: (typeof featuredComplexes)[number],
  labels: string[],
) => labels.map((label) => getComplexFact(complex, label)).find((value) => value !== "확인 중") ?? "확인 중";
const siteUrl = Astro.site?.toString();
const websiteId = siteUrl ? new URL("#website", siteUrl).toString() : undefined;
const businessId = siteUrl ? new URL("#real-estate-agent", siteUrl).toString() : undefined;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: office.brandName,
      alternateName: office.legalName,
      url: siteUrl,
      inLanguage: "ko-KR",
      publisher: businessId ? { "@id": businessId } : undefined,
    },
    {
      "@type": ["RealEstateAgent", "LocalBusiness"],
      "@id": businessId,
      name: office.legalName,
      alternateName: office.brandName,
      url: siteUrl,
      telephone: office.mobile,
      email: office.email,
      areaServed: office.serviceArea,
      image: Astro.site ? new URL(homeContent.broker.portrait.src, Astro.site).toString() : undefined,
      logo: Astro.site ? new URL("/images/brand/leaders-city-happy-logo.png", Astro.site).toString() : undefined,
      hasMap: office.naverPlaceUrl,
      sameAs: [office.naverPlaceUrl, office.naverBlogUrl, office.youtubeUrl],
      identifier: [
        { "@type": "PropertyValue", name: "중개사무소 등록번호", value: office.registrationNumber },
        { "@type": "PropertyValue", name: "사업자등록번호", value: office.businessNumber },
      ],
      openingHoursSpecification: office.hours
        .filter((hour) => hour.opens && hour.closes)
        .map((hour) => ({
          "@type": "OpeningHoursSpecification",
          dayOfWeek: hour.days,
          opens: hour.opens,
          closes: hour.closes,
        })),
      address: {
        "@type": "PostalAddress",
        streetAddress: office.address,
        addressLocality: "대전광역시 동구",
        addressCountry: "KR",
      },
    },
  ],
};
---

<BaseLayout
  {title}
  {description}
  {structuredData}
  shareImage="/images/brand/og-home.png"
  shareImageAlt="리더스시티 행복한부동산 대전 동구 매매·전세·월세 안내"
  shareImageWidth={1200}
  shareImageHeight={630}
  inlineGlobalStyles
  preloadImage={{
    href: "/images/office/office-storefront-900.avif",
    srcset: "/images/office/office-storefront-640.avif 640w, /images/office/office-storefront-768.avif 768w, /images/office/office-storefront-900.avif 900w",
    type: "image/avif",
    sizes: "100vw",
  }}
>
  <HomeWindowHero>
    <div id="listings">
      {naverListings.length > 0 && <NaverListingPager items={naverListings} pageSize={6} variant="sheet" />}
      {naverListings.length > 0 && (
        <div class="hw__more">
          <a class="hw__all" href="/properties/">현재 매물 {naverListings.length}건 보기</a>
          <a class="hw__naver" href={office.naverListingsUrl} target="_blank" rel="noopener noreferrer">네이버 지도에서 매물 보기 <span aria-hidden="true">↗</span></a>
        </div>
      )}
    </div>
  </HomeWindowHero>

  <style is:inline set:html={homeStyles} />

  <nav class="home-sec home-find" aria-labelledby="home-find-heading">
    <div class="shell">
      <h2 class="home-sec__title" id="home-find-heading">조건으로 찾기</h2>
      <span class="home-find__label" id="home-find-trade">거래유형</span>
      <ul class="home-find__row" aria-labelledby="home-find-trade">
        <li><a href="/properties/?trade=sale">매매</a></li>
        <li><a href="/properties/?trade=jeonse">전세</a></li>
        <li><a href="/properties/?trade=monthly-rent">월세</a></li>
      </ul>
      <span class="home-find__label" id="home-find-complex">단지</span>
      {/* 단지 링크의 home-quick-nav__links--complex는 E2E가 단지 링크 수·이름을 세는 기준이라 유지한다 */}
      <ul class="home-find__row" aria-labelledby="home-find-complex">
        {featuredComplexes.map((complex) => <li class="home-quick-nav__links--complex"><a href={`/complexes/${complex.slug}/`}>{complex.name}</a></li>)}
        <li><a href="/properties/">동구 전체 매물</a></li>
      </ul>
    </div>
  </nav>

  <section class="home-sec home-sec--tint home-area" id="leaders-city" aria-labelledby="area-guide-heading">
    <div class="shell">
      <ul class="home-tags" aria-label="단지 구역 안내"><li>{homeContent.areaGuide.eyebrow}</li></ul>
      <h2 class="home-sec__title" id="area-guide-heading">{homeContent.areaGuide.title}</h2>
      <p class="home-sec__desc">{homeContent.areaGuide.description}</p>
      <ul class="home-area__complexes">
        {featuredComplexes.map((complex) => (
          <li>
            <a href={`/complexes/${complex.slug}/`}>
              {complex.image ? (
                <img
                  src={complex.image.src}
                  srcset={getResponsivePublicImageSrcSet(complex.image.src)}
                  sizes="(min-width: 1180px) 380px, (min-width: 700px) 31vw, calc(100vw - 32px)"
                  alt={complex.image.alt}
                  width="2000"
                  height="2000"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="home-area__photo-plain" aria-hidden="true"></span>
              )}
              <span class="home-area__name">{complex.name}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="home-compare">
        <h3>확인된 단지 규모를 먼저 살펴보세요</h3>
        <div class="home-compare__scroll" tabindex="0" aria-label="천동·신흥 주요 단지 기본정보 표">
          <table>
            <thead><tr><th scope="col">단지</th><th scope="col">규모</th><th scope="col">입주</th><th scope="col">전용면적</th><th scope="col">상세</th></tr></thead>
            <tbody>
              {featuredComplexes.map((complex) => (
                <tr>
                  <th scope="row">{complex.name}</th>
                  <td>{getComplexFact(complex, "규모")}</td>
                  <td>{getHomeComplexFact(complex, ["입주", "사용승인"])}</td>
                  <td>{getHomeComplexFact(complex, ["전용면적", "전용면적 구간"])}</td>
                  <td><a href={`/complexes/${complex.slug}/`}>자세히 보기 →</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="home-compare__note">단지 정보는 공개자료 기준이며, 실제 계약 전에는 최신 공부·관리사무소·현장 내용을 다시 확인합니다.</p>
      </div>
      <ul class="home-area__cards">
        {homeContent.areaGuide.cards.map((card) => (
          <li>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </li>
        ))}
      </ul>
      <a class="home-more" href="/complexes/">대전 동구 단지정보 보기</a>
    </div>
  </section>

  <section class="home-sec home-office" aria-labelledby="office-photo-heading">
    <div class="shell home-office__grid">
      <figure>
        <img
          src={homeContent.office.image.src}
          srcset={getResponsivePublicImageSrcSet(homeContent.office.image.src)}
          sizes="(min-width: 1180px) 570px, (min-width: 700px) 50vw, calc(100vw - 32px)"
          alt={homeContent.office.image.alt}
          width="2000"
          height="2000"
          loading="lazy"
          fetchpriority="low"
          decoding="async"
        />
        <figcaption>{homeContent.office.eyebrow}</figcaption>
      </figure>
      <div>
        <h2 class="home-sec__title" id="office-photo-heading">{homeContent.office.title}</h2>
        <p class="home-sec__desc">{homeContent.office.description}</p>
        <ul class="home-office__checks" aria-label="상담 특징">
          {homeContent.office.badges.map((badge) => <li>{badge}</li>)}
        </ul>
        <dl class="home-office__list" aria-label="사무소 정보">
          <div><dt>주소</dt><dd><address>{office.address}</address></dd></div>
          <div>
            <dt>상담 시간</dt>
            <dd>
              <ul class="home-office__hours">
                {office.hours.map((hour) => <li><b>{hour.label}</b> {formatOfficeHours(hour)}</li>)}
              </ul>
            </dd>
          </div>
          <div><dt>주차</dt><dd>{office.parking}</dd></div>
        </dl>
        <div class="home-office__more">
          <a class="home-more" href="/office/">사무소 자세히 보기</a>
          <a class="home-more" href="/location/">오시는 길</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="blog" aria-labelledby="blog-heading">
    <div class="shell">
      <div class="content-section-heading">
        <p>리더스시티행복한부동산</p>
        <h2 id="blog-heading">THE BLOG</h2>
        <a class="button button--secondary" href="/blog/">블로그 전체 보기</a>
      </div>
      <ExternalContentList items={homeBlogContents} emptyLabel="공개할 블로그 글을 준비하고 있습니다." pageSize={9} paginate={false} />
    </div>
  </section>

  <section class="section section--navy" id="youtube" aria-labelledby="youtube-heading">
    <div class="shell">
      <div class="content-section-heading content-section-heading--light">
        <p>대전동구유튜브---천동리더스시티행복한부동산tv</p>
        <h2 id="youtube-heading">YOUTUBE</h2>
        <a class="button button--light" href="/youtube/">유튜브 전체 보기</a>
      </div>
      <ExternalContentList items={homeYoutubeContents} emptyLabel="공개할 일반 영상을 준비하고 있습니다." pageSize={6} categoryLabel="유튜브 일반 영상" paginate={false} hoverPreview />
    </div>
  </section>

  <section class="section" aria-labelledby="contact-heading">
    <div class="shell contact-panel">
      <div><p class="eyebrow">상담 안내</p><h2 id="contact-heading">찾는 집이 아직 공개되지 않았나요?</h2><p>원하는 동네, 거래유형, 면적을 알려주시면 대전 동구에서 현재 확인 가능한 정보를 안내해 드립니다.</p></div>
      <div class="contact-panel__actions">
        <a class="button button--primary" href={phoneHref}>{office.mobile}</a>
        <a class="button button--secondary" href={smsHref}>문자로 조건 보내기</a>
        <a class="button button--kakao" href={kakaoHref} target="_blank" rel="noopener noreferrer">카카오톡 상담</a>
      </div>
    </div>
  </section>
</BaseLayout>
