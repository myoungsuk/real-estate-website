---
import NaverListingCard from "./NaverListingCard.astro";
import type { NaverListing } from "../lib/naver-listings";

interface Props {
  items: NaverListing[];
  pageSize?: number;
}

const { items, pageSize = 6 } = Astro.props;
const safePageSize = Math.max(1, pageSize);
const pageCount = Math.ceil(items.length / safePageSize);
const gridId = "home-naver-listing-grid";
---

<div class="listing-pager" data-listing-pager data-page-size={safePageSize}>
  <nav class="listing-sort" aria-label="메인 매물 정렬">
    <span>정렬</span>
    <button type="button" data-listing-sort="latest" aria-pressed="true">최근 등록순</button>
    <button type="button" data-listing-sort="price" aria-pressed="false">가격 낮은순</button>
    <button type="button" data-listing-sort="price-desc" aria-pressed="false">가격 높은순</button>
    <button type="button" data-listing-sort="area" aria-pressed="false">면적 작은순</button>
    <button type="button" data-listing-sort="area-desc" aria-pressed="false">면적 큰순</button>
  </nav>
  <div class="listing-grid listing-grid--home" id={gridId}>
    {items.map((listing, index) => (
      <NaverListingCard {listing} compact rank={index} hidden={index >= safePageSize} />
    ))}
  </div>
  <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-listing-status></p>
  {pageCount > 1 && (
    <nav class="content-pagination listing-pagination" aria-label="메인 매물 페이지" data-listing-pagination>
      <button type="button" data-listing-prev aria-controls={gridId} aria-label="이전 페이지">‹</button>
      <div class="content-pagination__pages">
        {Array.from({ length: pageCount }, (_, index) => (
          <button type="button" data-listing-page={index} aria-controls={gridId} aria-label={`${index + 1}페이지`} aria-current={index === 0 ? "page" : undefined}>{index + 1}</button>
        ))}
      </div>
      <button type="button" data-listing-next aria-controls={gridId} aria-label="다음 페이지">›</button>
    </nav>
  )}
</div>

<script>
  import { compareNaverListingSortData } from "../lib/naver-listing-sort.mjs";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-listing-pager]").forEach((pager) => {
    if (pager.dataset.paginationReady === "true") return;
    const items = Array.from(pager.querySelectorAll<HTMLElement>("[data-naver-listing-card]"));
    const pageButtons = Array.from(pager.querySelectorAll<HTMLButtonElement>("[data-listing-page]"));
    const sortButtons = Array.from(pager.querySelectorAll<HTMLButtonElement>("[data-listing-sort]"));
    const previousButton = pager.querySelector<HTMLButtonElement>("[data-listing-prev]");
    const nextButton = pager.querySelector<HTMLButtonElement>("[data-listing-next]");
    const grid = pager.querySelector<HTMLElement>(".listing-grid");
    const status = pager.querySelector<HTMLElement>("[data-listing-status]");
    const pageSize = Number(pager.dataset.pageSize ?? 6);
    const pageCount = Math.ceil(items.length / pageSize);
    let orderedItems = [...items];
    let currentPage = 0;

    const showPage = (requestedPage: number, moveToGrid = false) => {
      currentPage = pageCount > 0 ? Math.min(Math.max(requestedPage, 0), pageCount - 1) : 0;
      orderedItems.forEach((item, index) => {
        item.hidden = Math.floor(index / pageSize) !== currentPage;
      });
      pageButtons.forEach((button, index) => {
        if (index === currentPage) button.setAttribute("aria-current", "page");
        else button.removeAttribute("aria-current");
      });
      if (previousButton) previousButton.disabled = pageCount === 0 || currentPage === 0;
      if (nextButton) nextButton.disabled = pageCount === 0 || currentPage === pageCount - 1;
      if (status) {
        const firstVisible = orderedItems.length > 0 ? currentPage * pageSize + 1 : 0;
        const lastVisible = Math.min(orderedItems.length, firstVisible + pageSize - 1);
        const visibleCount = lastVisible > 0 ? lastVisible - firstVisible + 1 : 0;
        const sortLabel = sortButtons.find((button) => button.getAttribute("aria-pressed") === "true")?.textContent?.trim() ?? "현재 정렬";
        const pageLabel = pageCount > 0 ? `, ${currentPage + 1}/${pageCount}페이지` : "";
        status.textContent = `매물 총 ${orderedItems.length}건 중 ${firstVisible}~${lastVisible}번째 ${visibleCount}건을 표시합니다${pageLabel}, ${sortLabel}.`;
      }
      const activePageButton = pageButtons[currentPage];
      const pageList = activePageButton?.parentElement;
      if (activePageButton && pageList) {
        const buttonLeft = activePageButton.offsetLeft;
        const buttonRight = buttonLeft + activePageButton.offsetWidth;
        if (buttonLeft < pageList.scrollLeft || buttonRight > pageList.scrollLeft + pageList.clientWidth) {
          pageList.scrollTo({
            left: Math.max(0, buttonLeft - (pageList.clientWidth - activePageButton.offsetWidth) / 2),
            behavior: moveToGrid && !prefersReducedMotion ? "smooth" : "auto",
          });
        }
      }
      if (moveToGrid) grid?.scrollIntoView({ behavior: prefersReducedMotion ? "auto" : "smooth", block: "start" });
    };

    const applySort = (sortKey: string) => {
      orderedItems = [...items].sort((a, b) => compareNaverListingSortData(a.dataset, b.dataset, sortKey));
      grid?.append(...orderedItems);
      sortButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.listingSort === sortKey)));
      showPage(0);
    };

    pageButtons.forEach((button, index) => button.addEventListener("click", () => showPage(index, true)));
    sortButtons.forEach((button) => button.addEventListener("click", () => applySort(button.dataset.listingSort ?? "")));
    previousButton?.addEventListener("click", () => showPage(currentPage - 1, true));
    nextButton?.addEventListener("click", () => showPage(currentPage + 1, true));
    pager.dataset.paginationReady = "true";
    applySort("latest");
  });
</script>
