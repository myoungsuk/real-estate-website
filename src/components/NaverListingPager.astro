---
import NaverListingCard from "./NaverListingCard.astro";
import { matchPublishedComplexByListingTitle } from "../lib/complexes";
import type { NaverListing } from "../lib/naver-listings";
import { getResponsivePublicImageSrcSet } from "../lib/responsive-images";

interface Props {
  items: NaverListing[];
  pageSize?: number;
  variant?: "default" | "sheet";
}

const { items, pageSize = 6, variant = "default" } = Astro.props;
const isSheet = variant === "sheet";
// 종이 위쪽 띠: 공개 단지로 매칭되는 매물만 그 단지의 승인된 사진(작은 변형이 있으면 640px)을 쓴다.
// 종이 사진 띠는 화면에서 96px 높이의 가운데만 보이므로 640×188 띠 파생본을 먼저 쓴다(첫 화면 LCP 보호).
// 띠 파생본이 없는 새 단지는 640px 파생본, 그것도 없으면 원본을 쓴다.
const sheetBandSources = new Set([
  "/images/area/leaders-city-4-landscape.webp",
  "/images/area/leaders-city-5-landscape.webp",
  "/images/area/sinheung-sk-view.webp",
]);
const getSheetBand = (listing: NaverListing) => {
  if (!isSheet) return { complexSlug: "", band: null };
  const complex = matchPublishedComplexByListingTitle(listing.title);
  if (!complex?.image) return { complexSlug: complex?.slug ?? "", band: null };
  // 띠는 꾸밈 사진이라 대체 글을 비운다(카드 제목에 단지 이름이 있어 읽기 프로그램이 같은 문장을 되풀이하지 않게).
  const { src } = complex.image;
  if (sheetBandSources.has(src)) return { complexSlug: complex.slug, band: { src: src.replace(/\.webp$/u, "-band.webp"), width: 640, height: 188 } };
  if (getResponsivePublicImageSrcSet(src)) return { complexSlug: complex.slug, band: { src: src.replace(/\.webp$/u, "-640.webp") } };
  return { complexSlug: complex.slug, band: { src } };
};
const safePageSize = Math.max(1, pageSize);
const pageCount = Math.ceil(items.length / safePageSize);
const gridId = "home-naver-listing-grid";
// 종이 모양 스타일은 홈에서만 쓰여 외부 CSS 요청을 만들지 않도록 인라인으로 넣는다(첫 화면 LCP 보호).
const sheetStyles = `
  /* 홈 첫 화면 매물 종이 칸(DESIGN.md "매물 종이 넘기기·정렬") */
  .listing-pager--sheet {
    display: grid;
  }

  /* 옆으로 넘기는 칸은 위아래도 잘라 내므로, 포커스 테두리(바깥 6px)가 보이게 위아래 여백을 두고 같은 만큼 바깥 여백을 빼 자리는 그대로 둔다 */
  .listing-pager--sheet .listing-sort {
    flex-wrap: nowrap;
    justify-content: flex-start;
    gap: 6px;
    margin: -7px 0 -6px;
    padding: 7px 16px 8px;
    margin-inline: -16px;
    overflow-x: auto;
    scroll-padding-inline: 48px;
    scrollbar-width: none;
  }

  /* 가려진 칩이 있는 쪽 가장자리를 흐리게 해 옆으로 더 있다는 것을 보여 준다(스크립트가 data-more-* 를 붙임).
     포커스로 옮긴 칩은 scroll-padding 48px 덕분에 흐린 36px 밖에 선다. */
  .listing-pager--sheet .listing-sort[data-more-end] {
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 36px), transparent);
    mask-image: linear-gradient(to right, #000 calc(100% - 36px), transparent);
  }

  .listing-pager--sheet .listing-sort[data-more-start] {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 36px);
    mask-image: linear-gradient(to right, transparent, #000 36px);
  }

  .listing-pager--sheet .listing-sort[data-more-start][data-more-end] {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 36px, #000 calc(100% - 36px), transparent);
    mask-image: linear-gradient(to right, transparent, #000 36px, #000 calc(100% - 36px), transparent);
  }

  /* 어두운 사진 띠 위라 남색 구역과 같은 밝은 포커스 색을 쓴다 */
  .listing-pager--sheet .listing-sort :focus-visible {
    outline-color: var(--focus-ring-light);
  }

  .listing-pager--sheet .listing-sort > span {
    flex: 0 0 auto;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 0 10px;
    border-radius: 2px;
    color: #ffffff;
    background: rgba(12, 20, 26, 0.86);
    font-size: 0.875rem;
  }

  .listing-pager--sheet .listing-sort button {
    flex: 0 0 auto;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid #fbfaf6;
    border-radius: 2px;
    color: #132a3e;
    background: #fbfaf6;
    font-weight: 800;
  }

  .listing-pager--sheet .listing-sort button[aria-pressed="true"] {
    color: #fbfaf6;
    border-color: #132a3e;
    background: #132a3e;
    text-decoration: none;
  }

  .listing-pager--sheet .listing-grid--sheets {
    grid-auto-flow: column;
    grid-template-columns: none;
    grid-auto-columns: 84%;
    gap: 14px;
    margin: 0 -16px;
    padding: 18px 16px 18px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 16px;
  }

  .listing-pager--sheet .listing-grid--sheets > * {
    scroll-snap-align: start;
  }

  .listing-pagination--sheet {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin: 2px 0 14px;
  }

  .listing-pagination--sheet button {
    min-width: 96px;
    min-height: 48px;
    border: 1.5px solid #132a3e;
    border-radius: 2px;
    color: #132a3e;
    background: #fbfaf6;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .listing-pagination--sheet button:disabled {
    border-color: #e2ded3;
    color: #8c897f;
    cursor: not-allowed;
  }

  .listing-pagination__now {
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .listing-pagination__now b {
    color: #132a3e;
    font-size: 1.15rem;
  }

  @media (min-width: 700px) {
    .listing-pager--sheet .listing-grid--sheets {
      grid-auto-columns: 46%;
    }
  }

  @media (min-width: 1024px) {
    .listing-pager--sheet .listing-sort {
      margin-inline: 0;
      padding-inline: 0;
    }

    .listing-pager--sheet .listing-grid--sheets {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      margin: 0;
      padding: 18px 0;
      overflow: visible;
    }
  }

  /* 홈 첫 화면 매물 종이(DESIGN.md "매물 종이") */
  .listing-card.listing-card--sheet {
    --sheet-paper: #fbfaf6;
    --sheet-paper-2: #f1eee6;
    --sheet-edge: #e2ded3;
    --sheet-ink: #141414;
    --sheet-ink-soft: #4a4844;
    --sheet-stamp: #b3261e;
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: visible;
    border: 1px solid var(--sheet-edge);
    border-top: 1px solid var(--sheet-edge);
    border-radius: 2px;
    color: var(--sheet-ink);
    background: var(--sheet-paper);
    box-shadow: 0 2px 3px rgba(20, 20, 20, 0.1), 0 14px 28px rgba(20, 20, 20, 0.16);
  }

  .listing-card.listing-card--sheet[hidden] {
    display: none;
  }

  .listing-card.listing-card--sheet::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -11px;
    z-index: 2;
    width: 84px;
    height: 24px;
    background: rgba(232, 220, 190, 0.88);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
    transform: translateX(-50%) rotate(-3deg);
  }

  .sheet__band {
    display: block;
    width: 100%;
    height: 96px;
    object-fit: cover;
    background: var(--sheet-paper-2);
  }

  .sheet__band--plain {
    background: repeating-linear-gradient(135deg, var(--sheet-paper-2) 0 10px, #ece8de 10px 20px);
  }

  .sheet__stamp {
    position: absolute;
    right: 12px;
    top: 72px;
    z-index: 2;
    margin: 0;
    padding: 3px 8px;
    border: 2px solid var(--sheet-stamp);
    border-radius: 4px;
    color: var(--sheet-stamp);
    background: var(--sheet-paper);
    font-size: 0.875rem;
    font-weight: 800;
    transform: rotate(-5deg);
  }

  .sheet__body {
    padding: 16px 16px 8px;
  }

  .sheet__price {
    margin: 0;
    font-size: clamp(2rem, 9vw, 2.6rem);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .sheet__price span {
    margin-right: 4px;
    font-size: 1.1rem;
    font-weight: 800;
  }

  .sheet__title {
    margin: 6px 0 2px;
    font-size: 1.25rem;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .sheet__facts {
    margin: 0;
    color: var(--sheet-ink-soft);
  }

  .sheet__link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
`;
---

{isSheet && <style is:inline set:html={sheetStyles} />}
<div class:list={["listing-pager", isSheet && "listing-pager--sheet"]} data-listing-pager data-page-size={safePageSize}>
  <nav class="listing-sort" aria-label="메인 매물 정렬">
    <span>정렬</span>
    <button type="button" data-listing-sort="latest" aria-pressed="true">최근 등록순</button>
    <button type="button" data-listing-sort="price" aria-pressed="false">가격 낮은순</button>
    <button type="button" data-listing-sort="price-desc" aria-pressed="false">가격 높은순</button>
    <button type="button" data-listing-sort="area" aria-pressed="false">면적 작은순</button>
    <button type="button" data-listing-sort="area-desc" aria-pressed="false">면적 큰순</button>
  </nav>
  <div class:list={["listing-grid", "listing-grid--home", isSheet && "listing-grid--sheets"]} id={gridId}>
    {items.map((listing, index) => (
      isSheet
        ? <NaverListingCard {listing} compact rank={index} hidden={index >= safePageSize} variant="sheet" {...getSheetBand(listing)} />
        : <NaverListingCard {listing} compact rank={index} hidden={index >= safePageSize} />
    ))}
  </div>
  <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-listing-status></p>
  {isSheet && pageCount > 1 && (
    <nav class="listing-pagination listing-pagination--sheet" aria-label="메인 매물 페이지" data-listing-pagination>
      <button type="button" data-listing-prev aria-controls={gridId} aria-label="이전 페이지">‹ 이전</button>
      <span class="listing-pagination__now" data-listing-page-now aria-hidden="true"><b>1</b> / {pageCount}</span>
      <button type="button" data-listing-next aria-controls={gridId} aria-label="다음 페이지">다음 ›</button>
    </nav>
  )}
  {!isSheet && pageCount > 1 && (
    <nav class="content-pagination listing-pagination" aria-label="메인 매물 페이지" data-listing-pagination>
      <button type="button" data-listing-prev aria-controls={gridId} aria-label="이전 페이지">‹</button>
      <div class="content-pagination__pages">
        {Array.from({ length: pageCount }, (_, index) => (
          <button type="button" data-listing-page={index} aria-controls={gridId} aria-label={`${index + 1}페이지`} aria-current={index === 0 ? "page" : undefined}>{index + 1}</button>
        ))}
      </div>
      <button type="button" data-listing-next aria-controls={gridId} aria-label="다음 페이지">›</button>
    </nav>
  )}
</div>

<script>
  import { compareNaverListingSortData } from "../lib/naver-listing-sort.mjs";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-listing-pager]").forEach((pager) => {
    if (pager.dataset.paginationReady === "true") return;
    const items = Array.from(pager.querySelectorAll<HTMLElement>("[data-naver-listing-card]"));
    const pageButtons = Array.from(pager.querySelectorAll<HTMLButtonElement>("[data-listing-page]"));
    const sortButtons = Array.from(pager.querySelectorAll<HTMLButtonElement>("[data-listing-sort]"));
    const previousButton = pager.querySelector<HTMLButtonElement>("[data-listing-prev]");
    const nextButton = pager.querySelector<HTMLButtonElement>("[data-listing-next]");
    const grid = pager.querySelector<HTMLElement>(".listing-grid");
    const status = pager.querySelector<HTMLElement>("[data-listing-status]");
    const pageNow = pager.querySelector<HTMLElement>("[data-listing-page-now]");
    const pageSize = Number(pager.dataset.pageSize ?? 6);
    const pageCount = Math.ceil(items.length / pageSize);
    let orderedItems = [...items];
    let currentPage = 0;

    const showPage = (requestedPage: number, moveToGrid = false) => {
      currentPage = pageCount > 0 ? Math.min(Math.max(requestedPage, 0), pageCount - 1) : 0;
      orderedItems.forEach((item, index) => {
        item.hidden = Math.floor(index / pageSize) !== currentPage;
      });
      pageButtons.forEach((button, index) => {
        if (index === currentPage) button.setAttribute("aria-current", "page");
        else button.removeAttribute("aria-current");
      });
      if (pageNow) {
        const current = document.createElement("b");
        current.textContent = String(pageCount > 0 ? currentPage + 1 : 0);
        pageNow.replaceChildren(current, ` / ${pageCount}`);
      }
      if (grid && grid.scrollLeft !== 0) grid.scrollLeft = 0;
      if (previousButton) previousButton.disabled = pageCount === 0 || currentPage === 0;
      if (nextButton) nextButton.disabled = pageCount === 0 || currentPage === pageCount - 1;
      if (status) {
        const firstVisible = orderedItems.length > 0 ? currentPage * pageSize + 1 : 0;
        const lastVisible = Math.min(orderedItems.length, firstVisible + pageSize - 1);
        const visibleCount = lastVisible > 0 ? lastVisible - firstVisible + 1 : 0;
        const sortLabel = sortButtons.find((button) => button.getAttribute("aria-pressed") === "true")?.textContent?.trim() ?? "현재 정렬";
        const pageLabel = pageCount > 0 ? `, ${currentPage + 1}/${pageCount}페이지` : "";
        status.textContent = `매물 총 ${orderedItems.length}건 중 ${firstVisible}~${lastVisible}번째 ${visibleCount}건을 표시합니다${pageLabel}, ${sortLabel}.`;
      }
      const activePageButton = pageButtons[currentPage];
      const pageList = activePageButton?.parentElement;
      if (activePageButton && pageList) {
        const buttonLeft = activePageButton.offsetLeft;
        const buttonRight = buttonLeft + activePageButton.offsetWidth;
        if (buttonLeft < pageList.scrollLeft || buttonRight > pageList.scrollLeft + pageList.clientWidth) {
          pageList.scrollTo({
            left: Math.max(0, buttonLeft - (pageList.clientWidth - activePageButton.offsetWidth) / 2),
            behavior: moveToGrid && !prefersReducedMotion ? "smooth" : "auto",
          });
        }
      }
      if (moveToGrid) grid?.scrollIntoView({ behavior: prefersReducedMotion ? "auto" : "smooth", block: "start" });
    };

    const applySort = (sortKey: string) => {
      orderedItems = [...items].sort((a, b) => compareNaverListingSortData(a.dataset, b.dataset, sortKey));
      grid?.append(...orderedItems);
      sortButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.listingSort === sortKey)));
      showPage(0);
    };

    pageButtons.forEach((button, index) => button.addEventListener("click", () => showPage(index, true)));
    sortButtons.forEach((button) => button.addEventListener("click", () => applySort(button.dataset.listingSort ?? "")));
    // 옆으로 넘기는 정렬 줄에서 고른 단추가 반쯤 가려지지 않게 보이는 곳으로 옮긴다(가려지지 않으면 움직이지 않음)
    sortButtons.forEach((button) => button.addEventListener("focus", () => button.scrollIntoView({ block: "nearest", inline: "nearest" })));
    // 종이 모양 정렬 줄: 양 끝에 가려진 칩이 있는지 표시(가장자리 흐림용). 다 보이면 표시를 떼어 흐림이 없다.
    const sortRow = pager.classList.contains("listing-pager--sheet") ? pager.querySelector<HTMLElement>(".listing-sort") : null;
    if (sortRow) {
      const updateSortEdges = () => {
        const hidden = sortRow.scrollWidth - sortRow.clientWidth;
        sortRow.toggleAttribute("data-more-start", sortRow.scrollLeft > 1);
        sortRow.toggleAttribute("data-more-end", sortRow.scrollLeft < hidden - 1);
      };
      sortRow.addEventListener("scroll", updateSortEdges, { passive: true });
      window.addEventListener("resize", updateSortEdges);
      updateSortEdges();
    }
    previousButton?.addEventListener("click", () => showPage(currentPage - 1, true));
    nextButton?.addEventListener("click", () => showPage(currentPage + 1, true));
    pager.dataset.paginationReady = "true";
    applySort("latest");
  });
</script>
