---
import links from "../data/external-links.json";
---

<div class="content-card-grid">
  {links.map((item) => (
    <a class="content-card" href={item.url} target="_blank" rel="noopener noreferrer">
      <span>{item.type === "blog" ? "NAVER BLOG" : "YOUTUBE"}</span>
      <h3>{item.title}</h3>
      <p>{item.summary}</p>
      <b>원문에서 보기 <span aria-hidden="true">↗</span></b>
    </a>
  ))}
</div>
