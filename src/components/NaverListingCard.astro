---
import {
  getNaverListingAreaValue,
  getNaverListingPriceParts,
  getNaverListingPriceValue,
  naverTradeNames,
  type NaverListing,
} from "../lib/naver-listings";

interface Props {
  listing: NaverListing;
  compact?: boolean;
  rank?: number;
  hidden?: boolean;
  complexSlug?: string;
  selectionControls?: boolean;
}

const { listing, compact = false, rank = 0, hidden = false, complexSlug = "", selectionControls = false } = Astro.props;
const details = [listing.areaLabel, listing.floorLabel, listing.direction].filter(Boolean).join(" · ");
const registeredAtLabel = listing.registeredAt.replaceAll("-", ".");
const price = getNaverListingPriceParts(listing.priceLabel, listing.tradeType);
---

<article
  class:list={["listing-card", "listing-card--naver", compact && "listing-card--compact"]}
  data-naver-listing-card
  data-listing-id={listing.id}
  data-trade={listing.tradeType}
  data-property-type={listing.propertyType}
  data-complex={complexSlug}
  data-listing-title={listing.title}
  data-rank={rank}
  data-price={getNaverListingPriceValue(listing.priceLabel, listing.tradeType) ?? undefined}
  data-deposit={price.deposit ?? undefined}
  data-monthly-rent={price.monthlyRent ?? undefined}
  data-price-label={listing.priceLabel}
  data-area={getNaverListingAreaValue(listing.areaLabel) ?? undefined}
  data-area-label={listing.areaLabel ?? undefined}
  data-floor-label={listing.floorLabel ?? undefined}
  data-direction={listing.direction ?? undefined}
  data-registered-at={listing.registeredAt}
  data-listing-url={listing.url}
  hidden={hidden}
>
  <div class="listing-card__body">
    <p><span>{listing.propertyType}</span><time datetime={listing.registeredAt}>등록 {registeredAtLabel}</time></p>
    {selectionControls && (
      <div class="listing-card__selection" aria-label={`${listing.title} 선택`}>
        <button type="button" aria-pressed="false" data-favorite-button>☆ 관심</button>
        <button type="button" aria-pressed="false" data-compare-button>비교</button>
      </div>
    )}
    <h3><a href={listing.url} target="_blank" rel="noopener noreferrer">{listing.title}</a></h3>
    <p class="listing-card__price">{naverTradeNames[listing.tradeType]} {listing.priceLabel}</p>
    {details && <p class="listing-card__meta">{details}</p>}
    <p class="listing-card__summary">{listing.summary}</p>
    <a class="listing-card__link" href={listing.url} target="_blank" rel="noopener noreferrer">네이버에서 매물 보기 <span aria-hidden="true">↗</span></a>
  </div>
</article>

<style>
  .listing-card__selection {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .listing-card__selection button {
    min-height: 44px;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--navy-950);
    background: var(--white);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 800;
    cursor: pointer;
  }

  .listing-card__selection button[aria-pressed="true"] {
    color: var(--white);
    border-color: var(--rose-dark);
    background: var(--rose-dark);
  }
</style>
