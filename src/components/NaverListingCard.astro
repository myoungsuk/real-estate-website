---
import {
  naverTradeNames,
  type NaverListing,
} from "../lib/naver-listings";

interface Props {
  listing: NaverListing;
  compact?: boolean;
}

const { listing, compact = false } = Astro.props;
const details = [listing.areaLabel, listing.floorLabel, listing.direction].filter(Boolean).join(" · ");
---

<article
  class:list={["listing-card", "listing-card--naver", compact && "listing-card--compact"]}
  data-naver-listing-card
  data-trade={listing.tradeType}
  data-property-type={listing.propertyType}
>
  <a
    class="listing-card__visual listing-card__visual--naver"
    href={listing.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${listing.title} 네이버 매물 보기`}
  >
    <span aria-hidden="true">{listing.title.slice(0, 1)}</span>
    <b>{naverTradeNames[listing.tradeType]}</b>
    <small>네이버 등록 매물</small>
  </a>
  <div class="listing-card__body">
    <p><span>{listing.propertyType}</span><time datetime={listing.confirmedAt}>{listing.confirmedAt} 확인</time></p>
    <h3><a href={listing.url} target="_blank" rel="noopener noreferrer">{listing.title}</a></h3>
    <p class="listing-card__price">{naverTradeNames[listing.tradeType]} {listing.priceLabel}</p>
    {details && <p class="listing-card__meta">{details}</p>}
    <p class="listing-card__summary">{listing.summary}</p>
    <a class="listing-card__link" href={listing.url} target="_blank" rel="noopener noreferrer">네이버에서 매물 보기 <span aria-hidden="true">↗</span></a>
  </div>
</article>
