---
// 관리자 화면용 단순 그림 기호. 이 사무소용으로 새로 그린 선 그림이다(외부 아이콘 세트·다른 서비스 그림을 쓰지 않음).
export type AdminIconName =
  | "home"
  | "fee"
  | "message"
  | "schedule"
  | "dashboard"
  | "tools"
  | "building"
  | "page"
  | "play"
  | "map"
  | "cloud"
  | "history"
  | "help"
  | "search"
  | "check"
  | "clock"
  | "shield"
  | "external"
  | "chevron-left"
  | "chevron-right";

interface Props {
  name: AdminIconName;
  size?: number;
}

const { name, size = 24 } = Astro.props;
---

<svg
  class="admin-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "home" && (
    <>
      <rect x="3.5" y="3.5" width="7" height="7" rx="2" />
      <rect x="13.5" y="3.5" width="7" height="7" rx="2" />
      <rect x="3.5" y="13.5" width="7" height="7" rx="2" />
      <rect x="13.5" y="13.5" width="7" height="7" rx="2" />
    </>
  )}
  {name === "fee" && (
    <>
      <rect x="5" y="2.75" width="14" height="18.5" rx="3" />
      <rect x="8" y="6" width="8" height="3.5" rx="1" />
      <path d="M8.5 13h.01M12 13h.01M15.5 13h.01M8.5 16.5h.01M12 16.5h.01M15.5 16.5h.01" stroke-width="2.6" />
    </>
  )}
  {name === "message" && (
    <>
      <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 3.5V16h0A2.5 2.5 0 0 1 4 13.5Z" />
      <path d="M8 8.5h8M8 11.5h5" />
    </>
  )}
  {name === "schedule" && (
    <>
      <rect x="3.5" y="5" width="17" height="15.5" rx="3" />
      <path d="M3.5 9.5h17M8 3v4M16 3v4" />
      <path d="M8 13.5h3M8 16.5h6" />
    </>
  )}
  {name === "dashboard" && (
    <>
      <path d="M4 11.5 12 4.5l8 7" />
      <path d="M6.5 10v9.5h11V10" />
      <path d="M10 19.5v-5h4v5" />
    </>
  )}
  {name === "tools" && (
    <>
      <rect x="3.5" y="7.5" width="17" height="12" rx="2.5" />
      <path d="M9 7.5V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1.5" />
      <path d="M3.5 12.5h17" />
    </>
  )}
  {name === "building" && (
    <>
      <path d="M5 20.5V5.5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v15" />
      <path d="M15 9.5h2.5a2 2 0 0 1 2 2v9" />
      <path d="M3.5 20.5h17" />
      <path d="M8.5 7.5h3M8.5 11h3M8.5 14.5h3" />
    </>
  )}
  {name === "page" && (
    <>
      <rect x="3.5" y="4.5" width="17" height="15" rx="2.5" />
      <path d="M3.5 9h17" />
      <path d="M7.5 13h5M7.5 16h8" />
    </>
  )}
  {name === "play" && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="3.5" />
      <path d="m10.5 9.5 4 2.5-4 2.5Z" />
    </>
  )}
  {name === "map" && (
    <>
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" />
      <circle cx="12" cy="10" r="2.5" />
    </>
  )}
  {name === "cloud" && (
    <>
      <path d="M7 18.5a4.5 4.5 0 0 1-.6-8.96A6 6 0 0 1 18 9.5a4 4 0 0 1-.5 9H7Z" />
      <path d="M12 15.5v-5M9.75 12.5 12 10.25l2.25 2.25" />
    </>
  )}
  {name === "history" && (
    <>
      <path d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3" />
      <path d="M4 4.5V8h3.5" />
      <path d="M12 8v4.5l3 1.5" />
    </>
  )}
  {name === "search" && (
    <>
      <circle cx="11" cy="11" r="6" />
      <path d="m20 20-4.35-4.35" />
    </>
  )}
  {name === "check" && (
    <>
      <rect x="4" y="4" width="16" height="16" rx="4" />
      <path d="m8.5 12.25 2.5 2.5 4.5-5" />
    </>
  )}
  {name === "clock" && (
    <>
      <circle cx="12" cy="12" r="8" />
      <path d="M12 8v4.25l2.75 1.75" />
    </>
  )}
  {name === "shield" && (
    <>
      <path d="M12 3.5 5 6.5v5c0 4.5 3 7.7 7 9 4-1.3 7-4.5 7-9v-5Z" />
      <path d="m9 12 2 2 4-4" />
    </>
  )}
  {name === "external" && (
    <>
      <path d="M14 4.5h5.5V10" />
      <path d="M19.5 4.5 11 13" />
      <path d="M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4" />
    </>
  )}
  {name === "help" && (
    <>
      <circle cx="12" cy="12" r="8.75" />
      <path d="M9.6 9.6a2.5 2.5 0 0 1 4.85.85c0 1.65-2.45 2.05-2.45 3.8" />
      <path d="M12 17.25h.01" stroke-width="2.6" />
    </>
  )}
  {name === "chevron-left" && <path d="m14.5 6-6 6 6 6" />}
  {name === "chevron-right" && <path d="m9.5 6 6 6-6 6" />}
</svg>
