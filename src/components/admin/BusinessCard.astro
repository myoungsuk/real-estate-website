---
// 명함 A안 흰 종이(보드 45번 C, 운영자 결정 2026-11-20 18:09 "A 흰 종이"). 재단 크기 90×50mm, 안전 여백 4mm 안에 글을 둔다.
// 크기는 모두 --mm(화면 미리 보기는 칸 폭에 맞춘 px, 인쇄는 1mm)의 배수라 화면과 인쇄가 같은 배치다. 가장 작은 글자는 2.54mm(약 7.2pt).
// 글은 src/lib/work/promo-paper.mjs businessCardView()(사무소 확정 공개 정보)만 쓴다. 직함은 넣지 않는다.
interface Props {
  side: "front" | "back";
  view: ReturnType<typeof import("../../lib/work/promo-paper.mjs").businessCardView>;
}

const { side, view } = Astro.props;
const LOGO = "/images/brand/leaders-city-happy-logo.webp";
---

{side === "front" ? (
  <div class="bc bc--front">
    <img class="bc__logo" src={LOGO} alt="리더스시티 행복한부동산" data-card-logo />
    <p class="bc__who"><small>{view.front.role}</small><strong>{view.front.name}</strong></p>
    <p class="bc__tel"><b>{view.front.phone}</b><span>{view.front.email}</span></p>
  </div>
) : (
  <div class="bc bc--back">
    <div>
      <p class="bc__headline">{view.back.headline}</p>
      <p class="bc__areas">{view.back.areas}</p>
    </div>
    <dl class="bc__rows">
      {view.back.rows.map(([label, value]) => (
        <div><dt>{label}</dt><dd>{value}</dd></div>
      ))}
    </dl>
    <p class="bc__legal">{view.back.legal.map((line, index) => (index === 0 ? line : <><br />{line}</>))}</p>
  </div>
)}
