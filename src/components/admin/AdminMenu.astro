---
// 관리자 메뉴 목록. '전체 메뉴' 창(PC·휴대폰 공통)에 쓴다. 메뉴 자료와 지금 화면 판정은 AdminLayout이 넘긴다.
import AdminIcon, { type AdminIconName } from "./AdminIcon.astro";

interface MenuSubItem {
  href: string;
  label: string;
  current?: "page" | "true";
}

// 아래 단계 묶음. label이 있으면 보이는 제목 + role="group"(aria-labelledby)으로 묶는다.
interface MenuSubGroup {
  label?: string;
  items: MenuSubItem[];
}

interface MenuItem {
  href: string;
  label: string;
  icon: AdminIconName;
  current?: "page" | "true";
  sub?: MenuSubGroup[];
}

interface MenuGroup {
  label: string;
  items: MenuItem[];
}

interface Props {
  label: string;
  // 묶음 제목 id 앞머리. 위 알약 줄의 묶음 제목 id(admin-subtabs-group-*)와 겹치지 않게 받는다.
  idPrefix: string;
  groups: MenuGroup[];
}

const { label, idPrefix, groups } = Astro.props;
---

<nav class="admin-menu" aria-label={label}>
  {groups.map((group) => (
    <div class="admin-menu__group">
      <p class="admin-menu__label">{group.label}</p>
      <ul>
        {group.items.map((item) => (
          <li>
            <a class="admin-menu__item" href={item.href} aria-current={item.current}>
              <span class="admin-menu__icon"><AdminIcon name={item.icon} size={20} /></span>
              <span>{item.label}</span>
            </a>
            {item.sub && (
              <ul class="admin-menu__sub">
                {item.sub.map((group, index) => group.label ? (
                  <li class="admin-menu__subgroup">
                    <p class="admin-menu__subhead" id={`${idPrefix}-sub-${index}`}>{group.label}</p>
                    <ul role="group" aria-labelledby={`${idPrefix}-sub-${index}`}>
                      {group.items.map((sub) => (
                        <li>
                          <a class="admin-menu__subitem" href={sub.href} aria-current={sub.current}>{sub.label}</a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ) : group.items.map((sub) => (
                  <li>
                    <a class="admin-menu__subitem" href={sub.href} aria-current={sub.current}>{sub.label}</a>
                  </li>
                )))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </div>
  ))}
  <p class="admin-menu__future">FAQ·후기 <span>준비 중</span></p>
</nav>
