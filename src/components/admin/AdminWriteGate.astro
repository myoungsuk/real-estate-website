<p class="admin-inline-notice" data-admin-write-gate>
  <span aria-hidden="true">i</span>
  <span data-admin-write-message>GitHub 저장 연결 상태를 확인하고 있습니다.</span>
</p>

<script>
  import { getAdminSession } from "../../lib/admin-content-client";

  const gates = document.querySelectorAll<HTMLElement>("[data-admin-write-gate]");
  void getAdminSession().then((session) => {
    document.querySelectorAll<HTMLButtonElement | HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("[data-write-control]")
      .forEach((control) => { control.disabled = !session.writeEnabled; });
    gates.forEach((gate) => {
      const message = gate.querySelector<HTMLElement>("[data-admin-write-message]");
      if (message) message.textContent = session.writeEnabled
        ? "저장 연결이 활성화되었습니다. 저장하면 GitHub 커밋을 생성합니다. Cloudflare 자동 배포는 Git 연결 후 동작합니다."
        : "화면과 입력 폼은 준비되었습니다. 실제 저장은 Cloudflare에 GitHub 쓰기 Secret을 연결한 뒤 활성화됩니다.";
      gate.classList.toggle("admin-inline-notice--ready", session.writeEnabled);
    });
    window.dispatchEvent(new CustomEvent("admin-write-ready", { detail: session }));
  }).catch(() => {
    gates.forEach((gate) => {
      const message = gate.querySelector<HTMLElement>("[data-admin-write-message]");
      if (message) message.textContent = "로컬 화면에서는 입력 구성을 확인할 수 있습니다. 실제 저장 상태는 배포된 관리자 주소에서 확인해 주세요.";
    });
  });
</script>
