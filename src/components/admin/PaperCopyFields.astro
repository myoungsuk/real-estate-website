---
// 종이 만들기 '문구 고치기' 칸(보드 20번 2판, 2026-11-24 사용자 답 "문구도 수정할 수 있게 하면 안되나?").
// 모양마다 칸 묶음(data-copy-set)을 미리 그려 두고, 고른 모양의 묶음만 보인다. 처음 값은 지금 문구(value)이고 '처음 문구로'는 보이는 묶음만 처음 값으로 되돌린다.
// 모양을 바꿔도 다른 모양에서 고친 글은 그 묶음 칸에 남는다(화면 메모리). 저장·서버 전송·URL·브라우저 저장소에 넣지 않는다.
// 칸 목록·글자 수 한도는 src/lib/work/paper-copy.mjs paperCopyFields(), 묶기는 src/lib/work-paper-copy.ts.
interface Props {
  tool: string;
  fields: Record<string, readonly { key: string; label: string; max: number; value: string; optional: boolean }[]>;
  shape: string;
  note: string;
}

const { tool, fields, shape, note } = Astro.props;
---

<details class="bl-fold paper-copy" data-copy-tool={tool}>
  <summary>문구 고치기</summary>
  <p class="work-help">{note}</p>
  {Object.entries(fields).map(([value, list]) => (
    <div class="paper-copy__set" data-copy-set={value} hidden={value !== shape}>
      {list.length === 0 ? (
        <p class="work-help">이 모양에는 고칠 문구가 없습니다. 제목과 확인 줄은 매물 자료로 만듭니다.</p>
      ) : list.map((item) => (
        <div class="work-row">
          <label class="work-row__label" for={`${tool}-copy-${value}-${item.key}`}>{item.label}</label>
          <div class="work-row__control">
            <input id={`${tool}-copy-${value}-${item.key}`} type="text" maxlength={item.max} value={item.value} autocomplete="off" data-copy-key={item.key} />
            <small>{item.max}자까지{item.optional ? " · 비우면 그 줄을 뺍니다" : ""}</small>
          </div>
        </div>
      ))}
    </div>
  ))}
  <div class="work-receipt__actions">
    <button class="work-secondary-button" type="button" data-copy-reset>처음 문구로</button>
  </div>
</details>
