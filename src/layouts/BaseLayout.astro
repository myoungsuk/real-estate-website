---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MobileContactBar from "../components/MobileContactBar.astro";
import { serializeJsonLd } from "../lib/json-ld.mjs";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  shareImage?: string;
  shareImageAlt?: string;
  shareImageWidth?: number;
  shareImageHeight?: number;
  noindex?: boolean;
}

const {
  title,
  description,
  structuredData,
  shareImage: shareImagePath = "/images/brand/leaders-city-happy-logo.png",
  shareImageAlt = "리더스시티 행복한부동산 공인중개사사무소 로고",
  shareImageWidth = 1402,
  shareImageHeight = 1122,
  noindex = false,
} = Astro.props;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
const shareImage = Astro.site ? new URL(shareImagePath, Astro.site) : undefined;
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === "true";
const serializedStructuredData = structuredData ? serializeJsonLd(structuredData) : null;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#17344f" />
    <meta name="description" content={description} />
    <meta name="robots" content={allowIndexing && !noindex ? "index,follow" : "noindex,nofollow"} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical.toString()} />}
    {shareImage && <meta property="og:image" content={shareImage.toString()} />}
    {shareImage && <meta property="og:image:width" content={String(shareImageWidth)} />}
    {shareImage && <meta property="og:image:height" content={String(shareImageHeight)} />}
    {shareImage && <meta property="og:image:alt" content={shareImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    {shareImage && <meta name="twitter:image" content={shareImage.toString()} />}
    {shareImage && <meta name="twitter:image:alt" content={shareImageAlt} />}
    {canonical && <link rel="canonical" href={canonical.toString()} />}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
    <title>{title}</title>
    {serializedStructuredData && (
      <script is:inline type="application/ld+json" set:html={serializedStructuredData} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 바로가기</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <MobileContactBar />
  </body>
</html>
