---
import "../styles/global.css";
import "../styles/admin.css";
import AdminIcon, { type AdminIconName } from "../components/admin/AdminIcon.astro";
import AdminMenu from "../components/admin/AdminMenu.astro";
import { office } from "../lib/site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pathname = Astro.url.pathname;

const navigation = [
  { href: "/admin/", label: "대시보드", shortLabel: "홈" },
  { href: "/admin/work/", label: "업무 도구", shortLabel: "업무" },
  { href: "/admin/listings/", label: "네이버 매물", shortLabel: "매물" },
  { href: "/admin/content/", label: "첫 화면·사무소", shortLabel: "홈글" },
  { href: "/admin/external-links/", label: "블로그·유튜브·인스타그램", shortLabel: "링크" },
  { href: "/admin/complexes/", label: "지역·단지 설명", shortLabel: "지역" },
  { href: "/admin/deployment/", label: "배포 상태", shortLabel: "배포" },
  { href: "/admin/history/", label: "변경 이력·복원", shortLabel: "이력" },
  { href: "/admin/help/", label: "사용 안내", shortLabel: "안내" },
];

// 메뉴 그림 기호. 그림은 이 사무소용으로 새로 그린 선 그림이다.
const navigationIcons: Record<string, AdminIconName> = {
  "/admin/": "dashboard",
  "/admin/work/": "tools",
  "/admin/listings/": "building",
  "/admin/content/": "page",
  "/admin/external-links/": "play",
  "/admin/complexes/": "map",
  "/admin/deployment/": "cloud",
  "/admin/history/": "history",
  "/admin/help/": "help",
};

// 관리자 공용 틀(사용자 선택 2026-11-18 C+D 17:24:07·CD1 17:55:44): 맨 위 메뉴 줄과 화면별 왼쪽 목록을 하나로 합쳤다.
// PC(980px 이상)는 왼쪽 고정 목록 하나, 휴대폰은 위 제목 줄(고정하지 않음) + 업무 도구·네이버 매물 작은 탭 + 아래 탭 4개 + 전체 메뉴 창.
// 메뉴 묶음(PC 왼쪽 목록·휴대폰 전체 메뉴 창). navigation의 모든 메뉴가 한 묶음에 한 번씩 들어간다.
const navigationGroups = [
  { label: "업무", hrefs: ["/admin/", "/admin/work/", "/admin/listings/"] },
  { label: "홈페이지 글", hrefs: ["/admin/content/", "/admin/external-links/", "/admin/complexes/"] },
  { label: "확인", hrefs: ["/admin/deployment/", "/admin/history/", "/admin/help/"] },
];

// 아래 단계가 있는 구역. 지금 구역이면 PC 왼쪽 목록에서 펼치고, 휴대폰은 위 제목 줄 아래 작은 탭으로 보여 준다.
const navigationSubItems: Record<string, { href: string; label: string }[]> = {
  "/admin/work/": [
    { href: "/admin/work/", label: "업무 도구 처음" },
    { href: "/admin/work/fee/", label: "중개보수 계산" },
    { href: "/admin/work/messages/", label: "안내 문자" },
    { href: "/admin/work/schedule/", label: "계약 일정" },
    { href: "/admin/work/realprice/", label: "실거래가" },
    { href: "/admin/work/blog/", label: "글 초안" },
  ],
  "/admin/listings/": [
    { href: "/admin/listings/", label: "매물 현황" },
    { href: "/admin/listings/editor/", label: "매물 등록·동기화" },
  ],
};

// 휴대폰 아래 탭(자주 쓰는 3개, 네 번째는 전체 메뉴 단추).
const tabItems = [
  { href: "/admin/", label: "홈" },
  { href: "/admin/work/", label: "업무 도구" },
  { href: "/admin/listings/", label: "매물" },
];

const currentPath = pathname.endsWith("/") ? pathname : `${pathname}/`;
const isCurrentPath = (href: string) =>
  href === "/admin/" ? currentPath === href : currentPath.startsWith(href);
// 지금 화면이면 "page", 지금 화면이 그 아래 단계면 "true"(지금 구역)로 알린다. 화면 표시도 이 값으로 나눈다.
const currentState = (href: string): "page" | "true" | undefined => (currentPath === href ? "page" : isCurrentPath(href) ? "true" : undefined);
const currentSection = navigation.find((item) => isCurrentPath(item.href));
const currentSubItems = currentSection ? navigationSubItems[currentSection.href] : undefined;
// 아래 단계: 지금 화면이면 "page", 지금 화면이 그 아래 단계의 더 아래 화면이면 "true"(예: 실거래가 설정 → 실거래가). 구역 첫 주소(업무 도구 처음 등)는 앞부분이 늘 같으므로 "true"로 보지 않는다.
const subCurrentState = (sectionHref: string, href: string): "page" | "true" | undefined =>
  currentPath === href ? "page" : href !== sectionHref && currentPath.startsWith(href) ? "true" : undefined;

const menuGroups = navigationGroups.map((group) => ({
  label: group.label,
  items: group.hrefs.map((href) => {
    const item = navigation.find((entry) => entry.href === href);
    const subItems = navigationSubItems[href];
    return {
      href,
      label: item?.label ?? href,
      icon: navigationIcons[href],
      // 아래 단계가 있는 메뉴는 아래 단계 쪽에 "page"를 두고, 위 메뉴는 지금 구역("true")만 알린다.
      current: subItems ? (isCurrentPath(href) ? ("true" as const) : undefined) : currentState(href),
      sub: subItems && isCurrentPath(href)
        ? subItems.map((sub) => ({ ...sub, current: subCurrentState(href, sub.href) }))
        : undefined,
    };
  }),
}));

// 관리자 탭 미리 그리기(Speculation Rules). 메뉴에 0.2초 머물면(휴대폰은 화면에 보이는 링크 기준) 브라우저가 다음 화면을 미리 준비한다.
// 서버 요청이 없는 단계 0 업무 도구 4화면만 이름으로 적어 화면 전체를 미리 그리고(prerender), 나머지 관리자 화면은 HTML만 미리 받는다(prefetch, 스크립트 실행 없음).
// 서버를 부르거나 기록을 남기는 화면은 prerender 목록에 넣지 않는다. 넣어야 하면 document.prerendering을 확인하고 화면이 실제로 보일 때(prerenderingchange 뒤) 요청한다.
// 서버 API·Access 인증 경로·매물 편집(저장 화면)·내려받기·nofollow·data-no-speculate 링크는 두 규칙 모두에서 뺀다.
// 이 규칙을 모르는 브라우저는 무시한다. 공개 화면(BaseLayout)에는 넣지 않는다.
const prerenderPages = ["/admin/work/", "/admin/work/fee/", "/admin/work/messages/", "/admin/work/schedule/"];
const speculationExclusions = [
  { not: { href_matches: "/api/*" } },
  { not: { href_matches: "/cdn-cgi/*" } },
  { not: { href_matches: "/admin/listings/editor*" } },
  { not: { selector_matches: "[data-no-speculate], [download], [rel~=nofollow]" } },
];
const speculationRules = {
  prerender: [{ where: { and: [{ or: prerenderPages.map((page) => ({ href_matches: page })) }, ...speculationExclusions] }, eagerness: "moderate" }],
  prefetch: [{ where: { and: [{ href_matches: "/admin/*" }, ...speculationExclusions] }, eagerness: "moderate" }],
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>{title}</title>
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)}></script>
  </head>
  <body class="admin-body">
    <a class="skip-link" href="#admin-main">관리자 본문으로 바로가기</a>

    <div class="admin-shell" data-admin-app>
      <header class="admin-side">
        <a class="admin-side__brand" href="/admin/" aria-label="리더스시티행복한공인중개사사무소 관리자 홈">
          <span class="admin-brand__mark" aria-hidden="true">
            <img src="/images/brand/leaders-city-happy-logo.webp" alt="" width="1000" height="800" />
          </span>
          <span class="admin-side__brand-text">
            <strong>{office.brandName}</strong>
            <small>공인중개사사무소 · 관리자 시스템</small>
          </span>
        </a>

        <AdminMenu label="관리자 메뉴" groups={menuGroups} />

        <div class="admin-side__foot">
          <p>Access 보호 영역입니다. 저장은 별도 GitHub 연결이 필요합니다.</p>
          <a class="admin-public-link" href="/">
            공개 홈페이지
            <AdminIcon name="external" size={15} />
          </a>
        </div>
      </header>

      <div class="admin-shell__body">
        <header class="admin-top">
          <a class="admin-top__home" href="/admin/" aria-label="리더스시티행복한공인중개사사무소 관리자 홈">
            <span class="admin-brand__mark" aria-hidden="true">
              <img src="/images/brand/leaders-city-happy-logo.webp" alt="" width="1000" height="800" />
            </span>
          </a>
          <p class="admin-top__title">{currentSection?.label ?? "관리자"}</p>
          <a class="admin-top__public" href="/">
            <AdminIcon name="external" size={18} />
            <span class="sr-only">공개 홈페이지</span>
          </a>
        </header>

        {currentSection && currentSubItems && (
          <nav class="admin-subtabs" aria-label={`${currentSection.label} 메뉴`}>
            <ul>
              {currentSubItems.map((item) => (
                <li>
                  <a href={item.href} aria-current={subCurrentState(currentSection.href, item.href)}>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <main class="admin-main" id="admin-main" tabindex="-1">
          <slot />
        </main>
      </div>
    </div>

    <nav class="admin-tabbar" aria-label="자주 쓰는 메뉴">
      <ul>
        {tabItems.map((item) => (
          <li>
            <a href={item.href} aria-current={currentState(item.href)}>
              <span class="admin-tabbar__icon" aria-hidden="true"><AdminIcon name={navigationIcons[item.href]} size={20} /></span>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
        <li>
          <button type="button" aria-haspopup="dialog" data-admin-menu-open>
            <span class="admin-tabbar__icon admin-tabbar__icon--menu" aria-hidden="true"></span>
            <span>전체 메뉴</span>
          </button>
        </li>
      </ul>
    </nav>

    <dialog class="admin-sheet" aria-labelledby="admin-sheet-title" data-admin-menu-sheet>
      <div class="admin-sheet__head">
        <strong id="admin-sheet-title">전체 메뉴</strong>
        <button type="button" data-admin-menu-close>닫기</button>
      </div>
      <AdminMenu label="전체 메뉴" groups={menuGroups} />
      <a class="admin-public-link" href="/">
        공개 홈페이지
        <AdminIcon name="external" size={15} />
      </a>
    </dialog>

    <script>
      // 휴대폰 전체 메뉴 창. 열기·닫기만 맡는다(Esc로도 닫힘). 메뉴 링크로 다른 화면에 갔다가 뒤로 가기로 돌아왔을 때 창이 열린 채 남지 않게 떠날 때 닫는다.
      const sheet = document.querySelector<HTMLDialogElement>("[data-admin-menu-sheet]");
      const openButton = document.querySelector<HTMLButtonElement>("[data-admin-menu-open]");
      if (sheet && openButton) {
        openButton.addEventListener("click", () => sheet.showModal());
        sheet.querySelector<HTMLButtonElement>("[data-admin-menu-close]")?.addEventListener("click", () => sheet.close());
        window.addEventListener("pagehide", () => sheet.close());
        // 창 바깥 어두운 바탕을 누르면 닫는다. 창 안 여백을 누른 것(같은 dialog가 대상)은 창 상자 안이므로 닫지 않는다.
        sheet.addEventListener("click", (event) => {
          if (event.target !== sheet) return;
          const box = sheet.getBoundingClientRect();
          if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) sheet.close();
        });
      }

      // 휴대폰 폭의 가로로 미는 줄(업무 도구·네이버 매물 작은 탭)에서 키보드로 간 링크가 줄 옆으로 잘리면, 그 줄만 가로로 민다(보드 34번).
      // Chromium은 링크가 조금이라도 보이면 줄을 밀지 않는다. scrollIntoView는 문서까지 세로로 움직일 수 있어 줄의 가로 위치만 바꾼다.
      // 마우스·손가락으로 누를 때는 밀지 않는다. 누르는 사이 줄이 움직이면 손을 뗀 자리가 다른 링크가 되어 엉뚱한 화면으로 갈 수 있기 때문이다.
      {
        const strips = ".admin-subtabs";
        const stripMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        let stripPointerAt = -Infinity;
        document.addEventListener("pointerdown", () => {
          stripPointerAt = performance.now();
        }, { capture: true, passive: true });
        document.addEventListener("focusin", (event) => {
          const target = event.target as HTMLElement | null;
          const strip = target?.closest<HTMLElement>(strips);
          if (!target || !strip || !target.matches(":focus-visible") || performance.now() - stripPointerAt < 600) return;
          if (strip.scrollWidth <= strip.clientWidth) return;
          const gap = 16;
          const bounds = strip.getBoundingClientRect();
          const box = target.getBoundingClientRect();
          let delta = 0;
          if (box.left < bounds.left + gap) delta = box.left - bounds.left - gap;
          else if (box.right > bounds.right - gap) delta = Math.min(box.right - bounds.right + gap, box.left - bounds.left - gap);
          if (delta !== 0) strip.scrollBy({ left: delta, behavior: stripMotion.matches ? "auto" : "smooth" });
        });
        // 처음 열 때 지금 화면의 작은 탭이 줄 오른쪽 밖으로 잘리면 그 줄만 가로로 옮겨 둔다(업무 도구 다섯째 탭 '실거래가'는 360px에서 잘림, TK-37).
        for (const strip of document.querySelectorAll<HTMLElement>(strips)) {
          const current = strip.querySelector<HTMLElement>("[aria-current]");
          if (!current || strip.scrollWidth <= strip.clientWidth) continue;
          const gap = 16;
          const bounds = strip.getBoundingClientRect();
          const box = current.getBoundingClientRect();
          if (box.right > bounds.right - gap) strip.scrollLeft += Math.min(box.right - bounds.right + gap, box.left - bounds.left - gap);
        }
      }
    </script>
  </body>
</html>
