---
import "../styles/global.css";
import "../styles/admin.css";
import AdminIcon, { type AdminIconName } from "../components/admin/AdminIcon.astro";
import { office } from "../lib/site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pathname = Astro.url.pathname;
const hasAside = Astro.slots.has("aside");

const navigation = [
  { href: "/admin/", label: "대시보드", shortLabel: "홈" },
  { href: "/admin/work/", label: "업무 도구", shortLabel: "업무" },
  { href: "/admin/listings/", label: "네이버 매물", shortLabel: "매물" },
  { href: "/admin/content/", label: "첫 화면·사무소", shortLabel: "홈글" },
  { href: "/admin/external-links/", label: "블로그·유튜브", shortLabel: "링크" },
  { href: "/admin/complexes/", label: "지역·단지 설명", shortLabel: "지역" },
  { href: "/admin/deployment/", label: "배포 상태", shortLabel: "배포" },
  { href: "/admin/history/", label: "변경 이력·복원", shortLabel: "이력" },
];

// 맨 위 메뉴 줄의 원형 그림 기호와 바탕색. 그림은 이 사무소용으로 새로 그린 선 그림이다.
const navigationIcons: Record<string, { icon: AdminIconName; tone: string }> = {
  "/admin/": { icon: "dashboard", tone: "navy" },
  "/admin/work/": { icon: "tools", tone: "rose" },
  "/admin/listings/": { icon: "building", tone: "teal" },
  "/admin/content/": { icon: "page", tone: "gold" },
  "/admin/external-links/": { icon: "play", tone: "rose" },
  "/admin/complexes/": { icon: "map", tone: "teal" },
  "/admin/deployment/": { icon: "cloud", tone: "navy" },
  "/admin/history/": { icon: "history", tone: "gold" },
};

const isCurrentPath = (href: string) =>
  href === "/admin/" ? pathname === href : pathname.startsWith(href);

// 관리자 탭 미리 그리기(Speculation Rules). 메뉴에 0.2초 머물면(휴대폰은 화면에 보이는 링크 기준) 브라우저가 다음 화면을 미리 준비한다.
// 서버 요청이 없는 단계 0 업무 도구 4화면만 이름으로 적어 화면 전체를 미리 그리고(prerender), 나머지 관리자 화면은 HTML만 미리 받는다(prefetch, 스크립트 실행 없음).
// 서버를 부르거나 기록을 남기는 화면은 prerender 목록에 넣지 않는다. 넣어야 하면 document.prerendering을 확인하고 화면이 실제로 보일 때(prerenderingchange 뒤) 요청한다.
// 서버 API·Access 인증 경로·매물 편집(저장 화면)·내려받기·nofollow·data-no-speculate 링크는 두 규칙 모두에서 뺀다.
// 이 규칙을 모르는 브라우저는 무시한다. 공개 화면(BaseLayout)에는 넣지 않는다.
const prerenderPages = ["/admin/work/", "/admin/work/fee/", "/admin/work/messages/", "/admin/work/schedule/"];
const speculationExclusions = [
  { not: { href_matches: "/api/*" } },
  { not: { href_matches: "/cdn-cgi/*" } },
  { not: { href_matches: "/admin/listings/editor*" } },
  { not: { selector_matches: "[data-no-speculate], [download], [rel~=nofollow]" } },
];
const speculationRules = {
  prerender: [{ where: { and: [{ or: prerenderPages.map((page) => ({ href_matches: page })) }, ...speculationExclusions] }, eagerness: "moderate" }],
  prefetch: [{ where: { and: [{ href_matches: "/admin/*" }, ...speculationExclusions] }, eagerness: "moderate" }],
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>{title}</title>
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)}></script>
  </head>
  <body class="admin-body">
    <a class="skip-link" href="#admin-main">관리자 본문으로 바로가기</a>

    <div class="admin-shell" data-admin-app>
      <header class="admin-topnav">
        <a class="admin-topnav__brand" href="/admin/" aria-label="리더스시티행복한공인중개사사무소 관리자 홈">
          <span class="admin-brand__mark" aria-hidden="true">
            <img src="/images/brand/leaders-city-happy-logo.webp" alt="" width="1000" height="800" />
          </span>
          <span class="admin-topnav__brand-text">
            <strong>{office.brandName}</strong>
            <small>공인중개사사무소 · 관리자 시스템</small>
          </span>
        </a>

        <nav class="admin-topnav__nav" aria-label="관리자 메뉴">
          <button class="admin-topnav__scroll admin-topnav__scroll--prev" type="button" data-admin-nav-scroll="-1" hidden>
            <AdminIcon name="chevron-left" size={18} />
            <span class="sr-only">메뉴 앞쪽 보기</span>
          </button>
          <ul class="admin-topnav__list" data-admin-nav-list>
            {navigation.map((item) => {
              const visual = navigationIcons[item.href];
              return (
                <li>
                  <a class="admin-topnav__item" href={item.href} aria-current={isCurrentPath(item.href) ? "page" : undefined}>
                    <span class="admin-topnav__icon" data-tone={visual.tone}>
                      <AdminIcon name={visual.icon} size={15} />
                    </span>
                    <span>{item.label}</span>
                  </a>
                </li>
              );
            })}
            <li>
              <span class="admin-topnav__item admin-topnav__item--future">
                FAQ·후기 <small>준비 중</small>
              </span>
            </li>
          </ul>
          <button class="admin-topnav__scroll admin-topnav__scroll--next" type="button" data-admin-nav-scroll="1" hidden>
            <AdminIcon name="chevron-right" size={18} />
            <span class="sr-only">메뉴 뒤쪽 보기</span>
          </button>
        </nav>

        <div class="admin-topnav__tools">
          <span class="admin-topnav__badge">
            <AdminIcon name="shield" size={15} />
            Access 보호
          </span>
          <a class="admin-topnav__public" href="/">
            공개 홈페이지
            <AdminIcon name="external" size={15} />
          </a>
        </div>
      </header>

      <div class:list={["admin-shell__body", { "admin-shell__body--split": hasAside }]}>
        {hasAside && (
          <div class="admin-shell__aside">
            <slot name="aside" />
          </div>
        )}
        <main class="admin-main" id="admin-main" tabindex="-1">
          <slot />
        </main>
      </div>
    </div>

    <script>
      // 맨 위 메뉴 줄이 화면보다 길면 앞뒤 넘기기 단추를 보여 주고, 지금 화면 메뉴가 보이도록 줄을 옮긴다.
      const list = document.querySelector<HTMLElement>("[data-admin-nav-list]");
      const scrollButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-admin-nav-scroll]")];

      if (list && scrollButtons.length === 2) {
        const [prevButton, nextButton] = scrollButtons;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

        const updateButtons = () => {
          const maxScroll = list.scrollWidth - list.clientWidth;
          const state = new Map([
            [prevButton, list.scrollLeft <= 4],
            [nextButton, list.scrollLeft >= maxScroll - 4],
          ]);
          // 보여야 할 단추를 먼저 보이게 한 뒤, 포커스를 가진 단추가 숨겨지면 반대쪽 단추(없으면 첫 메뉴)로 포커스를 옮긴다.
          state.forEach((hide, button) => {
            if (!hide) button.hidden = false;
          });
          state.forEach((hide, button) => {
            if (!hide || button.hidden) return;
            if (document.activeElement === button) {
              const other = button === prevButton ? nextButton : prevButton;
              const fallback = other.hidden ? list.querySelector<HTMLElement>("a") : other;
              fallback?.focus({ preventScroll: true });
            }
            button.hidden = true;
          });
        };

        const current = list.querySelector<HTMLElement>('[aria-current="page"]');
        if (current) {
          const offset = current.offsetLeft - (list.clientWidth - current.offsetWidth) / 2;
          list.scrollLeft = Math.max(0, offset);
        }

        // Tab으로 간 메뉴가 줄 끝·넘기기 단추·오른쪽 흐림에 가리지 않게, 단추 폭만큼 여유를 두고 줄을 바로 옮긴다.
        list.addEventListener("focusin", (event) => {
          const item = (event.target as HTMLElement | null)?.closest<HTMLElement>(".admin-topnav__item");
          if (!item) return;
          const gap = window.matchMedia("(min-width: 768px)").matches ? 56 : 32;
          const left = item.offsetLeft - gap;
          const right = item.offsetLeft + item.offsetWidth + gap;
          if (left < list.scrollLeft) list.scrollLeft = Math.max(0, left);
          else if (right > list.scrollLeft + list.clientWidth) list.scrollLeft = right - list.clientWidth;
        });

        scrollButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const direction = Number(button.dataset.adminNavScroll);
            list.scrollBy({ left: direction * list.clientWidth * 0.7, behavior: reduceMotion.matches ? "auto" : "smooth" });
          });
        });
        list.addEventListener("scroll", updateButtons, { passive: true });
        window.addEventListener("resize", updateButtons);
        updateButtons();
      }

      // 휴대폰 폭의 가로로 미는 줄(왼쪽 목록이 위로 온 줄, 업무 도구 밑줄 탭)에서 키보드로 간 링크가 줄 옆으로 잘리면, 그 줄만 가로로 민다(보드 34번).
      // Chromium은 링크가 조금이라도 보이면 줄을 밀지 않는다. scrollIntoView는 문서까지 세로로 움직일 수 있어 줄의 가로 위치만 바꾼다.
      // 마우스·손가락으로 누를 때는 밀지 않는다. 누르는 사이 줄이 움직이면 손을 뗀 자리가 다른 링크가 되어 엉뚱한 화면으로 갈 수 있기 때문이다.
      {
        const strips = ".admin-subnav__nav, .work-tool-nav";
        const stripMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        let stripPointerAt = -Infinity;
        document.addEventListener("pointerdown", () => {
          stripPointerAt = performance.now();
        }, { capture: true, passive: true });
        document.addEventListener("focusin", (event) => {
          const target = event.target as HTMLElement | null;
          const strip = target?.closest<HTMLElement>(strips);
          if (!target || !strip || !target.matches(":focus-visible") || performance.now() - stripPointerAt < 600) return;
          if (strip.scrollWidth <= strip.clientWidth) return;
          const gap = 16;
          const bounds = strip.getBoundingClientRect();
          const box = target.getBoundingClientRect();
          let delta = 0;
          if (box.left < bounds.left + gap) delta = box.left - bounds.left - gap;
          else if (box.right > bounds.right - gap) delta = Math.min(box.right - bounds.right + gap, box.left - bounds.left - gap);
          if (delta !== 0) strip.scrollBy({ left: delta, behavior: stripMotion.matches ? "auto" : "smooth" });
        });
      }

      // 위 메뉴 줄은 모든 폭에서 화면 위에 고정된다(사용자 선택 2026-11-16 16:59:58, 좁은 화면은 브랜드 줄이 올라가고 메뉴 줄만 남음).
      // 문서 전체 scroll-padding-top은 쓰지 않으므로(머리글 안 Tab 때 문서가 튀는 문제), 앞으로 Tab·Shift+Tab·처음으로 돌아오기
      // 모두 이 스크립트가 맡는다. 키보드 포커스(:focus-visible 또는 글 입력류)가 머리글에 가리면, 스크롤이 멈춘 뒤 머리글 아래 8px까지 바로 내린다.
      // Chromium의 날짜 칸(input[type=date])은 키보드로 들어가도 :focus-visible이 아니므로 글 입력류는 따로 본다(회귀 2회차 S4).
      // 건너뛰기 링크 대상(#admin-main)은 CSS scroll-margin-top으로 머리글 아래에 온다.
      // 마우스 클릭(포커스 표시 없음)·머리글 안·건너뛰기 링크·열린 확인 창 안은 건드리지 않는다.
      const header = document.querySelector<HTMLElement>(".admin-topnav");
      if (header) {
        // 글 입력 칸은 마우스로 눌러도 :focus-visible이 되고 글 입력류는 따로 보정하므로, 방금 누른 뒤의 포커스는 따로 거른다.
        let pointerAt = -Infinity;
        const textEntry =
          "textarea, select, input:not([type=button]):not([type=submit]):not([type=reset]):not([type=checkbox]):not([type=radio]):not([type=range]):not([type=color]):not([type=file]):not([type=image]):not([type=hidden])";
        document.addEventListener("pointerdown", () => {
          pointerAt = performance.now();
        }, { capture: true, passive: true });
        document.addEventListener("focusin", (event) => {
          const target = event.target as HTMLElement | null;
          if (!target || target === document.body || !(target.matches(":focus-visible") || target.matches(textEntry))) return;
          if (performance.now() - pointerAt < 600) return;
          if (header.contains(target) || target.classList.contains("skip-link") || target.closest("dialog[open]")) return;
          // 안쪽 스크롤 목록의 항목처럼 화면을 내려도 제자리일 수 있는 경우를 위해 세 번까지만 고친다(끝없이 스크롤하지 않게).
          let attempts = 0;
          let settleTimer = 0;
          const correct = () => {
            if (document.activeElement !== target || attempts >= 3) return;
            // 화면에서 숨긴 라디오·체크 상자는 감싼 라벨을 기준으로 잰다.
            const box = (target.closest("label") ?? target).getBoundingClientRect();
            if (box.width === 0 && box.height === 0) return;
            const limit = header.getBoundingClientRect().bottom + 8;
            // 남은 화면보다 큰 칸(긴 글 상자)은 브라우저가 맞춘 커서 위치를 그대로 둔다.
            if (box.height > window.innerHeight - limit - 8) return;
            if (box.top >= limit) return;
            attempts += 1;
            window.scrollBy({ top: box.top - limit, behavior: "instant" });
          };
          // 부드러운 스크롤 중간 위치로 재지 않게, 마지막 스크롤 뒤 0.1초가 지나면 확인한다(스크롤이 없으면 0.1초 뒤 한 번).
          const settle = () => {
            window.clearTimeout(settleTimer);
            settleTimer = window.setTimeout(correct, 100);
          };
          const stop = () => {
            window.removeEventListener("scroll", settle);
            window.removeEventListener("wheel", userMoved);
            window.removeEventListener("touchmove", userMoved);
          };
          // 사람이 휠·손가락으로 움직이면 남은 확인도 지우고 바로 멈춘다.
          const userMoved = () => {
            window.clearTimeout(settleTimer);
            stop();
          };
          window.addEventListener("scroll", settle, { passive: true });
          window.addEventListener("wheel", userMoved, { passive: true });
          window.addEventListener("touchmove", userMoved, { passive: true });
          settle();
          window.setTimeout(stop, 1000);
        });
      }
    </script>
  </body>
</html>
