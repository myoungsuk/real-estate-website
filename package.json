{
  "name": "leaders-city-happy-realty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "validate:content": "node scripts/validate-content.mjs",
    "check": "astro check && npm run validate:content",
    "build": "npm run check && npm run build:site",
    "build:site": "astro build && node scripts/deployment-marker.mjs write",
    "assert:production-build": "node scripts/assert-production-build.mjs",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "sync:bank": "node scripts/sync-bank-listings.mjs",
    "sync:bank:dry-run": "node scripts/sync-bank-listings.mjs --dry-run",
    "sync:external": "node scripts/sync-external-content.mjs",
    "sync:external:dry-run": "node scripts/sync-external-content.mjs --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.8",
    "jose": "6.2.10"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "fast-xml-parser": "^5.11.0",
    "fast-xml-validator": "^1.4.2",
    "sharp": "^0.35.4",
    "typescript": "6.0.3",
    "wrangler": "4.126.0"
  }
}
