{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leaders-city-happy-realty",
  "compatibility_date": "2026-08-24",
  "main": "./worker/index.mjs",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "leaderscityhappy.com",
      "custom_domain": true
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "d1_databases": [
    {
      "binding": "WORK_DB",
      "database_name": "leaderscity-work",
      "database_id": "30bedf32-4a65-46cc-a56d-af38cf30b6e2",
      "migrations_dir": "migrations/work"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WORK_FILES",
      "bucket_name": "leaderscity-work-files"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/admin",
      "/api/admin/*",
      "/api/calendar/*"
    ],
    "not_found_handling": "404-page"
  },
  // 단계 P 실거래가 받기(10분마다 1개월 1종류). 켜기 값 Secret WORK_REALPRICE_ENABLED가 없으면 D1·외부 요청 없이 끝난다.
  // 단계 4 AI 작업 보조 조회(1분마다 열린 작업의 결과 받기). 켜기 값 Secret WORK_AI_ENABLED가 없으면 D1·외부 요청 없이 끝난다.
  "triggers": {
    "crons": ["*/10 * * * *", "* * * * *"]
  }
}
